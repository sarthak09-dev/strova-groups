# Security & Caching headers for Cloudflare Pages
# Applied across all static routes

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 0
  # Note: 'unsafe-inline' for script-src is strictly limited to Astro's client scripts and component listeners.
  # Note: 'unsafe-inline' for style-src allows Astro's scoped component styles and dynamic CSS custom properties.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://api.web3forms.com https://formspree.io; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com https://formspree.io;

# Scoped headers for authenticated client portal routes
/portal/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 0
  Cache-Control: private, no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://challenges.cloudflare.com; frame-src https://checkout.razorpay.com https://api.razorpay.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self';

# Long-term immutable caching for Vite hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Caching for public images and vector assets
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.png
  Cache-Control: public, max-age=86400

/favicon-96x96.png
  Cache-Control: public, max-age=86400

/favicon-48x48.png
  Cache-Control: public, max-age=86400

/favicon-192x192.png
  Cache-Control: public, max-age=86400

/favicon-512x512.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

# Versioned brand icons can be cached long-term without keeping old search icons alive
/favicon-strova-96.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-strova-192.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-strova-512.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-strova.svg
  Cache-Control: public, max-age=31536000, immutable

/favicon-strova.ico
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon-strova.png
  Cache-Control: public, max-age=31536000, immutable
