---
/*
 * Base layout — wraps every page.
 * Loads fonts, global CSS, Header, Footer, skip link, and analytics.
 * Supports bilingual rendering for English ('en') and Hindi ('hi').
 */
import '@fontsource-variable/newsreader';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import type { Locale } from '../data/i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  bodyClass?: string;
  lang?: Locale;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  jsonLd,
  noindex,
  bodyClass = '',
  lang = 'en',
} = Astro.props;

const sameAsProfiles = [
  import.meta.env.PUBLIC_LINKEDIN_URL,
  import.meta.env.PUBLIC_GITHUB_URL,
  import.meta.env.PUBLIC_INSTAGRAM_URL,
  import.meta.env.PUBLIC_YOUTUBE_URL,
  import.meta.env.PUBLIC_GOOGLE_BUSINESS_URL,
  import.meta.env.PUBLIC_CLUTCH_URL,
].filter((url): url is string => typeof url === 'string' && url.trim().length > 0);

/* Organization JSON-LD — present on every page */
const orgJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Strova Group',
  legalName: 'Strova Group',
  url: 'https://strovagroups.in',
  logo: 'https://strovagroups.in/images/logo.svg',
  email: 'info@strovagroups.in',
  telephone: '+919288077802',
  description: lang === 'hi'
    ? 'व्यवसाय के लिए आधुनिक सॉफ़्टवेयर, वेब प्लेटफ़ॉर्म और डिजिटल विकास। स्ट्रोवा ग्रुप बबिता कुमारी का एकल स्वामित्व प्रतिष्ठान है।'
    : 'Technology, commerce, and digital growth for growing businesses. Strova Group is a proprietorship of Babita Kumari.',
  founder: {
    '@type': 'Person',
    name: 'Sarthak Shresht',
    jobTitle: lang === 'hi' ? 'संस्थापक (Founder)' : 'Founder',
  },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Udyam Registration Number',
    value: 'UDYAM-JH-20-0147452',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+919288077802',
    contactType: 'customer service',
    areaServed: 'IN',
    availableLanguage: ['en', 'hi'],
  },
  ...(sameAsProfiles.length > 0 ? { sameAs: sameAsProfiles } : {}),
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Strova Group',
  url: 'https://strovagroups.in',
  inLanguage: ['en', 'hi'],
};

/* Merge page-specific JSON-LD with global ones */
const allJsonLd = [
  orgJsonLd,
  websiteJsonLd,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Purge any legacy theme storage keys to ensure permanent light theme
      try {
        localStorage.removeItem('strova-theme');
        sessionStorage.removeItem('strova-theme');
      } catch (e) {}
      document.documentElement.removeAttribute('data-theme');
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={allJsonLd}
      noindex={noindex}
      lang={lang}
    />
  </head>
  <body class={bodyClass}>
    <!-- Top Fluid Scroll Progress Indicator -->
    <div id="scroll-progress-bar" class="scroll-progress-bar" aria-hidden="true"></div>

    <a href="#main-content" class="skip-link">
      {lang === 'hi' ? 'मुख्य सामग्री पर जाएं' : 'Skip to main content'}
    </a>
    <Header lang={lang} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Calm Sticky Mobile Quote Action Bar -->
    <div class="mobile-quote-bar" aria-label={lang === 'hi' ? 'मोबाइल कोटेशन अनुरोध' : 'Mobile quote request'}>
      <div class="mobile-quote-bar__inner">
        <span class="mobile-quote-bar__text">
          {lang === 'hi' ? 'प्रोजेक्ट की योजना बना रहे हैं?' : 'Planning a project?'}
        </span>
        <a
          href={lang === 'hi' ? '/hi/contact/' : '/contact/'}
          class="btn btn--primary btn--sm"
          data-track="quote_click"
        >
          {lang === 'hi' ? 'कोटेशन प्राप्त करें' : 'Request a quote'}
        </a>
      </div>
    </div>

    <!-- Global Client Interactions -->
    <script src="../scripts/globalInteractions.ts"></script>
    <script src="../scripts/analytics.ts"></script>
  </body>
</html>
