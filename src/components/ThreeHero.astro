---
/**
 * ThreeHero.astro
 *
 * Cinematic Modern 3D Hero & Scroll-Driven Transformation Experience
 * Inspired by luxury dark digital design:
 * - Central Abstract Digital Sculpture (Transmissive Amethyst/Obsidian Crystal + Singularity)
 * - Gyroscopic Liquid Mirror Chrome & Polished Titanium Orbital Chronometer Rings
 * - Micro-Particle Stardust Field with purple and diamond highlights
 * - Studio-Grade Lighting Rig with procedural PMREM Environment Reflections
 * - Smooth Damped Mouse Parallax Tracking (Lerp)
 * - Scroll-Driven Kinetic Transformation (Rotation, Scaling & Ethereal Bloom)
 * - Performance Guardrails: DPR capped at 2, IntersectionObserver offscreen pause
 * - Accessible SVG fallback for prefers-reduced-motion & non-WebGL environments
 */
---

<div class="three-hero" id="three-hero-container" aria-hidden="true">
  <!-- Atmospheric studio ambient backglow -->
  <div class="three-hero__glow" aria-hidden="true"></div>

  <!-- Accessible Fallback SVG -->
  <img
    id="three-hero-fallback"
    class="three-hero__fallback"
    src="/images/hero-fallback.svg"
    alt="Strova Group cinematic 3D digital sculpture visual"
    width="640"
    height="640"
    loading="eager"
    decoding="async"
  />

  <!-- Three.js Canvas: initially hidden until WebGL first frame renders -->
  <canvas id="three-hero-canvas" class="three-hero__canvas" style="display: none;"></canvas>
</div>

<style>
  .three-hero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .three-hero__glow {
    position: absolute;
    width: 140%;
    height: 140%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 62% 48%,
      rgba(168, 85, 247, 0.16) 0%,
      rgba(147, 51, 234, 0.08) 30%,
      rgba(88, 28, 135, 0.02) 55%,
      transparent 75%
    );
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
    transform: translateZ(0);
    transition: opacity 0.6s ease;
  }

  .three-hero__fallback {
    position: relative;
    width: min(85vw, 560px);
    height: min(85vw, 560px);
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.6));
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s ease;
    z-index: 1;
    margin-left: auto;
    margin-right: 4%;
  }

  @media (max-width: 59.99rem) {
    .three-hero__fallback {
      margin-inline: auto;
      width: min(90vw, 420px);
      height: min(90vw, 420px);
      margin-top: 10%;
    }
  }

  .three-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    outline: none;
    pointer-events: none;
    z-index: 2;
  }

  .three-hero.loaded .three-hero__fallback {
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  .three-hero.loaded .three-hero__canvas {
    display: block !important;
    animation: heroCanvasReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes heroCanvasReveal {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>

<script>
  function hasWebGLSupport(): boolean {
    try {
      const canvas = document.createElement('canvas');
      return Boolean(
        window.WebGLRenderingContext &&
        (canvas.getContext('webgl2') || canvas.getContext('webgl') || canvas.getContext('experimental-webgl'))
      );
    } catch {
      return false;
    }
  }

  function initThreeHero() {
    const container = document.getElementById('three-hero-container');
    const canvas = document.getElementById('three-hero-canvas') as HTMLCanvasElement | null;
    const fallback = document.getElementById('three-hero-fallback');

    if (!container || !canvas || !fallback) return;

    // Respect reduced-motion preferences
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Check for WebGL capability
    if (!hasWebGLSupport()) return;

    const loadEngine = async () => {
      try {
        const THREE = await import('three');

        let isRunning = false;
        let animationFrameId: number | null = null;

        // Scene setup
        const scene = new THREE.Scene();

        // Safe dimension resolution
        let containerWidth = container.clientWidth || window.innerWidth;
        let containerHeight = container.clientHeight || window.innerHeight;
        let aspect = containerWidth / containerHeight;
        let isMobile = window.innerWidth < 960;

        // Camera setup
        const camera = new THREE.PerspectiveCamera(38, aspect, 0.1, 100);
        const baseCamZ = isMobile ? 10.8 : 8.2;
        const baseCamX = isMobile ? 0 : 0.35;
        const baseCamY = isMobile ? 0.35 : 0;
        camera.position.set(baseCamX, baseCamY, baseCamZ);

        // Renderer with High Dynamic Range ACES Filmic tone mapping
        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: 'high-performance',
        });
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.35;
        renderer.outputColorSpace = THREE.SRGBColorSpace;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        renderer.setPixelRatio(dpr);
        renderer.setSize(containerWidth, containerHeight);

        // Procedural Studio Equirectangular Environment Map (Cinematic Dark)
        const envCanvas = document.createElement('canvas');
        envCanvas.width = 512;
        envCanvas.height = 256;
        const envCtx = envCanvas.getContext('2d');
        if (envCtx) {
          const bgGrad = envCtx.createLinearGradient(0, 0, 0, 256);
          bgGrad.addColorStop(0, '#030308');
          bgGrad.addColorStop(0.5, '#070610');
          bgGrad.addColorStop(1, '#020205');
          envCtx.fillStyle = bgGrad;
          envCtx.fillRect(0, 0, 512, 256);

          // Top ceiling softbox
          const topLight = envCtx.createLinearGradient(0, 0, 0, 70);
          topLight.addColorStop(0, 'rgba(255, 255, 255, 0.85)');
          topLight.addColorStop(1, 'rgba(255, 255, 255, 0)');
          envCtx.fillStyle = topLight;
          envCtx.fillRect(100, 0, 312, 70);

          // Purple left rim softbox
          const purpleGlow = envCtx.createRadialGradient(90, 130, 10, 90, 130, 110);
          purpleGlow.addColorStop(0, 'rgba(168, 85, 247, 0.95)');
          purpleGlow.addColorStop(0.5, 'rgba(147, 51, 234, 0.4)');
          purpleGlow.addColorStop(1, 'rgba(0, 0, 0, 0)');
          envCtx.fillStyle = purpleGlow;
          envCtx.fillRect(0, 30, 200, 200);

          // Deep violet right rim softbox
          const violetGlow = envCtx.createRadialGradient(420, 130, 10, 420, 130, 120);
          violetGlow.addColorStop(0, 'rgba(192, 132, 252, 0.95)');
          violetGlow.addColorStop(0.5, 'rgba(126, 34, 206, 0.4)');
          violetGlow.addColorStop(1, 'rgba(0, 0, 0, 0)');
          envCtx.fillStyle = violetGlow;
          envCtx.fillRect(310, 25, 202, 210);

          // Specular spot key
          const keySpot = envCtx.createRadialGradient(256, 75, 2, 256, 75, 45);
          keySpot.addColorStop(0, 'rgba(255, 255, 255, 1)');
          keySpot.addColorStop(1, 'rgba(255, 255, 255, 0)');
          envCtx.fillStyle = keySpot;
          envCtx.fillRect(205, 30, 102, 90);

          const envTexture = new THREE.CanvasTexture(envCanvas);
          envTexture.mapping = THREE.EquirectangularReflectionMapping;

          const pmremGenerator = new THREE.PMREMGenerator(renderer);
          pmremGenerator.compileEquirectangularShader();
          scene.environment = pmremGenerator.fromEquirectangular(envTexture).texture;
          pmremGenerator.dispose();
          envTexture.dispose();
        }

        // Multi-Point Studio Lighting Rig
        const keyLight = new THREE.DirectionalLight(0xffffff, 3.6);
        keyLight.position.set(5.0, 7.0, 5.0);
        scene.add(keyLight);

        const purpleRim = new THREE.PointLight(0xa855f7, 6.2, 38);
        purpleRim.position.set(-6.0, -3.0, 3.5);
        scene.add(purpleRim);

        const violetBack = new THREE.PointLight(0x7e22ce, 6.0, 38);
        violetBack.position.set(4.0, -5.0, -5.0);
        scene.add(violetBack);

        const specularSpot = new THREE.PointLight(0xffffff, 3.2, 25);
        specularSpot.position.set(1.5, 4.5, 4.0);
        scene.add(specularSpot);

        const ambientLight = new THREE.AmbientLight(0x0a0a14, 1.2);
        scene.add(ambientLight);

        // Root Sculpture Group
        const rootGroup = new THREE.Group();
        const baseRootX = isMobile ? 0 : 1.30;
        const baseRootY = isMobile ? 1.35 : 0.10;
        rootGroup.position.set(baseRootX, baseRootY, 0);
        scene.add(rootGroup);

        // -------------------------------------------------------------
        // 1. Central Faceted Optical Amethyst & Obsidian Crystal Core
        // -------------------------------------------------------------
        const coreGroup = new THREE.Group();
        rootGroup.add(coreGroup);

        // Inner radiant singularity (emissive pulsing diamond)
        const singularityGeo = new THREE.OctahedronGeometry(0.46, 2);
        const singularityMat = new THREE.MeshStandardMaterial({
          color: 0xa855f7,
          emissive: 0xc084fc,
          emissiveIntensity: 2.8,
          roughness: 0.05,
          metalness: 0.95,
        });
        const singularityMesh = new THREE.Mesh(singularityGeo, singularityMat);
        singularityMesh.renderOrder = 1;
        coreGroup.add(singularityMesh);

        // Optical crystal outer shell (MeshPhysicalMaterial with transmission)
        const crystalGeo = new THREE.IcosahedronGeometry(1.20, 0);
        const crystalMat = new THREE.MeshPhysicalMaterial({
          color: 0x0e0a1a,
          emissive: 0x1a0b2e,
          roughness: 0.04,
          metalness: 0.08,
          transmission: 0.90,
          thickness: 2.2,
          ior: 1.58,
          attenuationColor: new THREE.Color(0xa855f7),
          attenuationDistance: 1.0,
          clearcoat: 1.0,
          clearcoatRoughness: 0.02,
          iridescence: 0.88,
          iridescenceIOR: 1.48,
          flatShading: true,
          transparent: true,
        });
        const crystalMesh = new THREE.Mesh(crystalGeo, crystalMat);
        crystalMesh.renderOrder = 2;
        coreGroup.add(crystalMesh);

        // Micro-offset wireframe overlay for mathematical precision aesthetic
        const facetWireMat = new THREE.MeshBasicMaterial({
          color: 0xd8b4fe,
          wireframe: true,
          transparent: true,
          opacity: 0.32,
        });
        const facetWire = new THREE.Mesh(crystalGeo, facetWireMat);
        facetWire.scale.setScalar(1.003);
        facetWire.renderOrder = 3;
        coreGroup.add(facetWire);

        // -------------------------------------------------------------
        // 2. Gyroscopic Chronometer Bands & Liquid Chrome Orbit Rings
        // -------------------------------------------------------------
        // Inner Gimbal Ring (Polished Liquid Mirror Chrome)
        const innerGimbalGroup = new THREE.Group();
        rootGroup.add(innerGimbalGroup);

        const innerRingGeo = new THREE.TorusGeometry(1.68, 0.038, 32, 140);
        const innerRingMat = new THREE.MeshPhysicalMaterial({
          color: 0xffffff,
          metalness: 0.98,
          roughness: 0.04,
          clearcoat: 1.0,
          clearcoatRoughness: 0.02,
          reflectivity: 1.0,
        });
        const innerRingMesh = new THREE.Mesh(innerRingGeo, innerRingMat);
        innerGimbalGroup.add(innerRingMesh);

        // Middle Chronometer Ring (Dark Brushed Titanium & Satellite Nodes)
        const middleGimbalGroup = new THREE.Group();
        rootGroup.add(middleGimbalGroup);

        const middleRingGeo = new THREE.TorusGeometry(2.20, 0.050, 32, 140);
        const middleRingMat = new THREE.MeshPhysicalMaterial({
          color: 0x1b1828,
          metalness: 0.94,
          roughness: 0.16,
          clearcoat: 0.88,
          clearcoatRoughness: 0.05,
          iridescence: 0.52,
        });
        const middleRingMesh = new THREE.Mesh(middleRingGeo, middleRingMat);
        middleGimbalGroup.add(middleRingMesh);

        // 3 Orbiting Satellites on Middle Ring (Purple Luminous Spheres)
        const satelliteGeo = new THREE.SphereGeometry(0.086, 24, 24);
        const satelliteMat = new THREE.MeshPhysicalMaterial({
          color: 0xa855f7,
          emissive: 0x7e22ce,
          emissiveIntensity: 1.2,
          metalness: 0.96,
          roughness: 0.06,
          clearcoat: 1.0,
        });

        for (let i = 0; i < 3; i++) {
          const angle = (i * 2 * Math.PI) / 3;
          const sat = new THREE.Mesh(satelliteGeo, satelliteMat);
          sat.position.set(Math.cos(angle) * 2.20, Math.sin(angle) * 2.20, 0);
          middleGimbalGroup.add(sat);
        }

        // Outer Kinetic Ring (Electric Violet Alloy)
        const outerGimbalGroup = new THREE.Group();
        rootGroup.add(outerGimbalGroup);

        const outerRingGeo = new THREE.TorusGeometry(2.74, 0.040, 32, 140);
        const outerRingMat = new THREE.MeshPhysicalMaterial({
          color: 0x9333ea,
          metalness: 0.96,
          roughness: 0.09,
          clearcoat: 1.0,
          clearcoatRoughness: 0.04,
          iridescence: 0.65,
        });
        const outerRingMesh = new THREE.Mesh(outerRingGeo, outerRingMat);
        outerGimbalGroup.add(outerRingMesh);

        // Fine Horizon Orbit Halo (Luminous Ethereal Ring)
        const haloGeo = new THREE.TorusGeometry(3.06, 0.014, 16, 140);
        const haloMat = new THREE.MeshPhysicalMaterial({
          color: 0xc084fc,
          emissive: 0xa855f7,
          emissiveIntensity: 1.4,
          roughness: 0.10,
        });
        const haloMesh = new THREE.Mesh(haloGeo, haloMat);
        rootGroup.add(haloMesh);

        // -------------------------------------------------------------
        // 3. Stardust Micro-Particle Field
        // -------------------------------------------------------------
        const particleCount = 380;
        const particlePositions = new Float32Array(particleCount * 3);
        const particleScales = new Float32Array(particleCount);

        for (let i = 0; i < particleCount; i++) {
          const i3 = i * 3;
          const u = Math.random();
          const v = Math.random();
          const theta = u * 2.0 * Math.PI;
          const phi = Math.acos(2.0 * v - 1.0);
          const r = Math.cbrt(Math.random()) * 4.6 + 1.2;

          particlePositions[i3] = r * Math.sin(phi) * Math.cos(theta);
          particlePositions[i3 + 1] = r * Math.sin(phi) * Math.sin(theta);
          particlePositions[i3 + 2] = r * Math.cos(phi);
          particleScales[i] = Math.random() * 0.7 + 0.3;
        }

        const particleGeo = new THREE.BufferGeometry();
        particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        particleGeo.setAttribute('scale', new THREE.BufferAttribute(particleScales, 1));

        // Soft Circular Stardust Particle Texture
        const partCanvas = document.createElement('canvas');
        partCanvas.width = 64;
        partCanvas.height = 64;
        const partCtx = partCanvas.getContext('2d');
        if (partCtx) {
          const grad = partCtx.createRadialGradient(32, 32, 0, 32, 32, 32);
          grad.addColorStop(0, 'rgba(255, 255, 255, 1)');
          grad.addColorStop(0.3, 'rgba(192, 132, 252, 0.85)');
          grad.addColorStop(0.7, 'rgba(168, 85, 247, 0.3)');
          grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
          partCtx.fillStyle = grad;
          partCtx.fillRect(0, 0, 64, 64);
        }
        const particleTexture = new THREE.CanvasTexture(partCanvas);

        const particleMat = new THREE.PointsMaterial({
          size: 0.12,
          map: particleTexture,
          transparent: true,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
          color: 0xe9d5ff,
        });

        const particleSystem = new THREE.Points(particleGeo, particleMat);
        rootGroup.add(particleSystem);

        // -------------------------------------------------------------
        // 4. Interaction Tracking & Choreographed Scroll Engine
        // -------------------------------------------------------------
        let targetX = 0;
        let targetY = 0;
        let currentX = 0;
        let currentY = 0;

        const onPointerMove = (e: MouseEvent) => {
          const normX = (e.clientX / window.innerWidth - 0.5) * 2;
          const normY = (e.clientY / window.innerHeight - 0.5) * 2;
          targetX = Math.max(-1, Math.min(1, normX));
          targetY = Math.max(-1, Math.min(1, normY));
        };
        window.addEventListener('pointermove', onPointerMove, { passive: true });

        // Scroll progress calculation
        let targetScrollProgress = 0;
        let currentScrollProgress = 0;

        const onScroll = () => {
          const heroEl = document.querySelector('.hero') as HTMLElement | null;
          const heroHeight = heroEl ? heroEl.offsetHeight : window.innerHeight;
          const progress = Math.min(1.5, Math.max(0, window.scrollY / heroHeight));
          targetScrollProgress = progress;
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // Animation Loop with Scroll-Driven Kinetic Transitions
        const clock = new THREE.Clock();

        const animate = () => {
          if (!isRunning) return;

          const time = clock.getElapsedTime();

          // Smooth lerp mouse parallax & scroll progress
          currentX += (targetX - currentX) * 0.045;
          currentY += (targetY - currentY) * 0.045;
          currentScrollProgress += (targetScrollProgress - currentScrollProgress) * 0.075;

          // Rotations: central crystalline core & orbital rings
          coreGroup.rotation.x += 0.0035;
          coreGroup.rotation.y += 0.0045;

          // Subtle breathing singularity
          const pulse = Math.sin(time * 2.2) * 0.12 + 1.0;
          singularityMesh.scale.setScalar(pulse);

          innerGimbalGroup.rotation.x += 0.0065;
          innerGimbalGroup.rotation.z += 0.0035;

          middleGimbalGroup.rotation.y -= 0.0045;
          middleGimbalGroup.rotation.x += 0.0020;

          outerGimbalGroup.rotation.z += 0.0030;
          outerGimbalGroup.rotation.y -= 0.0025;

          haloMesh.rotation.z -= 0.0018;
          haloMesh.rotation.x += 0.0012;

          particleSystem.rotation.y += 0.0006;
          particleSystem.rotation.z += 0.0004;

          // Harmonic floating levitation
          const levitation = Math.sin(time * 1.3) * 0.08;
          rootGroup.position.y = baseRootY + levitation - currentScrollProgress * 0.45;

          // Mouse parallax tilt & scroll-driven transformation
          rootGroup.rotation.y = currentX * 0.35 + currentScrollProgress * 0.95;
          rootGroup.rotation.x = currentY * 0.25 + currentScrollProgress * 0.28;

          // Dynamic camera movement driven by scroll
          camera.position.z = baseCamZ - currentScrollProgress * 2.2;
          camera.position.x = baseCamX * (1 - currentScrollProgress * 0.7);
          camera.position.y = baseCamY - currentScrollProgress * 0.30;

          // Studio specular highlights follow cursor
          keyLight.position.x = 5.0 + currentX * 2.2;
          purpleRim.position.y = -3.0 + currentY * 2.0;
          specularSpot.position.x = 1.5 - currentX * 1.8;

          renderer.render(scene, camera);
          animationFrameId = requestAnimationFrame(animate);
        };

        // Resize handling
        const onResize = () => {
          containerWidth = container.clientWidth || window.innerWidth;
          containerHeight = container.clientHeight || window.innerHeight;
          isMobile = window.innerWidth < 960;

          aspect = containerWidth / containerHeight;
          camera.aspect = aspect;
          camera.position.z = isMobile ? 10.8 : 8.2;
          camera.position.x = isMobile ? 0 : 0.35;
          camera.position.y = isMobile ? 0.35 : 0;
          camera.updateProjectionMatrix();

          rootGroup.position.x = isMobile ? 0 : 1.30;
          rootGroup.position.y = isMobile ? 1.35 : 0.10;

          renderer.setSize(containerWidth, containerHeight);
        };
        window.addEventListener('resize', onResize, { passive: true });

        // IntersectionObserver for 0% CPU/GPU overhead when offscreen
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (!isRunning) {
                  isRunning = true;
                  clock.start();
                  animate();
                }
              } else {
                isRunning = false;
                if (animationFrameId !== null) {
                  cancelAnimationFrame(animationFrameId);
                  animationFrameId = null;
                }
              }
            });
          },
          { threshold: 0.05 }
        );
        observer.observe(container);

        // Signal first frame rendered & reveal canvas
        container.classList.add('loaded');
      } catch (err) {
        console.warn('Three.js 3D hero gracefully defaulted to accessible fallback:', err);
      }
    };

    // Lazy load after window idle or immediate if DOM already interactive
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => loadEngine(), { timeout: 1500 });
    } else {
      setTimeout(loadEngine, 200);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThreeHero);
  } else {
    initThreeHero();
  }
</script>
