---
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;

let hasJournalArticles = false;
let hasWorkCases = false;

try {
  const journalEntries = await getCollection('journal', ({ data }) => !data.draft);
  hasJournalArticles = journalEntries.length > 0;
} catch {}

try {
  const workEntries = await getCollection('work', ({ data }) => !data.draft);
  hasWorkCases = workEntries.length > 0;
} catch {}

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/technologies/', label: 'Technologies' },
  { href: '/digital/', label: 'Digital' },
  { href: '/commerce/', label: 'Commerce' },
  ...(hasWorkCases ? [{ href: '/case-studies/', label: 'Work' }] : []),
  { href: '/about/', label: 'About' },
  ...(hasJournalArticles ? [{ href: '/journal/', label: 'Journal' }] : []),
  { href: '/contact/', label: 'Contact' },
];

const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
const normalizedCurrent = normalizePath(currentPath);

function isActive(href: string): boolean {
  const normalizedHref = normalizePath(href);
  if (normalizedHref === '/') return normalizedCurrent === '/';
  return normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/');
}
---

<header class="site-header" role="banner">
  <!-- Top Trust & Utility Bar -->
  <div class="header__topbar">
    <div class="container header__topbar-inner">
      <div class="header__topbar-left">
        <span class="topbar-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>India</span>
        </span>
        <span class="topbar-divider" aria-hidden="true">&bull;</span>
        <span class="topbar-item">
          <span>MSME: UDYAM-JH-20-0147452</span>
        </span>
        <span class="topbar-divider" aria-hidden="true">&bull;</span>
        <span class="topbar-item ist-status-badge" aria-label="Operating hours and live status">
          <span class="status-pulse-dot status-open" aria-hidden="true"></span>
          <span class="status-text">10:00 AM – 7:00 PM IST</span>
        </span>
      </div>
      <div class="header__topbar-right">
        <a href="mailto:info@strovagroups.in" class="topbar-link" aria-label="Official email info@strovagroups.in">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>info@strovagroups.in</span>
        </a>
        <span class="topbar-divider" aria-hidden="true">&bull;</span>
        <a href="tel:+919288077802" class="topbar-link" aria-label="Direct phone +91 92880 77802">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>+91 92880 77802</span>
        </a>
      </div>
    </div>
  </div>

  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Strova Group — Home">
      <svg width="32" height="32" viewBox="0 0 36 36" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect width="36" height="36" rx="8" fill="var(--color-ink)"/>
        <path d="M23 12C23 10.3431 21.6569 9 20 9H14C11.7909 9 10 10.7909 10 13C10 15.2091 11.7909 17 14 17H22C24.2091 17 26 18.7909 26 21C26 23.2091 24.2091 25 22 25H16C14.3431 25 13 23.6569 13 22" stroke="#FFFFFF" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="21" cy="21" r="1.75" fill="#3B82F6"/>
      </svg>
      <span class="header__wordmark">Strova Group</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header__nav-desktop" aria-label="Main navigation">
      <ul class="header__links" role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['header__link', { 'header__link--active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Direct Contact, Theme Toggle & CTA) -->
    <div class="header__actions">
      <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp header__wa-btn" aria-label="Chat on WhatsApp">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <a href="/contact/" class="btn btn--primary header__cta-btn">
        <span>Discuss a project</span>
      </a>
    </div>

    <!-- Mobile nav toggle -->
    <button
      class="header__menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      type="button"
    >
      <svg class="header__menu-icon header__menu-icon--open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="header__menu-icon header__menu-icon--close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <nav id="mobile-menu" class="header__nav-mobile" aria-label="Mobile navigation" hidden>
    <ul class="header__mobile-links" role="list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['header__mobile-link', { 'header__link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="header__mobile-footer">
      <div class="header__mobile-status ist-status-badge" aria-label="Indian Standard Time operating status">
        <span class="status-pulse-dot status-open" aria-hidden="true"></span>
        <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
      </div>

      <div class="header__mobile-contact-links">
        <a href="/contact/" class="btn btn--primary w-full">Request a quote</a>
        <a href="tel:+919288077802" class="header__mobile-contact-btn btn btn--outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call: +91 92880 77802</span>
        </a>
        <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="header__mobile-contact-btn btn btn--whatsapp">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <div class="header__mobile-trust-details text-xs text-muted" style="line-height: 1.6; display: flex; flex-direction: column; gap: 4px; margin-top: var(--space-4);">
        <p><strong>MSME Registration:</strong> UDYAM-JH-20-0147452</p>
        <p><strong>Operating Hours:</strong> Mon–Sat, 10:00 AM – 7:00 PM IST</p>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile nav toggling logic
  const siteHeader = document.querySelector('.site-header') as HTMLElement | null;
  const menuBtn = document.querySelector('.header__menu-btn') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.querySelector('.header__menu-icon--open') as HTMLElement | null;
  const closeIcon = document.querySelector('.header__menu-icon--close') as HTMLElement | null;

  if (menuBtn && mobileMenu) {
    const setMenuOpen = (open: boolean) => {
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobileMenu.hidden = !open;
      if (siteHeader) {
        siteHeader.classList.toggle('is-menu-open', open);
      }
      document.body.classList.toggle('mobile-menu-open', open);

      if (openIcon && closeIcon) {
        openIcon.style.display = open ? 'none' : 'block';
        closeIcon.style.display = open ? 'block' : 'none';
      }

      document.body.style.overflow = open ? 'hidden' : '';
    };

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isExpanded);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .site-header.is-menu-open {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    background: var(--bg-page);
  }

  .header__inner {
    position: relative;
    z-index: 1002;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
    gap: var(--space-4);
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .header__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .header__nav-desktop {
    display: none;
  }

  @media (min-width: 64rem) {
    .header__nav-desktop {
      display: block;
    }
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: nowrap;
  }

  .header__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--text-primary);
    background: var(--bg-surface);
  }

  .header__link--active {
    color: var(--accent);
    font-weight: 600;
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  @media (min-width: 50rem) {
    .header__actions {
      display: flex;
    }
  }

  .header__wa-btn {
    display: none;
    padding: 0.4rem 0.8rem;
    font-size: var(--text-xs);
  }

  @media (min-width: 72rem) {
    .header__wa-btn {
      display: inline-flex;
    }
  }

  .header__cta-btn {
    padding: 0.45rem 1rem;
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .header__menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    color: var(--text-primary);
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .header__menu-btn {
      display: none;
    }
  }

  .header__nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100dvh;
    background: var(--bg-page);
    padding: calc(4.25rem + var(--space-4)) var(--gutter) var(--space-6);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    z-index: 1001;
  }

  .header__nav-mobile[hidden] {
    display: none !important;
  }

  @media (min-width: 64rem) {
    .header__nav-mobile {
      display: none !important;
    }
  }

  .header__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .header__mobile-link {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    padding-block: var(--space-2);
    display: block;
    border-bottom: 1px solid var(--border-subtle);
  }

  .header__mobile-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  .header__mobile-contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .w-full {
    width: 100%;
  }
</style>
