        <button type="button" class="btn btn--outline btn--theme-toggle w-full" id="mobile-theme-toggle" aria-label="Toggle color theme" title="Toggle color theme" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.65rem 1rem;">
