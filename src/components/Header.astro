---
/*
 * Header — responsive nav with mobile menu (no JS framework needed).
 * Uses a <details> element for accessible mobile toggle.
 */
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/technologies/', label: 'Technologies' },
  { href: '/digital/', label: 'Digital' },
  { href: '/commerce/', label: 'Commerce' },
  { href: '/about/', label: 'About' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];

const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
const normalizedCurrent = normalizePath(currentPath);

function isActive(href: string): boolean {
  const normalizedHref = normalizePath(href);
  if (normalizedHref === '/') return normalizedCurrent === '/';
  return normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/');
}
---

<header class="site-header" role="banner">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Strova Group — Home">
      <!-- Inline SVG logo mark -->
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <rect width="36" height="36" rx="8" fill="var(--accent)"/>
        <path d="M10 24L18 10L26 24H10Z" fill="var(--color-snow)" opacity="0.9"/>
        <circle cx="18" cy="20" r="3" fill="var(--accent)"/>
      </svg>
      <span class="header__wordmark">Strova</span>
    </a>

    <!-- Desktop nav -->
    <nav class="header__nav-desktop" aria-label="Main navigation">
      <ul class="header__links" role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['header__link', { 'header__link--active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Direct Contact, Live IST Status & CTA) -->
    <div class="header__actions">
      <div class="header__status ist-status-badge" aria-label="Indian Standard Time operating status">
        <span class="status-pulse-dot status-open" aria-hidden="true"></span>
        <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
      </div>

      <a href="tel:+919288077802" class="header__phone-link" aria-label="Call +91 92880 77802">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="header__phone-text">+91 92880 77802</span>
      </a>

      <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp header__wa-btn" aria-label="Chat on WhatsApp">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>WhatsApp</span>
      </a>

      <a href="/contact/" class="btn btn--primary header__cta-btn">
        <span>Inquire</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Mobile nav toggle -->
    <button
      class="header__menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      type="button"
    >
      <svg class="header__menu-icon header__menu-icon--open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="header__menu-icon header__menu-icon--close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"/>
        <line x1="6" y1="18" x2="18" y2="6"/>
      </svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <nav id="mobile-menu" class="header__nav-mobile" aria-label="Mobile navigation" hidden>
    <ul class="header__mobile-links" role="list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['header__mobile-link', { 'header__link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="header__mobile-footer">
      <div class="header__mobile-status ist-status-badge" aria-label="Indian Standard Time operating status">
        <span class="status-pulse-dot status-open" aria-hidden="true"></span>
        <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
      </div>

      <div class="header__mobile-contact-links">
        <a href="tel:+919288077802" class="header__mobile-contact-btn btn btn--outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call: +91 92880 77802</span>
        </a>
        <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="header__mobile-contact-btn btn btn--whatsapp">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <a href="/contact/" class="btn btn--primary header__mobile-cta">
        <span>Inquire for Project</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script>
  function setupHeader() {
    const menuBtn = document.querySelector('.header__menu-btn') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    if (!menuBtn || !mobileMenu) return;

    const openIcon = menuBtn.querySelector('.header__menu-icon--open') as SVGElement | null;
    const closeIcon = menuBtn.querySelector('.header__menu-icon--close') as SVGElement | null;
    const focusableLinks = Array.from(mobileMenu.querySelectorAll('a')) as HTMLAnchorElement[];

    function setMenuState(open: boolean) {
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobileMenu.hidden = !open;
      if (openIcon) openIcon.style.display = open ? 'none' : '';
      if (closeIcon) closeIcon.style.display = open ? '' : 'none';

      if (open) {
        document.body.style.overflow = 'hidden';
        focusableLinks[0]?.focus();
      } else {
        document.body.style.overflow = '';
      }
    }

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      setMenuState(!isExpanded);
    });

    // Close when clicking any nav link
    focusableLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setMenuState(false);
      });
    });

    // Keyboard focus trap & Escape key
    document.addEventListener('keydown', (e) => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      if (!isExpanded) return;

      if (e.key === 'Escape') {
        setMenuState(false);
        menuBtn.focus();
        return;
      }

      if (e.key === 'Tab') {
        const focusableElements = [menuBtn, ...focusableLinks];
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstElement) {
            e.preventDefault();
            lastElement.focus();
          }
        } else {
          if (document.activeElement === lastElement) {
            e.preventDefault();
            firstElement.focus();
          }
        }
      }
    });

    // Reset when resizing past mobile breakpoint (64rem = 1024px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && menuBtn.getAttribute('aria-expanded') === 'true') {
        setMenuState(false);
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg-page) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
  }

  .header__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Desktop nav */
  .header__nav-desktop {
    display: none;
  }

  .header__links {
    display: flex;
    gap: var(--space-1);
  }

  .header__link {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .header__link:hover {
    color: var(--text-primary);
    background: var(--accent-subtle);
  }

  .header__link--active {
    color: var(--accent);
    font-weight: 600;
  }

  /* Mobile menu button */
  .header__menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    border-radius: var(--radius-md);
  }

  /* Mobile nav panel */
  .header__nav-mobile {
    padding: var(--space-4) var(--gutter) var(--space-8);
    background: var(--bg-page);
    border-bottom: 1px solid var(--border-color);
  }

  .header__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .header__mobile-link:hover,
  .header__mobile-link:focus-visible {
    color: var(--text-primary);
    background: var(--accent-subtle);
  }

  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  .header__phone-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__phone-link:hover {
    color: var(--accent);
  }

  .header__phone-text {
    display: none;
  }

  @media (min-width: 80rem) {
    .header__phone-text {
      display: inline;
    }
  }

  .header__wa-btn {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    border-radius: 9999px;
  }

  .header__cta-btn {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    border-radius: 9999px;
  }

  .header__mobile-footer {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .header__mobile-status {
    width: fit-content;
  }

  .header__mobile-contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .header__mobile-contact-btn {
    width: 100%;
    justify-content: center;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
  }

  .header__mobile-cta {
    width: 100%;
    justify-content: center;
    border-radius: 9999px;
    font-size: var(--text-sm);
  }

  /* Desktop breakpoint */
  @media (min-width: 64rem) {
    .header__nav-desktop {
      display: block;
    }
    .header__actions {
      display: flex;
    }
    .header__menu-btn {
      display: none;
    }
    .header__nav-mobile {
      display: none !important;
    }
  }
</style>

