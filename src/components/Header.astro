    <div class="header__mobile-footer">
      <div class="header__mobile-status ist-status-badge" aria-label="Indian Standard Time operating status">
        <span class="status-pulse-dot status-open" aria-hidden="true"></span>
        <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
      </div>

      <div class="header__mobile-contact-links">
        <a href="/contact/" class="btn btn--primary w-full">Request a quote</a>
        <a href="tel:+919288077802" class="header__mobile-contact-btn btn btn--outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Call: +91 92880 77802</span>
        </a>
        <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="header__mobile-contact-btn btn btn--whatsapp">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
