---
import { credentialsConfig } from '../data/credentials';

// Absolute rule: Render ONLY items that have a non-empty, verifiable URL.
const verifiedCredentials = credentialsConfig.filter(
  (item) => item.verifiableUrl && item.verifiableUrl.trim().length > 0
);
---

{verifiedCredentials.length > 0 && (
  <section class="credentials-strip" aria-label="Official Verifications & Registrations">
    <div class="container credentials-strip__inner">
      <span class="credentials-strip__eyebrow">Official Registrations:</span>
      <div class="credentials-strip__items" role="list">
        {verifiedCredentials.map((item) => (
          <div class="credentials-strip__item" role="listitem">
            <span class="credentials-strip__label">{item.label}</span>
            <a
              href={item.verifiableUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="credentials-strip__badge"
              aria-label={`Verify ${item.label} — ${item.badgeText} (opens in new tab)`}
            >
              <span>{item.badgeText}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .credentials-strip {
    background: var(--bg-surface);
    border-block: 1px solid var(--border-color);
    padding-block: var(--space-4);
    font-size: var(--text-xs);
  }

  .credentials-strip__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .credentials-strip__eyebrow {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .credentials-strip__items {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .credentials-strip__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .credentials-strip__label {
    color: var(--text-secondary);
  }

  .credentials-strip__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.2rem 0.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .credentials-strip__badge:hover {
    border-color: var(--accent);
    text-decoration: underline;
  }
</style>
