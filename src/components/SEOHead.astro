---
/*
 * SEO head component — generates <title>, meta, OG, Twitter, JSON-LD,
 * canonical, and bilingual hreflang for every page.
 */
import { getHreflangUrls, type Locale } from '../data/i18n';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  lang?: Locale;
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-default.png',
  ogType = 'website',
  jsonLd,
  noindex = false,
  lang = 'en',
} = Astro.props;

const siteName = 'Strova Group';
const fullTitle = title.includes(siteName) || title.includes('स्ट्रोवा ग्रुप')
  ? title
  : `${title} — ${siteName}`;

const hreflangs = getHreflangUrls(Astro.url.pathname);
const canonicalHref = canonical
  ? (canonical.startsWith('http') ? canonical : new URL(canonical, Astro.site).href)
  : (lang === 'hi' ? hreflangs.hiUrl : hreflangs.enUrl);

const ogImageUrl = new URL(ogImage, Astro.site);
const defaultImageAlt = lang === 'hi'
  ? 'स्ट्रोवा ग्रुप — भारत में उन्नत प्रौद्योगिकी एवं डिजिटल विकास'
  : 'Strova Group — Technology & Digital Services in India';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalHref} />

<!-- Bilingual Hreflang alternates -->
<link rel="alternate" hreflang="en" href={hreflangs.enUrl} />
<link rel="alternate" hreflang="hi" href={hreflangs.hiUrl} />
<link rel="alternate" hreflang="en-IN" href={hreflangs.enUrl} />
<link rel="alternate" hreflang="x-default" href={hreflangs.xDefaultUrl} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Search Engine Verification Slots -->
{import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
  <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
)}
{import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
  <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />
)}

<!-- Theme Color & Color Scheme for Browser Chrome (Permanent Light Theme) -->
<meta name="theme-color" content="#FFFFFF" />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#050507" />

<!-- Icons & PWA Manifest -->
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={defaultImageAlt} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={lang === 'hi' ? 'hi_IN' : 'en_IN'} />
<meta property="og:locale:alternate" content={lang === 'hi' ? 'en_IN' : 'hi_IN'} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={defaultImageAlt} />

<!-- JSON-LD structured data -->
{jsonLd && (
  Array.isArray(jsonLd)
    ? jsonLd.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

