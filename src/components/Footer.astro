---
import { getCollection } from 'astro:content';
import { translations, type Locale } from '../data/i18n';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = translations[lang];

let hasJournalArticles = false;
try {
  const journalEntries = await getCollection('journal', ({ data }) => !data.draft);
  hasJournalArticles = journalEntries.length > 0;
} catch {}

const currentYear = new Date().getFullYear();
const isHi = lang === 'hi';
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand column -->
      <div class="footer__brand">
        <a href={isHi ? '/hi/' : '/'} class="footer__logo" aria-label={isHi ? 'स्ट्रोवा ग्रुप — मुख्य पृष्ठ' : 'Strova Group — Home'}>
          <img
            src="/images/brand/icon-mark.png"
            alt="Strova Group ribbon monogram"
            width="34"
            height="34"
            class="footer__logo-img"
            loading="lazy"
            decoding="async"
          />
          <span class="footer__wordmark">Strova Group</span>
        </a>
        <p class="footer__tagline text-sm text-secondary">
          {t.tagline}
        </p>
        <p class="footer__proprietorship text-xs text-muted">
          {t.footer.proprietorNotice}
        </p>
      </div>

      <!-- Column 1: Divisions -->
      <div class="footer__col">
        <h2 class="footer__heading">{t.footer.divisionsTitle}</h2>
        <ul class="footer__list" role="list">
          <li>
            <a href={isHi ? '/hi/technologies/' : '/technologies/'}>
              {isHi ? 'स्ट्रोवा टेक्नोलॉजीज' : 'Strova Technologies'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/digital/' : '/digital/'}>
              {isHi ? 'स्ट्रोवा डिजिटल' : 'Strova Digital'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/commerce/' : '/commerce/'}>
              {isHi ? 'स्ट्रोवा कॉमर्स' : 'Strova Commerce'}
              <span class="badge-subtle">{isHi ? 'जल्द उपलब्ध' : 'Coming soon'}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Company -->
      <div class="footer__col">
        <h2 class="footer__heading">{t.footer.companyTitle}</h2>
        <ul class="footer__list" role="list">
          <li>
            <a href={isHi ? '/hi/about/' : '/about/'}>
              {isHi ? 'कंपनी परिचय' : 'About & Overview'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/about/#founder' : '/about/#founder'}>
              {isHi ? 'संस्थापक एवं स्वामित्व' : 'Founder & Ownership'}
            </a>
          </li>
          {hasJournalArticles && (
            <li>
              <a href={isHi ? '/hi/journal/' : '/journal/'}>
                {isHi ? 'जर्नल' : 'Journal'}
              </a>
            </li>
          )}
          <li>
            <a href={isHi ? '/hi/contact/' : '/contact/'}>
              {isHi ? 'कोटेशन अनुरोध' : 'Request a Quote'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/faq/' : '/faq/'}>
              {isHi ? 'अक्सर पूछे जाने वाले सवाल' : 'Frequently Asked Questions'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Legal -->
      <div class="footer__col">
        <h2 class="footer__heading">{t.footer.legalTitle}</h2>
        <ul class="footer__list" role="list">
          <li>
            <a href={isHi ? '/hi/privacy/' : '/privacy/'}>
              {isHi ? 'गोपनीयता नीति' : 'Privacy Policy'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/terms/' : '/terms/'}>
              {isHi ? 'सेवा की शर्तें' : 'Terms of Service'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/cookies/' : '/cookies/'}>
              {isHi ? 'कुकी नीति' : 'Cookie Policy'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/accessibility/' : '/accessibility/'}>
              {isHi ? 'डिजिटल अभिगम्यता' : 'Accessibility'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/privacy/#privacy-choices' : '/privacy/#privacy-choices'}>
              {isHi ? 'गोपनीयता विकल्प' : 'Privacy choices'}
            </a>
          </li>
          <li>
            <a href={isHi ? '/hi/privacy/requests/' : '/privacy/requests/'}>
              {isHi ? 'डेटा अधिकार एवं शिकायत' : 'Privacy Rights & Grievance'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Clients & Contact -->
      <div class="footer__col">
        <h2 class="footer__heading">{isHi ? 'क्लाइंट हब' : 'Clients'}</h2>
        <ul class="footer__list" role="list">
          <li>
            <a href="/portal/login/">
              {isHi ? 'क्लाइंट लॉगिन' : 'Client login'} &rarr;
            </a>
          </li>
          <li>
            <a href="/portal/">
              {isHi ? 'ऑर्डर ट्रैकिंग' : 'Track your order'} &rarr;
            </a>
          </li>
        </ul>

        <h2 class="footer__heading" style="margin-top: var(--space-6);">{isHi ? 'सीधा संपर्क' : 'Contact'}</h2>
        <address class="footer__contact">
          <p><a href="mailto:info@strovagroups.in">info@strovagroups.in</a></p>
          <p>
            <a href="tel:+919288077802">+91 92880 77802</a><br/>
            <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">WhatsApp: +91 92880 77802</a>
          </p>
          <p class="text-xs text-muted">
            Mon–Sat, 10:00 AM – 7:00 PM IST
          </p>
        </address>
      </div>
    </div>

    <hr class="footer__divider" />

    <div class="footer__bottom">
      <div class="footer__legal-lines text-xs text-muted">
        <p>&copy; {currentYear} Strova Group. {t.footer.rights}</p>
        <p>Strova Group is a proprietorship of Babita Kumari. Registered MSME Enterprise &bull; Udyam: UDYAM-JH-20-0147452</p>
      </div>
      <div class="footer__status-badge">
        <div class="ist-status-badge" aria-label="Operating status">
          <span class="status-pulse-dot status-open" aria-hidden="true"></span>
          <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding-block: var(--space-16) var(--space-8);
    margin-top: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
  }

  .footer__logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
    border-radius: 6px;
    filter: drop-shadow(0 2px 8px rgba(139, 92, 246, 0.35));
  }

  .footer__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    margin-top: var(--space-3);
    line-height: 1.5;
  }

  .footer__proprietorship {
    margin-top: var(--space-2);
    font-weight: 500;
    line-height: 1.5;
  }

  .footer__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .footer__list li {
    margin-bottom: var(--space-2);
  }

  .footer__list a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .badge-subtle {
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    margin-left: 4px;
    font-weight: normal;
  }

  .footer__contact {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .footer__contact p {
    margin-bottom: var(--space-2);
  }

  .footer__contact a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .footer__contact a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer__divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin-block: var(--space-8);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  @media (min-width: 48rem) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__legal-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
