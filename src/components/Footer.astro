---
import { getCollection } from 'astro:content';

let hasJournalArticles = false;
try {
  const journalEntries = await getCollection('journal', ({ data }) => !data.draft);
  hasJournalArticles = journalEntries.length > 0;
} catch {}

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand column -->
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="Strova Group — Home">
          <svg width="32" height="32" viewBox="0 0 36 36" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <rect width="36" height="36" rx="8" fill="var(--color-ink)"/>
            <path d="M23 12C23 10.3431 21.6569 9 20 9H14C11.7909 9 10 10.7909 10 13C10 15.2091 11.7909 17 14 17H22C24.2091 17 26 18.7909 26 21C26 23.2091 24.2091 25 22 25H16C14.3431 25 13 23.6569 13 22" stroke="#FFFFFF" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="21" cy="21" r="1.75" fill="#3B82F6"/>
          </svg>
          <span class="footer__wordmark">Strova Group</span>
        </a>
        <p class="footer__tagline text-sm text-secondary">
          Technology, commerce, and digital growth for growing businesses.
        </p>
        <p class="footer__proprietorship text-xs text-muted">
          Strova Group is a proprietorship of Babita Kumari.
        </p>
      </div>

      <!-- Column 1: Divisions -->
      <div class="footer__col">
        <h2 class="footer__heading">Divisions</h2>
        <ul class="footer__list" role="list">
          <li><a href="/technologies/">Strova Technologies</a></li>
          <li><a href="/digital/">Strova Digital</a></li>
          <li><a href="/commerce/">Strova Commerce <span class="badge-subtle">Coming soon</span></a></li>
        </ul>
      </div>

      <!-- Column 2: Company -->
      <div class="footer__col">
        <h2 class="footer__heading">Company</h2>
        <ul class="footer__list" role="list">
          <li><a href="/about/">About &amp; Overview</a></li>
          <li><a href="/about/#founder">Founder &amp; Ownership</a></li>
          {hasJournalArticles && <li><a href="/journal/">Journal</a></li>}
          <li><a href="/contact/">Request a Quote</a></li>
          <li><a href="/faq/">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal -->
      <div class="footer__col">
        <h2 class="footer__heading">Legal</h2>
        <ul class="footer__list" role="list">
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
          <li><a href="/cookies/">Cookie Policy</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/privacy/#privacy-choices">Privacy choices</a></li>
        </ul>
      </div>

      <!-- Column 4: Clients & Contact -->
      <div class="footer__col">
        <h2 class="footer__heading">Clients</h2>
        <ul class="footer__list" role="list">
          <li>
            <a href="https://portal.strovagroups.in/login/" target="_blank" rel="noopener noreferrer">
              Client login &rarr;
            </a>
          </li>
          <li>
            <a href="https://portal.strovagroups.in/" target="_blank" rel="noopener noreferrer">
              Track your order &rarr;
            </a>
          </li>
        </ul>

        <h2 class="footer__heading" style="margin-top: var(--space-6);">Contact</h2>
        <address class="footer__contact">
          <p><a href="mailto:info@strovagroups.in">info@strovagroups.in</a></p>
          <p>
            <a href="tel:+919288077802">+91 92880 77802</a><br/>
            <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">WhatsApp: +91 92880 77802</a>
          </p>
          <p class="text-xs text-muted">
            Mon–Sat, 10:00 AM – 7:00 PM IST
          </p>
        </address>
      </div>
    </div>

    <hr class="footer__divider" />

    <div class="footer__bottom">
      <div class="footer__legal-lines text-xs text-muted">
        <p>&copy; {currentYear} Strova Group. All rights reserved.</p>
        <p>Strova Group is a proprietorship of Babita Kumari. Registered MSME Enterprise &bull; Udyam: UDYAM-JH-20-0147452</p>
      </div>
      <div class="footer__status-badge">
        <div class="ist-status-badge" aria-label="Operating status">
          <span class="status-pulse-dot status-open" aria-hidden="true"></span>
          <span class="status-text">IST UTC+5:30 &bull; Office Open</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-color);
    padding-block: var(--space-16) var(--space-8);
    margin-top: auto;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(4, 1fr);
    }
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text-primary);
  }

  .footer__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    margin-top: var(--space-3);
    line-height: 1.5;
  }

  .footer__proprietorship {
    margin-top: var(--space-2);
    font-weight: 500;
  }

  .footer__heading {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .footer__list li {
    margin-bottom: var(--space-2);
  }

  .footer__list a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .badge-subtle {
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    margin-left: 4px;
    font-weight: normal;
  }

  .footer__contact {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .footer__contact p {
    margin-bottom: var(--space-2);
  }

  .footer__contact a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .footer__contact a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .footer__divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin-block: var(--space-8);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  @media (min-width: 48rem) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__legal-lines {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
