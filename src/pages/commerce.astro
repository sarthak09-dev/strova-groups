---
/**
 * E-commerce solutions page within the Digital pillar of Strova Technology.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'E-commerce solutions by Strova Technology',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'E-commerce websites and integrations',
  description:
    'E-commerce websites and integrations planned around a business’s catalog, checkout, and operational requirements.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Commerce',
      item: 'https://strovagroups.in/commerce/',
    },
  ],
};
---

<BaseLayout
  title="E-commerce Solutions — Strova Technology | Strova Group"
  description="Explore e-commerce websites and integrations as part of the Digital pillar within Strova Technology."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <section class="commerce-hero">
    <div class="container text-center">
      <div class="coming-soon-badge">
        <span class="badge-dot"></span>
        <span>Strova Technology &bull; Digital</span>
      </div>
      <h1 class="commerce-title">
        E-commerce shaped around your business
      </h1>
      <p class="commerce-lead">
        Strova Technology can bring storefronts, checkout, catalog management, and relevant business integrations together in a scoped e-commerce project.
      </p>

      <div class="commerce-actions">
        <a href="/contact/?service=commerce" class="btn btn--primary btn--lg">
          Discuss an e-commerce project
        </a>
        <a href="/technologies/" class="btn btn--outline btn--lg">
          Explore Strova Technology
        </a>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview (What it is, Who it is for, Status & Timeline) -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">What It Is</span>
            <p class="overview-item__val">An e-commerce project may include a storefront, checkout, catalog workflows, and integrations selected for the business requirements.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Who It Is For</span>
            <p class="overview-item__val">Businesses that want to sell products online or connect their storefront with existing business systems.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Commercial Status</span>
            <p class="overview-item__val">Features, integrations, and delivery timing are confirmed after requirements review.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Typical Timeline</span>
            <p class="overview-item__val">A written proposal sets the project scope, milestones, and estimated schedule.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural Pillars of Commerce -->
  <section class="section" aria-labelledby="roadmap-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="roadmap-title" class="section-title">Options within the Digital pillar</h2>
        <p class="section-subtitle">
          The right combination depends on your catalog, customers, and existing systems.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card pillar-card">
          <div class="pillar-number">01</div>
          <h3 class="pillar-title">Headless Edge Storefronts</h3>
          <p class="pillar-desc">
            A responsive storefront organized around your products, content, and customer journeys.
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">02</div>
          <h3 class="pillar-title">WhatsApp Catalog &amp; Conversational Checkout</h3>
          <p class="pillar-desc">
            Where suitable, product discovery and customer inquiries can connect with messaging workflows.
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">03</div>
          <h3 class="pillar-title">Intelligent COD &amp; RTO Shield</h3>
          <p class="pillar-desc">
            Checkout and order workflows can be designed around the payment and delivery options your business supports.
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">04</div>
          <h3 class="pillar-title">Omnichannel Real-Time Sync</h3>
          <p class="pillar-desc">
            Connect catalog or order data with other business systems when the required integrations are available and included in scope.
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">05</div>
          <h3 class="pillar-title">Localized Indian Payment Routing</h3>
          <p class="pillar-desc">
            Payment options are selected for the target market and confirmed project requirements.
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">06</div>
          <h3 class="pillar-title">Global Currency &amp; Tax Compliance</h3>
          <p class="pillar-desc">
            Tax, currency, and invoicing requirements are reviewed and scoped for each project.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Early Partner Callout -->
  <section class="section early-access-section">
    <div class="container">
      <div class="early-access-box">
        <div class="early-access-content">
          <h2 class="early-access-title">Planning an e-commerce project?</h2>
          <p class="early-access-desc">
            Share your products, customer journey, and operational requirements. We can discuss a suitable scope and provide a written proposal.
          </p>
          <div class="early-access-perks">
            <div class="perk-item">
              <strong>Project scope</strong> based on your requirements.
            </div>
            <div class="perk-item">
              <strong>Relevant integrations</strong> identified during discovery.
            </div>
            <div class="perk-item">
              <strong>Clear milestones</strong> included in the written proposal.
            </div>
          </div>
          <a href="/contact/?service=commerce" class="btn btn--primary btn--lg">
            Discuss your requirements
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .commerce-hero {
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .commerce-hero .container {
    max-width: 52rem;
  }

  .coming-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    background: rgba(148, 163, 184, 0.15);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 9999px;
    margin-bottom: var(--space-6);
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 50%;
  }

  .commerce-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .commerce-lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .commerce-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Pillars */
  .pillar-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .pillar-number {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: color-mix(in srgb, var(--accent) 35%, transparent);
    margin-bottom: var(--space-4);
  }

  .pillar-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Early Access */
  .early-access-section {
    padding-bottom: var(--space-24);
  }

  .early-access-box {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    color: var(--color-snow);
    text-align: center;
  }

  .early-access-content {
    max-width: 46rem;
    margin-inline: auto;
  }

  .early-access-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
    margin-bottom: var(--space-4);
  }

  .early-access-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    margin-bottom: var(--space-8);
    line-height: 1.6;
  }

  .early-access-perks {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    text-align: left;
    max-width: 36rem;
    margin-inline: auto;
  }

  .perk-item {
    font-size: var(--text-sm);
    color: #cbd5e1;
    padding-left: 1.5rem;
    position: relative;
  }

  .perk-item::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-weight: 700;
  }

  .perk-item strong {
    color: var(--color-snow);
  }

  /* Service Overview */
  .service-overview-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .service-overview-card {
    padding: var(--space-8);
    background: var(--bg-surface);
  }

  .service-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .service-overview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .service-overview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .overview-item__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .overview-item__val {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
