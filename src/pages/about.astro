---
/**
 * About Page (src/pages/about.astro)
 *
 * Verifiable Facts:
 * - Brand: Strova Group
 * - Founder: Sarthak Shresht
 * - Legal Owner: Babita Kumari, proprietor
 * - Udyam: UDYAM-JH-20-0147452
 * - Operating statement: "Strova Group is a proprietorship of Babita Kumari"
 * - Country: India (Operating from India, serving Indian and international clients)
 * - Email: info@strovagroups.in, Phone & WhatsApp: +91 92880 77802
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';

const founderPersonJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sarthak Shresht',
  jobTitle: 'Founder',
  worksFor: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  description: 'Founder of Strova Group, directing technical architecture, engineering execution, and digital growth systems.',
};

const proprietorPersonJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Babita Kumari',
  jobTitle: 'Proprietor',
  worksFor: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  description: 'Proprietor and legal owner of Strova Group under MSME registration UDYAM-JH-20-0147452.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About',
      item: 'https://strovagroups.in/about/',
    },
  ],
};
---

<BaseLayout
  title="About Strova Group — Founder Story & Principles"
  description="Learn about Strova Group's founder, engineering standards, and mission to deliver transparent software engineering and digital growth."
  jsonLd={[founderPersonJsonLd, proprietorPersonJsonLd, breadcrumbJsonLd]}
>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">About Strova Group</span>
        <h1 class="page-hero__title">
          Engineering Built on Rigor &amp; Direct Accountability
        </h1>
        <p class="page-hero__lead">
          Strova Group was founded on a simple conviction: growing enterprises deserve production-grade software engineering, transparent milestones, and reliable execution without bloated agency overhead.
        </p>
      </div>
    </div>
  </section>

  <!-- Verifiable Credentials Strip -->
  <CredentialsStrip />

  <!-- Founder Narrative & Legal Ownership -->
  <section class="section founder-section" id="founder" aria-labelledby="founder-title">
    <div class="container">
      <div class="founder-grid">
        <div class="founder-card card">
          <span class="section-eyebrow">Leadership &amp; Ownership</span>
          <h2 id="founder-title" class="founder-name">Founder &amp; Operational Structure</h2>
          
          <div class="prose">
            <p>
              Strova Group was founded by <strong>Sarthak Shresht</strong> to bridge the gap between complex software engineering and practical commercial utility for growing businesses.
            </p>
            <p>
              The business is legally registered as an Indian micro-enterprise under proprietor <strong>Babita Kumari</strong> (Udyam Registration: <code>UDYAM-JH-20-0147452</code>). Strova Group is a proprietorship of Babita Kumari.
            </p>
            <p>
              Unlike traditional agencies that delegate customer deliverables to anonymous junior contractors, our leadership maintains direct architectural oversight over every codebase, database schema, and campaign funnel we deploy. Our architectural principle is founded on deterministic precision without unnecessary abstraction layers.
            </p>
          </div>

          <div class="ownership-summary card card--quiet" style="margin-top: var(--space-6);">
            <div class="grid grid--2">
              <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600;">Founder</span>
                <p class="text-base" style="font-weight: 600;">Sarthak Shresht</p>
                <p class="text-xs text-secondary">Technical Architecture &amp; Execution</p>
              </div>
              <div>
                <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600;">Legal Proprietor</span>
                <p class="text-base" style="font-weight: 600;">Babita Kumari</p>
                <p class="text-xs text-secondary">MSME UDYAM-JH-20-0147452</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Operating Principles -->
  <section class="section principles-section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Standards</span>
        <h2 id="principles-title" class="section-title">Our Four Core Operating Principles</h2>
        <p class="section-subtitle">
          How we govern code quality, milestone deliveries, and client partnerships.
        </p>
      </div>

      <div class="grid grid--2">
        <div class="card card--quiet">
          <span class="principle-number">01</span>
          <h3 class="principle-title">Written Specifications Before Code</h3>
          <p class="text-secondary text-sm">
            We never begin development on informal verbal assumptions. Every project starts with an itemized technical blueprint detailing user journeys, endpoints, milestone deadlines, and test plans.
          </p>
        </div>

        <div class="card card--quiet">
          <span class="principle-number">02</span>
          <h3 class="principle-title">100% Code &amp; IP Ownership</h3>
          <p class="text-secondary text-sm">
            Upon final milestone sign-off, full intellectual property and source code repositories transfer completely to your organization. Zero proprietary vendor lock-in or recurring code licensing fees.
          </p>
        </div>

        <div class="card card--quiet">
          <span class="principle-number">03</span>
          <h3 class="principle-title">Measurable Commercial Utility</h3>
          <p class="text-secondary text-sm">
            Whether engineering an offline-first Android application or managing search performance marketing, every system is designed around verifiable operational return and conversion metrics.
          </p>
        </div>

        <div class="card card--quiet">
          <span class="principle-number">04</span>
          <h3 class="principle-title">Direct Communication &amp; Privacy</h3>
          <p class="text-secondary text-sm">
            Clients communicate directly with engineers who understand their architecture. All customer data and proprietary business logic are safeguarded in strict alignment with India's DPDP Act 2023.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Verifiable Business Facts & Registry -->
  <section class="section" aria-labelledby="registry-title">
    <div class="container">
      <div class="card" style="padding: var(--space-8);">
        <span class="section-eyebrow">Verification</span>
        <h2 id="registry-title" class="section-title">Verified Corporate Identity</h2>
        <div class="grid grid--3" style="margin-top: var(--space-6);">
          <div>
            <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600;">Entity Name</span>
            <p class="text-sm font-semibold">Strova Group</p>
            <p class="text-xs text-secondary">Proprietorship of Babita Kumari</p>
          </div>
          <div>
            <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600;">MSME Registration</span>
            <p class="text-sm font-semibold">UDYAM-JH-20-0147452</p>
            <a href="https://udyamregistration.gov.in/Udyam_Verify.aspx" target="_blank" rel="noopener noreferrer" class="text-xs">
              Verify on MSME Portal &rarr;
            </a>
          </div>
          <div>
            <span class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600;">Official Contact</span>
            <p class="text-sm font-semibold">info@strovagroups.in</p>
            <p class="text-xs text-secondary">+91 92880 77802 (Mon–Sat IST)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Inbound Contact CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="card cta-card" style="text-align: center; padding: var(--space-12) var(--space-8);">
        <span class="section-eyebrow">Work With Us</span>
        <h2 class="cta-title">Ready to partner with Strova Group?</h2>
        <p class="cta-desc text-secondary" style="max-width: 44rem; margin: var(--space-3) auto var(--space-6);">
          Send us your project goals or technical specifications. We review every inquiry and provide a clear, written fixed-scope quote within 1 business day.
        </p>
        <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/contact/" class="btn btn--primary btn--lg">Request a quote</a>
          <a href="mailto:info@strovagroups.in" class="btn btn--outline btn--lg">Email info@strovagroups.in</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-surface);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-hero__title {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-4);
  }

  .page-hero__lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .founder-card {
    padding: var(--space-10);
  }

  .founder-name {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .principle-number {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    color: var(--accent);
    margin-bottom: var(--space-2);
    display: block;
  }

  .principle-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .cta-title {
    font-size: var(--text-2xl);
  }
</style>
