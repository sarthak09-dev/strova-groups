---
/**
 * Home Page (src/pages/index.astro)
 *
 * 9-Stage Editorial Narrative Flow:
 * 1. Hero: Plain-English headline, who it is for, "Request a quote", "We reply within 1 business day"
 * 2. Three specific problems clients have today (concrete, not abstract)
 * 3. The divisions as short paragraphs with an outcome each
 * 4. How it works in 4 plain steps (including what happens after enquiry)
 * 5. How quotes work (replaces public pricing: fixed written scope, 1-day quote, 0 hidden costs)
 * 6. Founder note (Sarthak Shresht & Babita Kumari, honest story, accountability)
 * 7. Working agreement summary (written scope, 50% advance, balance before handover, 100% code ownership)
 * 8. FAQ with direct one-paragraph answers
 * 9. Final CTA with low-effort option ("Send us three lines about your goal")
 *
 * Absolute Rules:
 * - NO public prices, ranges, "starting from", or budget bands
 * - NO invented testimonials, client logos, numbers, or awards
 * - NO dark patterns
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeHero from '../components/ThreeHero.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';

const faqs = [
  {
    question: 'How do project quotes work?',
    answer:
      'You describe your project via our 60-second quote form or by emailing info@strovagroups.in. Within one business day, we review your specifications and return a written, itemized fixed-scope quote outlining exact deliverables, milestones, and timelines. We do not charge hidden fees or surprise change orders.',
  },
  {
    question: 'How does your 50% upfront payment structure work?',
    answer:
      'We work on clear milestone commitments. Every engagement begins with a 50% advance upon mutual sign-off on the written scope to schedule dedicated engineering sprints. The remaining 50% balance is invoiced only after staging demonstration, quality assurance review, and prior to production handover.',
  },
  {
    question: 'Do we own the full source code and intellectual property?',
    answer:
      'Yes. Upon final milestone settlement, complete ownership of all custom codebase, repositories, assets, and deployment configurations transfers entirely to your organization without proprietary vendor lock-in.',
  },
  {
    question: 'How do you build WhatsApp automations?',
    answer:
      'We build production workflows using the official Meta WhatsApp Cloud API and webhook event handlers connected directly to your CRM, database, or inventory system. This ensures dependable delivery, compliant template messaging, and automatic triage without brittle unofficial scrapers.',
  },
  {
    question: 'Do you work with international clients outside India?',
    answer:
      'Yes. We operate from India and serve domestic commercial businesses as well as international clients across North America, Europe, and Asia-Pacific. Invoices are issued in INR for Indian clients and USD for international clients upon request.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="Strova Group — Technology, Commerce & Digital Growth"
  description="Strova Group engineers high-performance web systems, native Android applications, automated WhatsApp workflows, and data-driven digital growth."
  jsonLd={[faqJsonLd]}
>
  <!-- 1. Hero Section -->
  <section class="hero-section" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="section-eyebrow reveal-item">Strova Group &bull; Engineering &amp; Growth</span>
        <h1 id="hero-title" class="hero-title reveal-item">
          Technology, commerce, and digital growth for growing businesses.
        </h1>
        <p class="hero-lead reveal-item">
          Engineered for owners of small and mid-size enterprises and international buyers who need reliable execution, direct founder accountability, and zero agency bloat.
        </p>
        <div class="hero-actions reveal-item">
          <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
            Request a quote
          </a>
          <a href="#divisions" class="btn btn--outline btn--lg">
            Our divisions &rarr;
          </a>
        </div>
        <div class="hero-reassurance reveal-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>We reply within 1 business day &bull; Direct founder review</span>
        </div>
      </div>
      <div class="hero-visual reveal-item">
        <ThreeHero />
      </div>
    </div>
  </section>

  <!-- Verifiable Credentials Strip -->
  <CredentialsStrip />

  <!-- 2. Three Concrete Client Problems -->
  <section class="section problems-section" aria-labelledby="problems-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">The Challenge</span>
        <h2 id="problems-heading" class="section-title">Three problems holding growing businesses back</h2>
        <p class="section-subtitle">
          Most organizations do not lack ambitious ideas—they lack disciplined, transparent technical partners.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <div class="problem-number">01</div>
          <h3 class="problem-title">Software that stalls in staging</h3>
          <p class="problem-desc text-secondary">
            Generic templates and outsourced junior teams often leave you with unmaintainable code, sluggish load speeds, and missing edge-case handling that breaks when real users arrive.
          </p>
        </div>

        <div class="card card--quiet">
          <div class="problem-number">02</div>
          <h3 class="problem-title">Marketing spend with no pipeline</h3>
          <p class="problem-desc text-secondary">
            Agencies report vanity impressions and clicks, but fail to instrument conversion tracking or CRM pipelines. You spend capital without knowing which channels actually generate paying customers.
          </p>
        </div>

        <div class="card card--quiet">
          <div class="problem-number">03</div>
          <h3 class="problem-title">Vendor blame when workflows fail</h3>
          <p class="problem-desc text-secondary">
            When an API connection or WhatsApp automation drops, fragmented service providers point fingers at each other. Your operations stop while customer inquiries go unanswered.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Divisions Overview -->
  <section class="section divisions-section" id="divisions" aria-labelledby="divisions-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Capabilities</span>
        <h2 id="divisions-heading" class="section-title">Specialized divisions. One standard of engineering.</h2>
        <p class="section-subtitle">
          We combine software architecture, digital customer acquisition, and modern commerce infrastructure under single-source accountability.
        </p>
      </div>

      <div class="grid grid--3">
        <!-- Division 1: Technologies -->
        <article class="card division-card">
          <span class="division-card__tag">Division 01</span>
          <h3 class="division-card__title">Strova Technologies</h3>
          <p class="division-card__desc text-secondary">
            High-speed web platforms, native Android applications, custom cloud software, and official WhatsApp Business automations.
          </p>
          <div class="division-card__outcome">
            <strong>Outcome:</strong> Dependable software infrastructure that automates repetitive workflows and eliminates operational bottlenecks.
          </div>
          <div class="division-card__cta">
            <a href="/technologies/" class="btn btn--outline btn--sm">
              Explore Technologies &rarr;
            </a>
          </div>
        </article>

        <!-- Division 2: Digital -->
        <article class="card division-card">
          <span class="division-card__tag">Division 02</span>
          <h3 class="division-card__title">Strova Digital</h3>
          <p class="division-card__desc text-secondary">
            Technical SEO audits, search performance campaigns, and structured inbound conversion funnels.
          </p>
          <div class="division-card__outcome">
            <strong>Outcome:</strong> Measurable inbound customer inquiries with transparent analytics and zero vanity reporting.
          </div>
          <div class="division-card__cta">
            <a href="/digital/" class="btn btn--outline btn--sm">
              Explore Digital &rarr;
            </a>
          </div>
        </article>

        <!-- Division 3: Commerce -->
        <article class="card division-card division-card--coming-soon">
          <span class="division-card__tag">Division 03 &bull; Coming Soon</span>
          <h3 class="division-card__title">Strova Commerce</h3>
          <p class="division-card__desc text-secondary">
            Headless commerce architecture, multi-channel stock sync, and conversational catalog checkout systems.
          </p>
          <div class="division-card__outcome">
            <strong>Outcome:</strong> Sub-second mobile storefronts and automated order fulfillment pipelines (currently in active development).
          </div>
          <div class="division-card__cta">
            <a href="/commerce/" class="btn btn--outline btn--sm">
              View Commerce Roadmap &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. How It Works in 4 Plain Steps -->
  <section class="section process-section" id="how-we-work" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Execution</span>
        <h2 id="process-heading" class="section-title">How we work: from inquiry to handover</h2>
        <p class="section-subtitle">
          A disciplined four-step execution sequence designed to eliminate ambiguity, guarantee timelines, and maintain complete transparency.
        </p>
      </div>

      <div class="process-grid grid grid--4">
        <!-- Step 1 -->
        <div class="card process-step">
          <div class="step-num">Step 01</div>
          <h3 class="step-title">Describe your project</h3>
          <p class="step-desc text-secondary">
            Fill out our 60-second quote form or email info@strovagroups.in. Share your core requirements, target users, and rough timeline.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="card process-step">
          <div class="step-num">Step 02</div>
          <h3 class="step-title">Written fixed quote</h3>
          <p class="step-desc text-secondary">
            Within 1 business day, we deliver an itemized written quote defining clear deliverables, milestone schedule, and exact scope.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="card process-step">
          <div class="step-num">Step 03</div>
          <h3 class="step-title">50% advance &amp; sprints</h3>
          <p class="step-desc text-secondary">
            Development kicks off upon written sign-off and the 50% deposit. You receive private staging demo links after each sprint.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="card process-step">
          <div class="step-num">Step 04</div>
          <h3 class="step-title">Review &amp; full handover</h3>
          <p class="step-desc text-secondary">
            Following your staging approval, the final balance is settled. 100% of custom source code, repositories, and documentation transfer to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. How Quotes Work (No Public Pricing) -->
  <section class="section quotes-section" id="how-quotes-work" aria-labelledby="quotes-heading">
    <div class="container">
      <div class="card quotes-card">
        <div class="quotes-card__header">
          <span class="section-eyebrow">Commercial Transparency</span>
          <h2 id="quotes-heading" class="section-title">How our quotes work</h2>
          <p class="quotes-card__lead text-secondary">
            We do not publish arbitrary fixed menu prices because engineering scope varies by architecture, integration complexity, and scale. Instead, we provide fixed-scope written proposals before any commitment.
          </p>
        </div>

        <div class="grid grid--3 quotes-pillars">
          <div class="quotes-pillar">
            <h3 class="pillar-title">1. Written Fixed Scope</h3>
            <p class="text-secondary text-sm">
              Every deliverable, API connection, and layout is documented in writing. You never pay unexpected fees or hidden change orders.
            </p>
          </div>
          <div class="quotes-pillar">
            <h3 class="pillar-title">2. 1-Business-Day Reply</h3>
            <p class="text-secondary text-sm">
              We review inbound specifications promptly. You receive a structured breakdown and timeline within 24 business hours.
            </p>
          </div>
          <div class="quotes-pillar">
            <h3 class="pillar-title">3. Clear Milestone Terms</h3>
            <p class="text-secondary text-sm">
              Work starts after written approval and 50% advance. The balance is invoiced only after staging sign-off.
            </p>
          </div>
        </div>

        <div class="quotes-card__action">
          <a href="/contact/" class="btn btn--primary">
            Request your project quote &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Founder Note -->
  <section class="section founder-section" aria-labelledby="founder-heading">
    <div class="container">
      <div class="card founder-card">
        <div class="founder-card__content">
          <span class="section-eyebrow">Leadership</span>
          <h2 id="founder-heading" class="section-title">Direct founder accountability</h2>
          <p class="founder-card__text text-secondary">
            Strova Group was founded by Sarthak Shresht, with legal proprietorship registered under Babita Kumari (Udyam: UDYAM-JH-20-0147452).
          </p>
          <p class="founder-card__text text-secondary">
            When you partner with Strova Group, your project is not handed off to an account executive or an anonymous outsourcing layer. We maintain direct, hands-on architectural oversight on every engagement—from the initial technical specification to the final production deployment.
          </p>
          <div class="founder-card__meta">
            <span class="founder-name">Sarthak Shresht</span>
            <span class="founder-role text-muted">Founder &bull; Strova Group</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Working Agreement Summary -->
  <section class="section agreement-section" aria-labelledby="agreement-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Terms of Engagement</span>
        <h2 id="agreement-heading" class="section-title">Our working agreement principles</h2>
        <p class="section-subtitle">
          Clear commercial boundaries that protect your timeline, budget, and intellectual property.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <h3 class="agreement-title">Written Specification</h3>
          <p class="agreement-text text-secondary text-sm">
            Work never begins on verbal assumptions. Every feature, responsive breakpoint, and technical constraint is itemized in a signed specification.
          </p>
        </div>

        <div class="card card--quiet">
          <h3 class="agreement-title">50% Advance Structure</h3>
          <p class="agreement-text text-secondary text-sm">
            A 50% deposit reserves scheduled engineering sprints. The remaining 50% is due only upon staging demonstration approval before domain handover.
          </p>
        </div>

        <div class="card card--quiet">
          <h3 class="agreement-title">Complete Code Ownership</h3>
          <p class="agreement-text text-secondary text-sm">
            Upon final settlement, you receive complete intellectual property and repository rights to all custom code. Zero proprietary platform lock-in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ Section -->
  <section class="section faq-section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Clarity</span>
        <h2 id="faq-heading" class="section-title">Frequently asked questions</h2>
        <p class="section-subtitle">
          Direct, one-paragraph answers to common commercial and operational questions.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item card" id={`faq-${index}`}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer text-secondary">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Final Call to Action -->
  <section class="section cta-section" aria-labelledby="cta-heading">
    <div class="container">
      <div class="card cta-card">
        <div class="cta-content">
          <span class="section-eyebrow">Get Started</span>
          <h2 id="cta-heading" class="cta-title">Send us three lines about your goal</h2>
          <p class="cta-desc text-secondary">
            No lengthy RFP needed. Tell us what you want to build, who it is for, and your rough timeline. We will review your requirements and reply with a clear, written quote within 1 business day.
          </p>
          <div class="cta-buttons">
            <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
              Request a quote
            </a>
            <a href="mailto:info@strovagroups.in" class="btn btn--outline btn--lg">
              Email info@strovagroups.in
            </a>
            <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
              WhatsApp (+91 92880 77802)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- Hero Section ---------------- */
  .hero-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-12);
    }
  }

  .hero-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-5);
  }

  .hero-lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .hero-reassurance {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ---------------- Problems Section ---------------- */
  .problem-number {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .problem-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .problem-desc {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* ---------------- Divisions Section ---------------- */
  .division-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .division-card__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .division-card__title {
    font-size: var(--text-xl);
  }

  .division-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .division-card__outcome {
    font-size: var(--text-xs);
    color: var(--text-primary);
    background: var(--bg-surface);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border-left: 2px solid var(--accent);
    margin-block: var(--space-2);
  }

  .division-card__cta {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .division-card--coming-soon {
    opacity: 0.88;
  }

  /* ---------------- Process Steps ---------------- */
  .step-num {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .step-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .step-desc {
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  /* ---------------- Quotes Section ---------------- */
  .quotes-card {
    padding: var(--space-10);
  }

  .quotes-card__header {
    max-width: 48rem;
    margin-bottom: var(--space-8);
  }

  .quotes-card__lead {
    margin-top: var(--space-3);
    line-height: 1.6;
  }

  .quotes-pillars {
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .pillar-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .quotes-card__action {
    display: flex;
    justify-content: flex-start;
  }

  /* ---------------- Founder Section ---------------- */
  .founder-card {
    padding: var(--space-10);
    border-left: 3px solid var(--accent);
  }

  .founder-card__content {
    max-width: 52rem;
  }

  .founder-card__text {
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .founder-card__meta {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
  }

  .founder-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
  }

  .founder-role {
    font-size: var(--text-xs);
  }

  /* ---------------- Agreement Section ---------------- */
  .agreement-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .agreement-text {
    line-height: 1.6;
  }

  /* ---------------- FAQ Section ---------------- */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    transition: transform var(--duration-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ---------------- CTA Section ---------------- */
  .cta-card {
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .cta-content {
    max-width: 44rem;
    margin: 0 auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* ---------------- Section Headers ---------------- */
  .section-header {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    line-height: 1.6;
  }
</style>
