
---
/**
 * Home Page — Premium Editorial Redesign
 *
 * Composition:
 * 1. Cinematic Hero Stage: Framing editorial typography, 3D crystalline centerpiece, primary + secondary CTA
 * 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4)
 * 3. Credentials strip (verifiable registrations)
 * 4. Service areas: Custom Software, AI & Automation, Digital Growth
 * 5. Approach: Discover → Define → Build → Verify → Support
 * 6. How we work (quotes + agreement merged into editorial section)
 * 7. Founder accountability
 * 8. FAQ with JSON-LD
 * 9. Final CTA
 *
 * Canary phrases (recorded in README for copy detection):
 * - "We build for owners who measure twice before they invest."
 * - "One source of truth, one team, one standard."
 * - "Every engagement follows the same disciplined sequence."
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';
import { showcaseConcepts } from '../data/showcase';

const faqs = [
  {
    question: 'How do project quotes work?',
    answer:
      'You describe your project via our quote form or by emailing info@strovagroups.in. Within one business day, we review your specifications and return a written, itemised fixed-scope quote outlining exact deliverables, milestones, and timelines. There are no hidden fees or surprise change orders.',
  },
  {
    question: 'How does the 50 % upfront payment structure work?',
    answer:
      'Every engagement begins with a 50 % advance upon mutual sign-off on the written scope. The remaining 50 % is invoiced only after staging demonstration, quality-assurance review, and prior to production handover.',
  },
  {
    question: 'Do we own the source code and intellectual property?',
    answer:
      'Yes. Upon final settlement, complete ownership of all custom code, repositories, assets, and deployment configurations transfers entirely to your organisation. There is no proprietary vendor lock-in.',
  },
  {
    question: 'How do you build WhatsApp automations?',
    answer:
      'We build production workflows using the official Meta WhatsApp Cloud API and webhook event handlers connected to your CRM, database, or inventory system. This ensures dependable delivery, compliant template messaging, and automatic triage without unofficial scrapers.',
  },
  {
    question: 'Do you work with international clients outside India?',
    answer:
      'Yes. We serve domestic businesses and international clients across North America, Europe, and Asia-Pacific. Invoices are issued in INR for Indian clients and USD for international clients upon request.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="Strova Group | Web Development & Business Automation"
  description="India-based Strova Group builds business websites, web apps, e-commerce, workflow automation and digital products through Strova Technology."
  jsonLd={[faqJsonLd]}
>
  <!-- Cinematic Hero & Manifesto Stage Wrapper -->
  <div class="cinematic-wrapper" id="cinematic-wrapper">
<!-- 1. Hero Viewport Stage -->
    <section class="hero" id="hero-stage" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <!-- Top Status Flank -->
        <div class="hero__top-flank">
          <span class="hero__eyebrow">
            <span class="eyebrow-dot"></span>
            Strova Group &bull; Strova Technology
          </span>
          <span class="hero__status-badge">
            DIGITAL / AUTOMATION / PRODUCTS
          </span>
        </div>

        <div class="hero__centerpiece">
          <p class="hero__overline">Strova Group / Strova Technology</p>
          <h1 id="hero-title" class="hero__title">
            <span class="hero__title-split">Useful technology,</span>
            <span class="hero__title-split hero__title-accent">built around your business.</span>
          </h1>
          <p class="hero__intro">Digital services, practical automation, and software products—connected under one technology business.</p>
        </div>
        <div class="hero__art" aria-hidden="true">
          <svg viewBox="0 0 520 520" role="presentation">
            <circle class="hero__orbit hero__orbit--outer" cx="260" cy="260" r="214" />
            <circle class="hero__orbit hero__orbit--middle" cx="260" cy="260" r="166" />
            <path class="hero__mark" d="M325 160c0-24-19-43-43-43h-67c-29 0-52 23-52 52s23 52 52 52h90c29 0 52 23 52 52s-23 52-52 52h-67c-24 0-43-19-43-43" />
            <circle class="hero__point" cx="356" cy="273" r="9" />
          </svg>
          <span>Ideas / Technology / Growth</span>
        </div>

        <!-- Bottom Flanking Intelligence & Action Modules -->
        <div class="hero__bottom-flank">
          <div class="hero__flank-card hero__flank-card--right">
            <div class="hero__actions">
              <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
                Discuss Your Project &rarr;
              </a>
              <a href="#showcase" class="btn btn--outline btn--lg">
                Explore Showcase
              </a>
            </div>
            <p class="hero__note">
              Tell us what your business needs to do better.
            </p>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="hero__scroll-wrap">
          <a href="#manifesto" class="hero__scroll-indicator" aria-label="Scroll to explore our capabilities">
            <span class="scroll-indicator__track">
              <span class="scroll-indicator__dot"></span>
            </span>
            <span class="scroll-indicator__label">Scroll to explore</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4) -->
    <section class="section manifesto-section" id="manifesto" aria-label="Our Core Purpose">
      <div class="container manifesto__inner reveal">
        <div class="manifesto__eyebrow">
          <span class="manifesto__spark">✦</span>
          <span>ONE TECHNOLOGY BUSINESS / THREE CONNECTED PILLARS</span>
        </div>

        <p class="manifesto__statement">
          Strova Group is the parent brand. Strova Technology brings together digital services, business automation, and software products as three connected pillars—not separate companies.
        </p>

        <!-- Interactive Pill Controls (Video 1 & 2 Luxury Pill Badges) -->
        <div class="manifesto__pills" role="list">
          <a href="/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Digital</span>
          </a>
          <a href="/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>Automation</span>
          </a>
          <a href="/digital/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Products</span>
          </a>
        </div>

      </div>
    </section>
  </div>

  <!-- Verifiable Credentials -->
  <CredentialsStrip />

  <!-- Illustrative interface concepts, not client case studies -->
  <section class="section showcase-section" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-header showcase__header reveal">
        <div class="showcase__badge">
          <span class="badge-dot"></span>
          <span>STROVA GROUP / STROVA TECHNOLOGY</span>
        </div>
        <h2 id="showcase-heading" class="section-title">
          Interfaces and systems, designed with purpose.
        </h2>
        <p class="section-subtitle text-secondary">
          A selection of illustrative directions across digital experiences, automation, and software products. These are interface concepts, not client case studies.
        </p>
      </div>

      <div class="showcase__grid reveal">
        {showcaseConcepts.map((concept) => (
          <article class="showcase-card">
            <div class="showcase-card__visual">
              <img
                class="showcase-card__img"
                src={concept.image}
                alt={concept.alt.en}
                width="1200"
                height="760"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="showcase-card__content">
              <span class="showcase-card__tag">{concept.pillar.en}</span>
              <h3 class="showcase-card__title">{concept.title.en}</h3>
              <p class="showcase-card__desc text-secondary">{concept.description.en}</p>
              <a href={concept.href} class="showcase-card__link">{concept.link.en} &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Service Areas -->
  <section class="section" id="capabilities" aria-labelledby="capabilities-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="capabilities-heading" class="section-title">What we build</h2>
        <p class="section-subtitle text-secondary">
          Strova Group is the parent brand. Digital, Automation, and Products are connected pillars of Strova Technology.
        </p>
      </div>

      <div class="services reveal">
        <article class="service">
          <span class="service__number">01</span>
          <h3 class="service__title">Digital</h3>
          <p class="service__desc text-secondary">
            Business websites, landing pages, web applications, customer portals, e-commerce, and custom digital platforms.
          </p>
          <a href="/technologies/#pillar-digital" class="service__link">
            Explore digital services &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">02</span>
          <h3 class="service__title">Automation</h3>
          <p class="service__desc text-secondary">
            Business workflows, CRM and operations integrations, and AI integrations where they fit the task.
          </p>
          <a href="/technologies/#pillar-automation" class="service__link">
            Explore automation &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">03</span>
          <h3 class="service__title">Products</h3>
          <p class="service__desc text-secondary">
            SaaS applications, reusable software, and digital tools developed around validated customer needs.
          </p>
          <a href="/technologies/#pillar-products" class="service__link">
            Explore the technology business &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Approach -->
  <section class="section approach" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="approach-heading" class="section-title">Our approach</h2>
        <p class="section-subtitle text-secondary">
          Every engagement follows the same disciplined sequence.
          No shortcuts, no ambiguity.
        </p>
      </div>

      <ol class="steps reveal">
        <li class="step">
          <span class="step__number">01</span>
          <h3 class="step__title">Discover</h3>
          <p class="step__desc text-secondary">
            You describe your project. We listen, ask questions, and
            understand the problem before proposing anything.
          </p>
        </li>
        <li class="step">
          <span class="step__number">02</span>
          <h3 class="step__title">Define</h3>
          <p class="step__desc text-secondary">
            Within one business day we return a written, itemised scope
            with deliverables, milestones, and a fixed price.
          </p>
        </li>
        <li class="step">
          <span class="step__number">03</span>
          <h3 class="step__title">Build</h3>
          <p class="step__desc text-secondary">
            Development begins after sign-off and the 50 % advance.
            You receive staging demos after each sprint.
          </p>
        </li>
        <li class="step">
          <span class="step__number">04</span>
          <h3 class="step__title">Verify</h3>
          <p class="step__desc text-secondary">
            Joint review on staging. You test every feature against the
            signed specification before the balance is due.
          </p>
        </li>
        <li class="step">
          <span class="step__number">05</span>
          <h3 class="step__title">Support</h3>
          <p class="step__desc text-secondary">
            Full handover of source code, repositories, and documentation.
            100 % ownership transfers to your organisation.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 5. How We Work -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="how-heading" class="section-title">How we work</h2>
        <p class="section-subtitle text-secondary">
          One source of truth, one team, one standard.
          Clear commercial terms that protect your timeline, budget, and IP.
        </p>
      </div>

      <div class="principles reveal">
        <div class="principle">
          <h3 class="principle__title">Written fixed scope</h3>
          <p class="text-secondary text-sm">
            Every deliverable, API connection, and layout is documented before
            work begins. You never pay unexpected fees or hidden change orders.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">50 % advance structure</h3>
          <p class="text-secondary text-sm">
            A deposit reserves scheduled engineering sprints. The balance is
            due only upon staging approval — before production handover.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">Complete code ownership</h3>
          <p class="text-secondary text-sm">
            Upon final settlement you receive full intellectual property and
            repository rights. Zero proprietary platform lock-in.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">Global remote delivery</h3>
          <p class="text-secondary text-sm">
            Direct collaboration for Indian and international enterprises.
            Daily async progress, staging demos, and invoicing in INR or USD.
          </p>
        </div>
      </div>

      <div class="principles__cta">
        <a href="/contact/" class="btn btn--primary" data-track="quote_click">
          Request your project quote &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Founder Accountability -->
  <section class="section founder" aria-labelledby="founder-heading">
    <div class="container">
      <div class="founder__inner reveal">
        <h2 id="founder-heading" class="section-title">Direct founder accountability</h2>
        <p class="text-secondary founder__text">
          Strova Group was founded by Sarthak Shreshth, with legal proprietorship
          registered under Babita Kumari (Udyam: UDYAM-JH-20-0147452). When you
          partner with Strova Group, your project is not handed off to an account
          executive or an anonymous outsourcing layer. We maintain direct,
          hands-on architectural oversight on every engagement.
        </p>
        <div class="founder__meta">
          <span class="founder__name">Sarthak Shreshth</span>
          <span class="founder__role text-muted">Founder · Strova Group</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="faq-heading" class="section-title">Frequently asked questions</h2>
      </div>

      <div class="faq-list reveal">
        {faqs.map((faq, index) => (
          <details class="faq-item" id={`faq-${index}`}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer text-secondary">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section class="section cta" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta__inner reveal">
        <h2 id="cta-heading" class="cta__title">
          Tell us what you want to build.
        </h2>
        <p class="cta__desc text-secondary">
          No lengthy RFP needed. Share your goal, your audience, and a rough
          timeline. We reply with a clear, written quote within one business day.
        </p>
        <div class="cta__actions">
          <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
            Discuss a project
          </a>
          <a href="mailto:info@strovagroups.in" class="btn btn--outline btn--lg">
            Email info@strovagroups.in
          </a>
          <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
            WhatsApp (+91 92880 77802)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cinematic-wrapper { position: relative; overflow: clip; background: var(--bg-page); }
  .hero { position: relative; min-height: min(760px, calc(100svh - 4rem)); padding-block: clamp(2.5rem, 5vw, 4.5rem); display: flex; align-items: center; }
  .hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .9fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .hero__top-flank { grid-column: 1 / -1; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .hero__eyebrow,.hero__status-badge,.flank-card__kicker,.hero__overline,.hero__art > span,.manifesto__eyebrow,.showcase__badge { color:#49202B; font-size:.72rem; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
  .eyebrow-dot,.badge-dot { width:.45rem;height:.45rem;border-radius:50%;background:#6F7969;display:inline-block;margin-right:.55rem; }
  .hero__centerpiece { grid-column:1; grid-row:2; position:relative; z-index:1; max-width:46rem; }
  .hero__overline { margin-bottom:1.15rem; }
  .hero__title { display:block; max-width:14ch; font-size:clamp(3.1rem,6.4vw,6.2rem); line-height:.95; letter-spacing:-.055em; font-weight:500; }
  .hero__title-split { display:block; }
  .js-reveal .hero__overline { animation:heroEyebrowFade .55s var(--ease-out) .08s both; }
  .js-reveal .hero__title-split { animation:heroTitleReveal .7s var(--ease-out) .18s both; }
  .js-reveal .hero__title-accent { animation-delay:.3s; }
  .js-reveal .hero__intro { animation:heroFlankSlideIn .6s var(--ease-out) .42s both; }
  .js-reveal .hero__art { animation:heroTitleReveal .9s var(--ease-out) .22s both; }
  .js-reveal .hero__eyebrow,.js-reveal .hero__status-badge { animation:heroEyebrowFade .5s var(--ease-out) .08s both; }
  .js-reveal .hero__flank-card--left,.js-reveal .hero__flank-card--right { animation:heroFlankSlideIn .55s var(--ease-out) .42s both; }
  .hero__title-accent { color:#49202B; font-style:italic; }
  .hero__intro { max-width:34rem; margin-top:1.6rem; color:#6F7969; font-size:clamp(1.05rem,1.5vw,1.25rem); line-height:1.7; }
  .hero__art { grid-column:2; grid-row:2 / 4; align-self:center; justify-self:center; width:min(100%,31rem); aspect-ratio:1; display:grid; place-items:center; position:relative; color:#49202B; }
  .hero__art svg { width:100%; overflow:visible; }
  .hero__orbit { fill:none; stroke:#6F7969; stroke-width:1; opacity:.33; }
  .hero__orbit--middle { stroke:#49202B; stroke-dasharray:2 7; opacity:.45; }
  .hero__mark { fill:none; stroke:#49202B; stroke-width:25; stroke-linecap:round; stroke-linejoin:round; }
  .hero__point { fill:#6F7969; }
  .hero__art > span { position:absolute; bottom:9%; right:0; }
  .hero__bottom-flank { grid-column:1; grid-row:3; display:flex; flex-direction:column; align-items:flex-start; gap:1.25rem; max-width:38rem; }
  .hero__flank-card--left { border-left:2px solid #6F7969; padding-left:1rem; }
  .flank-card__kicker { display:block; margin-bottom:.4rem; }
  .flank-card__lead { color:#6F7969; font-size:.95rem; margin:0; }
  .hero__flank-card--right { display:flex;flex-direction:column;align-items:flex-start;gap:.75rem; }
  .hero__actions { display:flex;gap:.75rem;flex-wrap:wrap; }
  .hero__note { color:#6F7969;font-size:.78rem; }
  .hero__scroll-wrap { grid-column:1 / -1; display:flex;justify-content:center;padding-top:1rem; }
  .hero__scroll-indicator { display:flex;align-items:center;gap:.65rem;color:#6F7969;text-decoration:none;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase; }
  .scroll-indicator__track { width:1rem;height:1.5rem;border:1px solid #6F7969;border-radius:1rem;display:grid;place-items:start center;padding-top:.25rem; }
  .scroll-indicator__dot { width:3px;height:5px;border-radius:2px;background:#49202B; }
  .manifesto-section { background:#292A27;color:#FFFCF7;padding-block:clamp(5rem,10vw,9rem);text-align:center; }
  .manifesto__inner { max-width:58rem;display:flex;flex-direction:column;align-items:center; }
  .manifesto__eyebrow { color:#F4EFE6;border:1px solid rgba(244,239,230,.22);border-radius:999px;padding:.5rem 1rem;margin-bottom:1.5rem; }
  .manifesto__spark { color:#6F7969; }
  .manifesto__statement { color:#FFFCF7;font:400 clamp(1.7rem,3.5vw,3rem)/1.25 var(--font-heading);max-width:30ch;margin:0 auto 2rem; }
  .manifesto__pills { display:flex;gap:.7rem;flex-wrap:wrap;justify-content:center;margin-bottom:3.5rem; }
  .manifesto__pill { display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1rem;border:1px solid rgba(255,252,247,.24);border-radius:999px;color:#FFFCF7;text-decoration:none;transition:background .2s ease,border-color .2s ease,transform .2s ease; }
  .manifesto__pill:hover { background:rgba(111,121,105,.28);border-color:#6F7969;transform:translateY(-2px);color:#FFFCF7; }
  .pill-icon { color:#6F7969; }
  .manifesto__stats { width:100%;display:flex;justify-content:space-around;gap:1.5rem;flex-wrap:wrap;border-top:1px solid rgba(255,252,247,.2);padding-top:2rem; }
  .stat-card { text-align:center; }.stat-number { display:block;color:#FFFCF7;font:500 clamp(2rem,4vw,3.5rem)/1.1 var(--font-heading); }.stat-label { display:block;color:#F4EFE6;font-size:.8rem;max-width:22ch; }.stat-divider { width:1px;background:rgba(255,252,247,.2); }
  .js-reveal .reveal { opacity:0;transform:translateY(20px);transition:opacity .55s var(--ease-out),transform .55s var(--ease-out); }
  .js-reveal .reveal.in { opacity:1;transform:none; }
  .section { padding-block:clamp(4rem,8vw,7rem); }.section-header { max-width:52rem;margin-bottom:2.5rem; }.section-title { font-size:clamp(2.2rem,4.5vw,4rem);letter-spacing:-.04em; }.section-subtitle { font-size:1.05rem;max-width:50ch;margin-top:.8rem; }
