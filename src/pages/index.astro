---
/**
 * Home Page — Premium Editorial Redesign
 *
 * Composition:
 * 1. Cinematic Hero Stage: Framing editorial typography, 3D crystalline centerpiece, primary + secondary CTA
 * 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4)
 * 3. Credentials strip (verifiable registrations)
 * 4. Service areas: Custom Software, AI & Automation, Digital Growth
 * 5. Approach: Discover → Define → Build → Verify → Support
 * 6. How we work (quotes + agreement merged into editorial section)
 * 7. Founder accountability
 * 8. FAQ with JSON-LD
 * 9. Final CTA
 *
 * Canary phrases (recorded in README for copy detection):
 * - "We build for owners who measure twice before they invest."
 * - "One source of truth, one team, one standard."
 * - "Every engagement follows the same disciplined sequence."
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeHero from '../components/ThreeHero.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';

const faqs = [
  {
    question: 'How do project quotes work?',
    answer:
      'You describe your project via our quote form or by emailing info@strovagroups.in. Within one business day, we review your specifications and return a written, itemised fixed-scope quote outlining exact deliverables, milestones, and timelines. There are no hidden fees or surprise change orders.',
  },
  {
    question: 'How does the 50 % upfront payment structure work?',
    answer:
      'Every engagement begins with a 50 % advance upon mutual sign-off on the written scope. The remaining 50 % is invoiced only after staging demonstration, quality-assurance review, and prior to production handover.',
  },
  {
    question: 'Do we own the source code and intellectual property?',
    answer:
      'Yes. Upon final settlement, complete ownership of all custom code, repositories, assets, and deployment configurations transfers entirely to your organisation. There is no proprietary vendor lock-in.',
  },
  {
    question: 'How do you build WhatsApp automations?',
    answer:
      'We build production workflows using the official Meta WhatsApp Cloud API and webhook event handlers connected to your CRM, database, or inventory system. This ensures dependable delivery, compliant template messaging, and automatic triage without unofficial scrapers.',
  },
  {
    question: 'Do you work with international clients outside India?',
    answer:
      'Yes. We serve domestic businesses and international clients across North America, Europe, and Asia-Pacific. Invoices are issued in INR for Indian clients and USD for international clients upon request.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="Strova Group — Technology, Commerce & Growth"
  description="Strova Group builds websites, applications, and practical business automation that help teams work better and serve their customers."
  jsonLd={[faqJsonLd]}
>
  {/* Reveal-animation gate: adds .js-reveal so CSS hides .reveal elements before IO triggers them */}
  <script is:inline>document.documentElement.classList.add('js-reveal');</script>
  <!-- Cinematic Hero & Manifesto Stage Wrapper -->
  <div class="cinematic-wrapper" id="cinematic-wrapper">
    <div class="cinematic-backdrop" aria-hidden="true">
      <ThreeHero />
    </div>

    <!-- 1. Hero Viewport Stage -->
    <section class="hero" id="hero-stage" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <!-- Top Status Flank -->
        <div class="hero__top-flank">
          <span class="hero__eyebrow">
            <span class="eyebrow-dot"></span>
            Strova Group &bull; Creative Technology &amp; Engineering
          </span>
          <span class="hero__status-badge">
            IDEAS / TECHNOLOGY / GROWTH
          </span>
        </div>

        <!-- Dramatic Framing Headline with Official Brand Sheet Headline -->
        <div class="hero__centerpiece">
          <h1 id="hero-title" class="hero__title">
            <span class="hero__title-split hero__title-left">BUILDING TECHNOLOGY</span>
            <span class="hero__title-split hero__title-right">FOR A BIGGER TOMORROW</span>
          </h1>
        </div>

        <!-- Bottom Flanking Intelligence & Action Modules -->
        <div class="hero__bottom-flank">
          <div class="hero__flank-card hero__flank-card--left">
            <span class="flank-card__kicker">IDEAS / TECHNOLOGY / GROWTH</span>
            <p class="flank-card__lead">
              We create digital solutions, products and experiences that help businesses grow, scale and lead in a changing world.
            </p>
          </div>

          <div class="hero__flank-card hero__flank-card--right">
            <div class="hero__actions">
              <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
                Discuss Your Project &rarr;
              </a>
              <a href="#showcase" class="btn btn--outline btn--lg">
                Explore Showcase
              </a>
            </div>
            <p class="hero__note">
              Direct founder review &bull; Itemised quote in 1 business day
            </p>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="hero__scroll-wrap">
          <a href="#manifesto" class="hero__scroll-indicator" aria-label="Scroll to explore our capabilities">
            <span class="scroll-indicator__track">
              <span class="scroll-indicator__dot"></span>
            </span>
            <span class="scroll-indicator__label">Scroll to explore</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4) -->
    <section class="section manifesto-section" id="manifesto" aria-label="Our Core Purpose">
      <div class="container manifesto__inner">
        <div class="manifesto__eyebrow">
          <span class="manifesto__spark">✦</span>
          <span>CREATIVE TECHNOLOGY AT SCALE</span>
        </div>

        <p class="manifesto__statement">
          Strova Group is a creative technology and engineering studio at the intersection of modern software, AI automation, and digital commerce. We design digital experiences and resilient systems that captivate, scale, and transform enterprise operations.
        </p>

        <!-- Interactive Pill Controls (Video 1 & 2 Luxury Pill Badges) -->
        <div class="manifesto__pills" role="list">
          <a href="/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>Bespoke Engineering</span>
          </a>
          <a href="/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>AI &amp; Workflows</span>
          </a>
          <a href="/digital/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>Growth &amp; SEO</span>
          </a>
        </div>

        <!-- Cinematic Metric Strip (+ 78 style from Reference 1) -->
        <div class="manifesto__stats">
          <div class="stat-card">
            <span class="stat-number">100%</span>
            <span class="stat-label">Source code ownership &amp; IP transfer</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-card">
            <span class="stat-number">1 Day</span>
            <span class="stat-label">Written fixed-scope quote turnaround</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-card">
            <span class="stat-number">0 Lock-in</span>
            <span class="stat-label">Independent cloud deployment freedom</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Verifiable Credentials -->
  <CredentialsStrip />

  <!-- Official Engineering & Product Showcase -->
  <section class="section showcase-section" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-header showcase__header">
        <div class="showcase__badge">
          <span class="badge-dot"></span>
          <span>IDEAS / TECHNOLOGY / GROWTH</span>
        </div>
        <h2 id="showcase-heading" class="section-title">
          Building Technology for a Bigger Tomorrow
        </h2>
        <p class="section-subtitle text-secondary">
          We create digital solutions, products and experiences that help businesses grow, scale and lead in a changing world.
        </p>
      </div>

      <div class="showcase__grid">
        <!-- Showcase Card 1: Core Platform Engineering -->
        <article class="showcase-card showcase-card--featured">
          <div class="showcase-card__visual">
            <picture>
              <source srcset="/images/brand/card-mockup.webp" type="image/webp" />
              <img
                src="/images/brand/card-mockup.png"
                alt="Strova Group Digital Platform Card Architecture"
                class="showcase-card__img"
                loading="lazy"
                decoding="async"
                width="690"
                height="540"
              />
            </picture>
            <div class="showcase-card__overlay"></div>
          </div>
          <div class="showcase-card__content">
            <span class="showcase-card__tag">Platform Architecture</span>
            <h3 class="showcase-card__title">Enterprise Web &amp; Systems</h3>
            <p class="showcase-card__desc text-secondary">
              High-availability web platforms with microsecond database querying, transactional integrity, and complete client data isolation.
            </p>
            <a href="/technologies/" class="showcase-card__link">
              Explore Technologies &rarr;
            </a>
          </div>
        </article>

        <!-- Showcase Card 2: Mobile & Cloud Solutions -->
        <article class="showcase-card">
          <div class="showcase-card__visual">
            <picture>
              <source srcset="/images/brand/mobile-mockup.webp" type="image/webp" />
              <img
                src="/images/brand/mobile-mockup.png"
                alt="Strova Group Mobile Application & Cloud Experience"
                class="showcase-card__img"
                loading="lazy"
                decoding="async"
                width="560"
                height="540"
              />
            </picture>
            <div class="showcase-card__overlay"></div>
          </div>
          <div class="showcase-card__content">
            <span class="showcase-card__tag">Mobile &amp; Cloud</span>
            <h3 class="showcase-card__title">Native Mobile Engineering</h3>
            <p class="showcase-card__desc text-secondary">
              Responsive client applications, offline-first architectures, and enterprise mobility engineered with strict adherence to security and performance.
            </p>
            <a href="/technologies/" class="showcase-card__link">
              View Mobile Capabilities &rarr;
            </a>
          </div>
        </article>

        <!-- Showcase Card 3: Interactive Visuals & Brand Fluidity -->
        <article class="showcase-card">
          <div class="showcase-card__visual">
            <picture>
              <source srcset="/images/brand/hero-purple-waves.webp" type="image/webp" />
              <img
                src="/images/brand/hero-purple-waves.png"
                alt="Strova Group Luminous Purple Fluid Visual"
                class="showcase-card__img"
                loading="lazy"
                decoding="async"
                width="856"
                height="1020"
              />
            </picture>
            <div class="showcase-card__overlay"></div>
          </div>
          <div class="showcase-card__content">
            <span class="showcase-card__tag">Digital Experience</span>
            <h3 class="showcase-card__title">Fluid 3D &amp; Motion Design</h3>
            <p class="showcase-card__desc text-secondary">
              Award-worthy digital craft with 60 FPS GPU-accelerated interaction, bespoke typography, and unforgettable brand touchpoints.
            </p>
            <a href="/digital/" class="showcase-card__link">
              Discover Digital Growth &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Service Areas -->
  <section class="section" id="capabilities" aria-labelledby="capabilities-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="capabilities-heading" class="section-title">What we build</h2>
        <p class="section-subtitle text-secondary">
          We build for owners who measure twice before they invest.
          Three areas, one standard of engineering.
        </p>
      </div>

      <div class="services">
        <article class="service">
          <span class="service__number">01</span>
          <h3 class="service__title">Custom Software</h3>
          <p class="service__desc text-secondary">
            High-speed web platforms, native Android applications, and custom
            cloud software — built to your specifications, owned entirely by you.
          </p>
          <a href="/technologies/" class="service__link">
            Strova Technologies &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">02</span>
          <h3 class="service__title">AI &amp; Automation</h3>
          <p class="service__desc text-secondary">
            Official WhatsApp Business automations, CRM integrations, and
            workflow orchestration that eliminate repetitive manual tasks.
          </p>
          <a href="/technologies/" class="service__link">
            Explore automation &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">03</span>
          <h3 class="service__title">Digital Growth</h3>
          <p class="service__desc text-secondary">
            Technical SEO, search performance campaigns, and structured
            inbound funnels — measured by inquiries, not vanity impressions.
          </p>
          <a href="/digital/" class="service__link">
            Strova Digital &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Approach -->
  <section class="section approach" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="approach-heading" class="section-title">Our approach</h2>
        <p class="section-subtitle text-secondary">
          Every engagement follows the same disciplined sequence.
          No shortcuts, no ambiguity.
        </p>
      </div>

      <ol class="steps">
        <li class="step">
          <span class="step__number">01</span>
          <h3 class="step__title">Discover</h3>
          <p class="step__desc text-secondary">
            You describe your project. We listen, ask questions, and
            understand the problem before proposing anything.
          </p>
        </li>
        <li class="step">
          <span class="step__number">02</span>
          <h3 class="step__title">Define</h3>
          <p class="step__desc text-secondary">
            Within one business day we return a written, itemised scope
            with deliverables, milestones, and a fixed price.
          </p>
        </li>
        <li class="step">
          <span class="step__number">03</span>
          <h3 class="step__title">Build</h3>
          <p class="step__desc text-secondary">
            Development begins after sign-off and the 50 % advance.
            You receive staging demos after each sprint.
          </p>
        </li>
        <li class="step">
          <span class="step__number">04</span>
          <h3 class="step__title">Verify</h3>
          <p class="step__desc text-secondary">
            Joint review on staging. You test every feature against the
            signed specification before the balance is due.
          </p>
        </li>
        <li class="step">
          <span class="step__number">05</span>
          <h3 class="step__title">Support</h3>
          <p class="step__desc text-secondary">
            Full handover of source code, repositories, and documentation.
            100 % ownership transfers to your organisation.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 5. How We Work -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="how-heading" class="section-title">How we work</h2>
        <p class="section-subtitle text-secondary">
          One source of truth, one team, one standard.
          Clear commercial terms that protect your timeline, budget, and IP.
        </p>
      </div>

      <div class="principles">
        <div class="principle">
          <h3 class="principle__title">Written fixed scope</h3>
          <p class="text-secondary text-sm">
            Every deliverable, API connection, and layout is documented before
            work begins. You never pay unexpected fees or hidden change orders.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">50 % advance structure</h3>
          <p class="text-secondary text-sm">
            A deposit reserves scheduled engineering sprints. The balance is
            due only upon staging approval — before production handover.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">Complete code ownership</h3>
          <p class="text-secondary text-sm">
            Upon final settlement you receive full intellectual property and
            repository rights. Zero proprietary platform lock-in.
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">Global remote delivery</h3>
          <p class="text-secondary text-sm">
            Direct collaboration for Indian and international enterprises.
            Daily async progress, staging demos, and invoicing in INR or USD.
          </p>
        </div>
      </div>

      <div class="principles__cta">
        <a href="/contact/" class="btn btn--primary" data-track="quote_click">
          Request your project quote &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Founder Accountability -->
  <section class="section founder" aria-labelledby="founder-heading">
    <div class="container">
      <div class="founder__inner">
        <h2 id="founder-heading" class="section-title">Direct founder accountability</h2>
        <p class="text-secondary founder__text">
          Strova Group was founded by Sarthak Shresht, with legal proprietorship
          registered under Babita Kumari (Udyam: UDYAM-JH-20-0147452). When you
          partner with Strova Group, your project is not handed off to an account
          executive or an anonymous outsourcing layer. We maintain direct,
          hands-on architectural oversight on every engagement.
        </p>
        <div class="founder__meta">
          <span class="founder__name">Sarthak Shresht</span>
          <span class="founder__role text-muted">Founder · Strova Group</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="faq-heading" class="section-title">Frequently asked questions</h2>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item" id={`faq-${index}`}>
            <summary class="faq-question">
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="faq-answer text-secondary">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section class="section cta" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta__inner">
        <h2 id="cta-heading" class="cta__title">
          Tell us what you want to build.
        </h2>
        <p class="cta__desc text-secondary">
          No lengthy RFP needed. Share your goal, your audience, and a rough
          timeline. We reply with a clear, written quote within one business day.
        </p>
        <div class="cta__actions">
          <a href="/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
            Discuss a project
          </a>
          <a href="mailto:info@strovagroups.in" class="btn btn--outline btn--lg">
            Email info@strovagroups.in
          </a>
          <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
            WhatsApp (+91 92880 77802)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HOMEPAGE CINEMATIC EDITORIAL DESIGN SYSTEM
     ============================================================ */

  /* ---------- Cinematic Stage & Sticky Backdrop ---------- */
  .cinematic-wrapper {
    position: relative;
    width: 100%;
    background: var(--bg-page);
  }

  .cinematic-backdrop {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  @supports (height: 100svh) {
    .cinematic-backdrop {
      margin-bottom: -100svh;
    }
  }

  /* ---------- Hero Viewport Section ---------- */
  .hero {
    position: relative;
    z-index: 2;
    min-height: calc(100vh - 4.25rem);
    min-height: calc(100svh - 4.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    width: 100%;
    min-height: calc(100vh - 8rem);
    min-height: calc(100svh - 8rem);
  }

  /* Top Flank (Status & Eyebrow) */
  .hero__top-flank {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: var(--space-4);
    padding-top: var(--space-2);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #A78BFA;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #A78BFA;
    box-shadow: 0 0 10px #A78BFA;
    animation: dotPulse 2.4s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 0.7; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); box-shadow: 0 0 14px #A78BFA; }
  }

  .hero__status-badge {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
  }

  /* Centerpiece Headline (Cinematic Framing around 3D core) */
  .hero__centerpiece {
    margin-block: auto;
    width: 100%;
    padding-block: var(--space-6);
    pointer-events: none;
  }

  .hero__title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6.2vw, 5.8rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: 0.035em;
    color: #FFFFFF;
    text-shadow: 0 8px 32px rgba(0, 0, 0, 0.85);
  }

  .hero__title-split {
    display: inline-block;
    pointer-events: auto;
  }

  .hero__title-left {
    text-align: left;
  }

  .hero__title-right {
    text-align: right;
  }

  /* Bottom Flanking Modules */
  .hero__bottom-flank {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }

  .hero__flank-card--left {
    max-width: 26rem;
    background: rgba(10, 10, 18, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-left: 2px solid #8B5CF6;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.8);
  }

  .flank-card__kicker {
    display: block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
