<script>
  // Orchestrated GSAP & ScrollTrigger Animations synchronized with Lenis Smooth Scroll
  async function initGsapAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    try {
      const { gsap } = await import('gsap');
      const { ScrollTrigger } = await import('gsap/ScrollTrigger');
      gsap.registerPlugin(ScrollTrigger);

      // 1. Synchronize Lenis Smooth Scroll with GSAP ScrollTrigger
      let retries = 0;
      const connectLenisWithGsap = () => {
        const lenis = (window as any).__lenis;
        if (lenis) {
          (window as any).__lenisDrivenByGsap = true;
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((time: number) => {
            lenis.raf(time * 1000);
          });
          gsap.ticker.lagSmoothing(0);
          ScrollTrigger.refresh();
        } else if (retries < 25) {
          retries++;
          setTimeout(connectLenisWithGsap, 40);
        }
      };
      connectLenisWithGsap();

      // 2. Orchestrated Hero Entrance Reveal
      const revealItems = document.querySelectorAll('.reveal-item');
      if (revealItems.length > 0) {
        gsap.fromTo(
          revealItems,
          { y: 32, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.9,
            stagger: 0.12,
            ease: 'power3.out',
            clearProps: 'transform,opacity',
          }
        );
      }

      // Responsive GSAP animations via gsap.matchMedia()
      const mm = gsap.matchMedia();

      // Desktop only animations (min-width: 56rem)
      mm.add('(min-width: 56rem)', () => {
        // 4. Subtle Parallax on Division Cards (staggered across 3 columns)
        const parallaxCards = document.querySelectorAll('.parallax-card');
        parallaxCards.forEach((card, i) => {
          gsap.fromTo(
            card,
            { y: i % 2 === 0 ? 20 : -20 },
            {
              y: i % 2 === 0 ? -20 : 20,
              ease: 'none',
              scrollTrigger: {
                trigger: card,
                start: 'top bottom',
                end: 'bottom top',
                scrub: 1.4,
              },
            }
          );
        });

        // 5. Pinned "How We Work" Process Sequence on Desktop
        const track = document.getElementById('process-steps-track');
        const container = document.getElementById('process-pinned-container');
        const progressBar = document.getElementById('process-progress-bar');

        if (track && container) {
          const cards = track.querySelectorAll('.process-card');
          const calculateDistance = () => Math.max(0, track.scrollWidth - container.clientWidth);

          const tween = gsap.to(track, {
            x: () => -calculateDistance(),
            ease: 'none',
            scrollTrigger: {
              trigger: container,
              start: 'top 18%',
              end: () => `+=${calculateDistance() + 450}`,
              pin: true,
              scrub: 1.2,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              onUpdate: (self) => {
                if (progressBar) {
                  progressBar.style.width = `${Math.min(100, Math.max(25, self.progress * 100))}%`;
                }
                const activeIndex = Math.min(cards.length - 1, Math.floor(self.progress * cards.length));
                cards.forEach((card, idx) => {
                  if (idx === activeIndex) {
                    card.classList.add('is-active-step');
                  } else {
                    card.classList.remove('is-active-step');
                  }
                });
              },
            },
          });

          return () => {
            tween.kill();
          };
        }
      });

      // Refresh ScrollTrigger after initial paint and fonts settling
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 200);
    } catch (err) {
      console.warn('GSAP scroll animations failed to initialize:', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGsapAnimations);
  } else {
    initGsapAnimations();
  }
</script>
