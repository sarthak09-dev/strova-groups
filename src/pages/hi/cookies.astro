---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'कुकी नीति',
      item: 'https://strovagroups.in/hi/cookies/',
    },
  ],
};
---

<BaseLayout
  title="कुकी नीति (Cookie Policy) — Strova Group"
  description="स्ट्रोवा ग्रुप की कुकी नीति — मार्केटिंग साइट पर शून्य ट्रैकिंग कुकीज़; केवल क्लाइंट पोर्टल पर आवश्यक प्रमाणीकरण कुकीज़।"
  jsonLd={[breadcrumbJsonLd]}
  lang="hi"
>
  <section class="section">
    <div class="container prose">
      <span class="section-eyebrow">डेटा एवं गोपनीयता</span>
      <h1>कुकी नीति (Cookie Policy)</h1>
      <p class="text-sm text-muted">अंतिम अद्यतन: 13 अक्टूबर 2026</p>

      <p>
        <strong>स्ट्रोवा ग्रुप (Strova Group)</strong> गोपनीयता-प्रथम डिज़ाइन और पूर्ण पारदर्शिता में विश्वास करता है। यह कुकी नीति बताती है कि हमारी मार्केटिंग वेबसाइट (<a href="https://strovagroups.in/hi/">https://strovagroups.in</a>) और क्लाइंट पोर्टल (<a href="https://portal.strovagroups.in">https://portal.strovagroups.in</a>) पर कुकीज़ और ब्राउज़र स्टोरेज का उपयोग कैसे किया जाता है।
      </p>

      <h2>1. सार्वजनिक वेबसाइट (शून्य ट्रैकिंग कुकीज़)</h2>
      <p>
        हमारी सार्वजनिक वेबसाइट (<code>strovagroups.in</code>) पर, हम <strong>कोई भी ट्रैकिंग कुकीज़, तीसरे पक्ष के विज्ञापन कुकीज़, या व्यवहार संबंधी प्रोफाइलिंग कुकीज़ सेट नहीं करते हैं</strong>।
      </p>
      <p>
        हम गोपनीयता-अनुकूल, कुकी-रहित एनालिटिक्स का उपयोग करते हैं जो आपके डिवाइस पर लगातार पहचानकर्ता संग्रहीत नहीं करते हैं और विभिन्न वेबसाइटों पर आपको ट्रैक नहीं करते हैं। हम ब्राउज़र के <code>Do Not Track</code> (DNT) अनुरोध का भी सम्मान करते हैं।
      </p>

      <h2>2. क्लाइंट पोर्टल (केवल आवश्यक सुरक्षा कुकीज़)</h2>
      <p>
        हमारे क्लाइंट पोर्टल (<code>portal.strovagroups.in</code>) पर, कुकीज़ का उपयोग विशेष रूप से प्रमाणीकरण और सत्र सुरक्षा के लिए किया जाता है:
      </p>
      <ul>
        <li><strong>सत्र प्रमाणीकरण कुकी:</strong> वन-टाइम पासकोड (ओटीपी) सत्यापन पर सेट किया गया एक एन्क्रिप्टेड प्रमाणीकरण टोकन। विशेषताएं: <code>HttpOnly</code> (जावास्क्रिप्ट के लिए अगम्य), <code>Secure</code> (केवल HTTPS पर प्रेषित), और <code>SameSite=Lax</code> (सीएसआरएफ सुरक्षा)।</li>
        <li><strong>सुरक्षा एवं बॉट सत्यापन:</strong> क्रेडेंशियल हमलों से सुरक्षा के लिए प्रमाणीकरण के दौरान क्लाउडफ्लेयर टर्नस्टाइल (Turnstile) सुरक्षा टोकन।</li>
      </ul>
      <p>
        ये कुकीज़ पोर्टल के तकनीकी संचालन के लिए अत्यंत आवश्यक के रूप में वर्गीकृत हैं और डेटा सुरक्षा कानूनों के तहत विपणन सहमति की आवश्यकता नहीं रखती हैं।
      </p>

      <h2>3. लोकल स्टोरेज एवं ब्राउज़र कैश</h2>
      <p>
        हमारी वेबसाइट एक स्थायी, लाइट कॉर्पोरेट डिज़ाइन सिस्टम पर काम करती है और <code>localStorage</code> में ट्रैकिंग प्राथमिकताएं या व्यवहार प्रोफ़ाइल नहीं लिखती है। कैश्ड संपत्तियां इष्टतम गति के लिए आपके ब्राउज़र द्वारा संग्रहीत मानक स्थिर फ़ाइलों (फ़ॉन्ट और स्क्रिप्ट) तक सीमित हैं।
      </p>

      <h2>4. अपने गोपनीयता विकल्पों का प्रबंधन</h2>
      <p id="privacy-choices">
        आप सीधे अपनी ब्राउज़र सेटिंग्स के माध्यम से कुकीज़ और स्थानीय संग्रहण को नियंत्रित या हटा सकते हैं:
      </p>
      <ul>
        <li>आप अपनी ब्राउज़र सेटिंग्स के माध्यम से किसी भी समय अपने ब्राउज़र कैश और स्टोरेज को साफ़ कर सकते हैं।</li>
        <li>आप तीसरे पक्ष की कुकीज़ को ब्लॉक करने के लिए अपने ब्राउज़र को कॉन्फ़िगर कर सकते हैं।</li>
        <li>क्लाइंट पोर्टल से लॉग आउट करने पर सक्रिय प्रमाणीकरण सत्र तुरंत समाप्त हो जाता है और कुकी हटा दी जाती है।</li>
      </ul>

      <h2>5. पूछताछ एवं डेटा अधिकार</h2>
      <p>
        यदि आपके पास हमारी कुकी नीति के बारे में प्रश्न हैं या आप भारत के DPDP Act 2023 के तहत अपने डेटा अधिकारों का प्रयोग करना चाहते हैं, तो कृपया हमारे डेटा शिकायत डेस्क से संपर्क करें:
      </p>
      <ul>
        <li><strong>ईमेल:</strong> <a href="mailto:info@strovagroups.in">info@strovagroups.in</a></li>
        <li><strong>फोन:</strong> <a href="tel:+919288077802">+91 92880 77802</a></li>
      </ul>

      <p class="text-sm text-muted" style="margin-top: var(--space-8);">
        Strova Group बबिता कुमारी का एकल स्वामित्व प्रतिष्ठान है। पंजीकृत एमएसएमई: UDYAM-JH-20-0147452।
      </p>
    </div>
  </section>
</BaseLayout>

