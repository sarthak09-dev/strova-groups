---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'डिजिटल अभिगम्यता',
      item: 'https://strovagroups.in/hi/accessibility/',
    },
  ],
};
---

<BaseLayout
  title="डिजिटल अभिगम्यता — Strova Group"
  description="स्ट्रोवा ग्रुप की डिजिटल अभिगम्यता नीति और सभी प्लेटफॉर्म्स पर WCAG 2.2 लेवल AA मानकों के अनुपालन की जानकारी।"
  jsonLd={[breadcrumbJsonLd]}
  lang="hi"
>
  <section class="section">
    <div class="container prose">
      <span class="section-eyebrow">अभिगम्यता (Accessibility)</span>
      <h1>डिजिटल अभिगम्यता विवरण</h1>
      <p class="text-sm text-muted">अंतिम अद्यतन: 13 अक्टूबर 2026</p>

      <p>
        <strong>स्ट्रोवा ग्रुप (Strova Group)</strong> दिव्यांग व्यक्तियों के लिए डिजिटल पहुंच सुनिश्चित करने के लिए प्रतिबद्ध है। हम सभी के लिए उपयोगकर्ता अनुभव में निरंतर सुधार करते हैं और अपनी वेबसाइटों, एप्लिकेशन और पोर्टलों पर प्रासंगिक अभिगम्यता मानकों को लागू करते हैं।
      </p>

      <h2>अनुरूपता स्थिति (Conformance Status)</h2>
      <p>
        वेब सामग्री अभिगम्यता दिशानिर्देश (WCAG) दिव्यांगजनों के लिए पहुंच में सुधार हेतु आवश्यकताओं को परिभाषित करता है। यह अनुरूपता के तीन स्तरों को परिभाषित करता है: स्तर A, स्तर AA और स्तर AAA।
      </p>
      <p>
        वेबसाइट को अभिगम्यता को ध्यान में रखकर बनाया गया है और <strong>WCAG 2.2 लेवल AA</strong> को संदर्भ मानते हैं। हर पृष्ठ और इंटरैक्शन का स्वतंत्र ऑडिट अभी पूरा नहीं हुआ है।
      </p>

      <h2>अभिगम्यता उपाय</h2>
      <p>
        वेबसाइट में नीचे दी गई अभिगम्यता सुविधाएं हैं; कुछ पृष्ठों या तृतीय-पक्ष सेवाओं में फिर भी बाधाएं हो सकती हैं:
      </p>
      <ul>
        <li><strong>सिमेंटिक HTML5:</strong> स्क्रीन पाठकों का समर्थन करने के लिए मूल लैंडमार्क (<code>header</code>, <code>nav</code>, <code>main</code>, <code>footer</code>, <code>section</code>) का उपयोग।</li>
        <li><strong>कीबोर्ड नेविगेशन:</strong> नेविगेशन ड्रॉपडाउन, मेनू और फॉर्म सहित सभी इंटरैक्टिव तत्व केवल कीबोर्ड का उपयोग करके पूरी तरह से संचालित करने योग्य हैं।</li>
        <li><strong>दृश्यमान फोकस संकेतक:</strong> उच्च-विपरीत फोकस रिंग्स सुनिश्चित करती हैं कि कीबोर्ड उपयोगकर्ता सक्रिय तत्व की पहचान आसानी से कर सकें।</li>
        <li><strong>स्किप-टू-कंटेंट लिंक:</strong> प्रत्येक पृष्ठ के शीर्ष पर एक समर्पित स्किप नेविगेशन लिंक कीबोर्ड उपयोगकर्ताओं को सीधे मुख्य सामग्री पर जाने की अनुमति देता है।</li>
        <li><strong>रंग कंट्रास्ट:</strong> मुख्य टेक्स्ट क्रीम या वार्म-व्हाइट सतहों पर चारकोल में है; एक्सेंट टेक्स्ट और कंट्रोल के लिए बरगंडी उपयोग होता है।</li>
        <li><strong>रिस्पॉन्सिव लेआउट:</strong> लेआउट संकरी स्क्रीन के अनुसार बदलते हैं। टेक्स्ट कटने या क्षैतिज स्क्रॉलिंग दिखने पर कृपया पृष्ठ और डिवाइस की चौड़ाई बताएं।</li>
        <li><strong>मोशन प्राथमिकताएं:</strong> वेबसाइट ऑपरेटिंग सिस्टम की <code>prefers-reduced-motion</code> सेटिंग का सम्मान करती है।</li>
      </ul>

      <h2>प्रतिक्रिया एवं संपर्क जानकारी</h2>
      <p>
        हम स्ट्रोवा ग्रुप वेबसाइट की अभिगम्यता पर आपकी प्रतिक्रिया का स्वागत करते हैं। यदि आपको कोई बाधा आती है, तो कृपया हमसे संपर्क करें:
      </p>
      <ul>
        <li><strong>ईमेल:</strong> <a href="mailto:info@strovagroups.in">info@strovagroups.in</a></li>
        <li><strong>फोन एवं व्हाट्सएप:</strong> <a href="tel:+919288077802">+91 92880 77802</a></li>
        <li><strong>प्रतिक्रिया एसएलए:</strong> हम 2 कार्यदिवसों के भीतर अभिगम्यता रिपोर्टों को स्वीकार और हल करने का लक्ष्य रखते हैं।</li>
      </ul>

      <p class="text-sm text-muted" style="margin-top: var(--space-8);">
        Strova Group बबिता कुमारी का एकल स्वामित्व प्रतिष्ठान है। पंजीकृत एमएसएमई: UDYAM-JH-20-0147452।
      </p>
    </div>
  </section>
</BaseLayout>

