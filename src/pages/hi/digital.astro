---
/**
 * डिजिटल डिवीजन पृष्ठ (src/pages/hi/digital.astro)
 * 
 * डिवीजन: स्ट्रोवा डिजिटल (Strova Digital)
 * मुख्य कार्य: तकनीकी एसईओ, परफॉर्मेंस विज्ञापन, लीड जनरेशन फनल्स, रूपांतरण दर अनुकूलन (CRO)।
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'स्ट्रोवा डिजिटल — परफॉर्मेंस मार्केटिंग एवं एसईओ',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'डिजिटल मार्केटिंग और सर्च इंजन ऑप्टिमाइज़ेशन',
  areaServed: ['IN', 'US', 'GB', 'AE', 'EU'],
  description:
    'तकनीकी एसईओ, उच्च-इरादा गूगल एवं मेटा परफॉर्मेंस विज्ञापन, सर्वर-साइड रूपांतरण ट्रैकिंग और स्वचालित लीड जनरेशन फनल्स।',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'डिजिटल विकास',
      item: 'https://strovagroups.in/hi/digital/',
    },
  ],
};
---

<BaseLayout
  title="स्ट्रोवा डिजिटल — एसईओ एवं डिजिटल विकास | Strova Group"
  description="डेटा-आधारित सर्च इंजन ऑप्टिमाइज़ेशन (SEO), गूगल एवं मेटा विज्ञापन और ठोस व्यावसायिक परिणामों के लिए निर्मित कन्वर्जन फनल्स।"
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
  lang="hi"
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">स्ट्रोवा डिजिटल</span>
        <h1 class="page-hero__title">
          डेटा-संचालित विकास, तकनीकी एसईओ एवं उच्च-इरादा इनबाउंड पाइपलाइन्स
        </h1>
        <p class="page-hero__lead">
          हम डिजिटल मार्केटिंग को एक इंजीनियरिंग अनुशासन के रूप में देखते हैं। हम प्रोग्रामेटिक खोज अनुकूलन, सर्वर-साइड एट्रिब्यूशन और शुद्ध राजस्व पर केंद्रित परफॉर्मेंस विज्ञापनों द्वारा विश्वसनीय ग्राहक अधिग्रहण प्रणाली बनाते हैं।
        </p>
        <div class="page-hero__actions">
          <a href="/hi/contact/?service=digital" class="btn btn--primary btn--lg">
            ग्रोथ ऑडिट का अनुरोध करें
          </a>
          <a href="#services" class="btn btn--outline btn--lg">
            क्षमताएं देखें &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">सेवा का विवरण</span>
            <p class="overview-item__val">तकनीकी एसईओ सुधार, सशुल्क परफॉर्मेंस मीडिया (गूगल एवं मेटा विज्ञापन), प्रोग्रामेटिक लैंडिंग पेज और स्वचालित लीड कैप्चर फनल्स।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">किसके लिए उपयुक्त</span>
            <p class="overview-item__val">व्यावसायिक उद्यम, भारत में पेशेवर क्लीनिक और वैश्विक ब्रांड जो अनुमानित आरओएएस (ROAS) और सत्यापित ग्राहक अधिग्रहण चाहते हैं।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">कोटेशन प्रक्रिया</span>
            <p class="overview-item__val">1 कार्यदिवस में विस्तृत लिखित प्रस्ताव। कार्य स्पष्ट स्कोप सहमति और 50% अग्रिम के बाद शुरू होता है।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">अनुमानित समयसीमा</span>
            <p class="overview-item__val">प्रारंभिक ऑडिट और CAPI ट्रैकिंग के लिए 2-4 सप्ताह &bull; कीवर्ड रैंकिंग वृद्धि के लिए 8-12 सप्ताह &bull; द्विसाप्ताहिक स्प्रिंट पुनरावृत्ति।</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section" id="services" aria-labelledby="digital-services-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-services-title" class="section-title">मापने योग्य विकास प्रणालियां</h2>
        <p class="section-subtitle">
          कोई व्यर्थ मेट्रिक्स या नकली फॉलोअर्स नहीं। प्रत्येक अभियान सीधे सत्यापित राजस्व पाइपलाइन से जुड़ा होता है।
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Technical & Programmatic SEO -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3 class="capability-title">तकनीकी एवं प्रोग्रामेटिक एसईओ</h3>
          <p class="capability-text">
            सर्च इंजन गति और संरचना को पुरस्कृत करते हैं। हम इंडेक्सेशन संरचना का ऑडिट करते हैं, कोर वेब वाइटल्स बाधाओं (INP, LCP, CLS) को दूर करते हैं, समृद्ध JSON-LD स्कीमा लागू करते हैं और वाणिज्यिक खोज इरादे को लक्षित करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>कोर वेब वाइटल्स:</strong> 2.5 सेकंड से कम LCP और शून्य लेआउट शिफ्ट</li>
            <li><strong>स्ट्रक्चर्ड डेटा:</strong> रिच स्निपेट्स के लिए पूर्ण Schema.org ग्राफ</li>
            <li><strong>क्रॉल दक्षता:</strong> XML साइटमैप, कैनोनिकल टैग और आंतरिक लिंक ट्री</li>
            <li><strong>सामग्री संरचना:</strong> टॉपिकल क्लस्टर मैप्स एवं वाणिज्यिक खोज विश्लेषण</li>
          </ul>
        </article>

        <!-- 2. Performance Advertising -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="capability-title">सशुल्क मीडिया एवं आरओएएस अनुकूलन</h3>
          <p class="capability-text">
            सख्त विज्ञापन व्यय रिटर्न (ROAS) लक्ष्यों पर निर्मित उच्च-इरादा गूगल खोज और मेटा (इंस्टाग्राम/फेसबुक) अभियान। हम ब्राउज़र विज्ञापन अवरोधक नुकसान को रोकने के लिए सर्वर-साइड ट्रैकिंग (Meta CAPI) लागू करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>चैनल्स:</strong> Google Search, Performance Max, Meta Ads, LinkedIn</li>
            <li><strong>ट्रैकिंग:</strong> सर्वर-साइड Conversions API (CAPI) एवं GA4 रूटिंग</li>
            <li><strong>एट्रिब्यूशन:</strong> फर्स्ट-पार्टी UTM पैरामीटर और CRM राजस्व मिलान</li>
            <li><strong>परीक्षण:</strong> व्यवस्थित शीर्षक, रचनात्मक दृष्टिकोण और दर्शक विभाजन</li>
          </ul>
        </article>

        <!-- 3. Lead Generation Funnels -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="capability-title">इनबाउंड लीड जनरेशन फनल्स</h3>
          <p class="capability-text">
            बिना रूपांतरण के ट्रैफ़िक केवल लागत है। हम समर्पित, घर्षण-रहित लैंडिंग पेज और इंटरैक्टिव कोटेशन टूल डिज़ाइन करते हैं जो त्वरित फॉर्म भरने, सत्यापित फोन नंबर और आपकी टीम को त्वरित व्हाट्सएप अधिसूचना सुनिश्चित करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>लैंडिंग पेज:</strong> शून्य विचलित करने वाले नेविगेशन के साथ सब-सेकंड लोड गति</li>
            <li><strong>फॉर्म संरचना:</strong> प्रगतिशील प्रकटीकरण और मोबाइल सत्यापन</li>
            <li><strong>सीआरएम रूटिंग:</strong> HubSpot, Zoho या Sheets में त्वरित वेबहुक सिंक</li>
            <li><strong>स्पैम फ़िल्टर:</strong> हनीपॉट फ़ील्ड और एल्गोरिद्मिक बॉट सुरक्षा</li>
          </ul>
        </article>

        <!-- 4. Conversion Rate Optimization (CRO) -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="capability-title">रूपांतरण दर अनुकूलन (CRO)</h3>
          <p class="capability-text">
            हम क्लिक डेटा को राजस्व वृद्धि में बदलते हैं। उपयोगकर्ता सत्र ऑडिटिंग, फॉर्म परित्याग विश्लेषण और स्वच्छ ए/बी स्प्लिट परीक्षणों के माध्यम से, हम आपके प्राथमिक वाणिज्यिक मार्गों पर रूपांतरण दरों में निरंतर सुधार करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>ऑडिट:</strong> स्क्रॉल मैप्स, ड्रॉप-ऑफ हीटमैप्स और फनल ड्रॉप विश्लेषण</li>
            <li><strong>ए/बी परीक्षण:</strong> टेक्स्ट और लेआउट का सांख्यिकीय परिकल्पना परीक्षण</li>
            <li><strong>गोपनीयता-प्रथम:</strong> DPDP और GDPR अनुरूप कुकी-रहित एनालिटिक्स</li>
            <li><strong>रिपोर्टिंग:</strong> प्रति-लीड लागत पर केंद्रित द्विसाप्ताहिक डैशबोर्ड</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Growth Methodology -->
  <section class="section methodology-section" aria-labelledby="methodology-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="methodology-title" class="section-title">तीन चरणीय विकास ढांचा</h2>
        <p class="section-subtitle">
          हम व्यावसायिक ग्राहक अधिग्रहण को व्यवस्थित रूप से कैसे परीक्षण, प्रमाणित और स्केल करते हैं।
        </p>
      </div>

      <div class="methodology-grid">
        <div class="methodology-step">
          <div class="methodology-step__num">01</div>
          <h3 class="methodology-step__title">इन्फ्रास्ट्रक्चर एवं आधारभूत ऑडिट</h3>
          <p class="methodology-step__text">
            हम पिक्सेल स्वास्थ्य की जांच करते हैं, सर्वर-साइड CAPI वितरण सत्यापित करते हैं, ऐतिहासिक खोज प्रदर्शन का ऑडिट करते हैं और उच्च खरीदारी इरादे वाली खोजों को मैप करते हैं।
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">02</div>
          <h3 class="methodology-step__title">त्वरित रचनात्मक सत्यापन</h3>
          <p class="methodology-step__text">
            हम नियंत्रित बजट के साथ लक्षित विज्ञापन प्रयोग शुरू करते हैं और बुनियादी तकनीकी एसईओ सुधार लागू करते हैं। हम ठोस अधिग्रहण लागत (CPA) बेंचमार्क स्थापित करते हैं।
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">03</div>
          <h3 class="methodology-step__title">चैनल स्केलिंग एवं एट्रिब्यूशन</h3>
          <p class="methodology-step__text">
            हम सफल विज्ञापन कोणों को स्केल करते हैं, प्रोग्रामेटिक लैंडिंग पेज बनाते हैं और स्थिर अधिग्रहण लागत पर मासिक लीड मात्रा बढ़ाने के लिए रूपांतरण मार्गों को अनुकूलित करते हैं।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How Quotes Work for Digital Growth -->
  <section class="section" aria-labelledby="digital-pricing-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-pricing-title" class="section-title">डिजिटल विकास के लिए कोटेशन प्रक्रिया</h2>
        <p class="section-subtitle">
          आपके लक्षित चैनलों, बाजार प्रतिस्पर्धा और लक्ष्यों पर आधारित पारदर्शी प्रस्ताव।
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 1 &bull; तकनीकी ऑडिट</span>
          <h3 class="pillar-title">तकनीकी ऑडिट एवं CAPI</h3>
          <p class="text-secondary text-sm">व्यापक कोर वेब वाइटल्स सुधार, Schema.org ग्राफ और सर्वर-साइड ट्रैकिंग सेटअप।</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 2 &bull; लिखित प्रस्ताव</span>
          <h3 class="pillar-title">लिखित विकास स्कोप</h3>
          <p class="text-secondary text-sm">1 कार्यदिवस में अभियानों, लैंडिंग पेजों और एट्रिब्यूशन का विवरण देने वाला स्पष्ट कोटेशन।</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 3 &bull; पुनरावृत्ति एवं रिपोर्ट</span>
          <h3 class="pillar-title">द्विसाप्ताहिक रिपोर्टिंग</h3>
          <p class="text-secondary text-sm">वास्तविक लीड्स और राजस्व आंकड़ों पर केंद्रित पारदर्शी द्विसाप्ताहिक रिपोर्ट और समीक्षा।</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">विकास रणनीति पर चर्चा के लिए तैयार हैं?</h2>
          <p class="cta-desc">
            अपने वर्तमान ट्रैफ़िक आंकड़े या विकास लक्ष्य साझा करें। हम एक तकनीकी ऑडिट करेंगे और 1 कार्यदिवस के भीतर स्पष्ट प्रस्ताव प्रदान करेंगे।
          </p>
          <div class="cta-buttons">
            <a href="/hi/contact/?service=digital" class="btn btn--primary btn--lg">
              डिजिटल विकास चर्चा शुरू करें
            </a>
            <a href="/hi/case-studies/" class="btn btn--outline btn--lg">
              हमारी कार्यप्रणाली देखें
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
