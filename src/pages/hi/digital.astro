---
/**
 * डिजिटल डिवीजन पृष्ठ (src/pages/hi/digital.astro)
 * 
 * स्ट्रोवा टेक्नोलॉजी के डिजिटल स्तंभ में वेबसाइट, ऐप्लिकेशन, ई-कॉमर्स और प्लेटफ़ॉर्म शामिल हैं।
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'डिजिटल — स्ट्रोवा टेक्नोलॉजी',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'व्यावसायिक वेबसाइट, वेब ऐप्लिकेशन, ई-कॉमर्स और कस्टम डिजिटल प्लेटफ़ॉर्म',
  description:
    'डिजिटल सेवाओं में व्यावसायिक वेबसाइट और लैंडिंग पेज, वेब ऐप्लिकेशन और ग्राहक पोर्टल, ई-कॉमर्स समाधान तथा कस्टम डिजिटल प्लेटफ़ॉर्म शामिल हैं।',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'डिजिटल',
      item: 'https://strovagroups.in/hi/digital/',
    },
  ],
};
---

<BaseLayout
  title="डिजिटल समाधान | स्ट्रोवा टेक्नोलॉजी"
  description="स्ट्रोवा टेक्नोलॉजी से व्यवसाय वेबसाइट, लैंडिंग पेज, वेब ऐप्लिकेशन, ग्राहक पोर्टल, ई-कॉमर्स और कस्टम डिजिटल प्लेटफ़ॉर्म।"
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
  lang="hi"
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">स्ट्रोवा ग्रुप / स्ट्रोवा टेक्नोलॉजी / डिजिटल</span>
        <h1 class="page-hero__title">
          आपके व्यवसाय के लिए उपयोगी डिजिटल अनुभव
        </h1>
        <p class="page-hero__lead">
          स्ट्रोवा टेक्नोलॉजी के Digital pillar में वेबसाइट, ऐप्लिकेशन, ई-कॉमर्स और कस्टम प्लेटफ़ॉर्म शामिल हैं। हर समाधान को उसके उपयोगकर्ताओं और व्यावसायिक जरूरतों के अनुसार तैयार किया जाता है।
        </p>
        <div class="page-hero__actions">
          <a href="/hi/contact/?service=digital" class="btn btn--primary btn--lg">
            डिजिटल परियोजना पर चर्चा करें
          </a>
          <a href="#services" class="btn btn--outline btn--lg">
            क्षमताएं देखें &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">सेवा का विवरण</span>
            <p class="overview-item__val">व्यवसाय वेबसाइट और लैंडिंग पेज, वेब ऐप्लिकेशन और ग्राहक पोर्टल, ई-कॉमर्स समाधान तथा कस्टम डिजिटल प्लेटफ़ॉर्म।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">किसके लिए उपयुक्त</span>
            <p class="overview-item__val">ऐसे संगठन जिन्हें उपयोगी डिजिटल अनुभव या किसी मान्य व्यावसायिक जरूरत के अनुसार प्लेटफ़ॉर्म चाहिए।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">कोटेशन प्रक्रिया</span>
            <p class="overview-item__val">1 कार्यदिवस में विस्तृत लिखित प्रस्ताव। कार्य स्पष्ट स्कोप सहमति और 50% अग्रिम के बाद शुरू होता है।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">अनुमानित समयसीमा</span>
            <p class="overview-item__val">समयसीमा सहमत दायरे, इंटीग्रेशन, सामग्री और समीक्षा प्रक्रिया पर निर्भर करती है। माइलस्टोन प्रस्ताव में दर्ज होते हैं।</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section" id="services" aria-labelledby="digital-services-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-services-title" class="section-title">डिजिटल सेवाएं</h2>
        <p class="section-subtitle">
          केंद्रित लैंडिंग पेज से कस्टम प्लेटफ़ॉर्म तक, काम की शुरुआत व्यवसाय और ग्राहकों की जरूरतों से होती है।
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Business websites and landing pages -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3 class="capability-title">व्यवसाय वेबसाइट एवं लैंडिंग पेज</h3>
          <p class="capability-text">
            स्पष्ट, responsive वेबसाइट और केंद्रित लैंडिंग पेज आपके प्रस्ताव को समझाते हैं, आगंतुकों का मार्गदर्शन करते हैं और अगले कदम को आसान बनाते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>Responsive layout:</strong> डेस्कटॉप, टैबलेट और मोबाइल के लिए डिज़ाइन</li>
            <li><strong>उपयोगी सामग्री:</strong> स्पष्ट सूचना संरचना और कार्रवाई के विकल्प</li>
            <li><strong>Search foundations:</strong> वर्णनात्मक metadata और crawl योग्य पेज संरचना</li>
            <li><strong>सुलभ पैटर्न:</strong> semantic markup और keyboard-friendly controls</li>
          </ul>
        </article>

        <!-- 2. Performance Advertising -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="capability-title">वेब ऐप्लिकेशन एवं ग्राहक पोर्टल</h3>
          <p class="capability-text">
            वेब ऐप्लिकेशन और ग्राहक पोर्टल जानकारी, अनुरोधों और उपयोगी workflows को एक स्पष्ट interface में ला सकते हैं। access और integration का दायरा हर परियोजना के अनुसार तय होता है।
          </p>
          <ul class="capability-features">
            <li><strong>Purpose-built flows:</strong> फ़ॉर्म, डैशबोर्ड और विशिष्ट कार्य के interface</li>
            <li><strong>Account areas:</strong> जरूरत पड़ने पर ग्राहक access और भूमिका-आधारित views</li>
            <li><strong>Integrations:</strong> सहमत data sources और business tools</li>
            <li><strong>Delivery:</strong> scope, access rules और handover पहले से लिखित</li>
          </ul>
        </article>

        <!-- 3. Lead Generation Funnels -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="capability-title">ई-कॉमर्स समाधान</h3>
          <p class="capability-text">
            ई-कॉमर्स अनुभव ग्राहकों को उत्पाद खोजने, विकल्प समझने और व्यवसाय के अनुकूल storefront तथा checkout के माध्यम से खरीदारी पूरी करने में मदद करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>Storefront:</strong> उत्पाद खोज और स्पष्ट उत्पाद जानकारी</li>
            <li><strong>Commerce flows:</strong> जरूरत के अनुसार cart, checkout और order journey</li>
            <li><strong>Integrations:</strong> सहमत payment, inventory और fulfilment सेवाएं</li>
            <li><strong>Responsive design:</strong> अलग-अलग screen size पर सहज अनुभव</li>
          </ul>
        </article>

        <!-- 4. Conversion Rate Optimization (CRO) -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="capability-title">कस्टम डिजिटल प्लेटफ़ॉर्म</h3>
          <p class="capability-text">
            जब तैयार टूल उपयुक्त न हो, कस्टम प्लेटफ़ॉर्म विशिष्ट data, प्रक्रियाओं या सेवाओं को साथ ला सकता है। scope ग्राहक और व्यवसाय की मान्य जरूरतों पर आधारित होता है।
          </p>
          <ul class="capability-features">
            <li><strong>Business logic:</strong> workflow और नियम लिखित scope में</li>
            <li><strong>Data models:</strong> उत्पाद के अनुसार सूचना संरचना</li>
            <li><strong>Connected services:</strong> परियोजना के लिए चुने गए तृतीय-पक्ष integrations</li>
            <li><strong>Future growth:</strong> सहमत अगले चरणों के लिए maintainable आधार</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Digital Project Process -->
  <section class="section methodology-section" aria-labelledby="methodology-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="methodology-title" class="section-title">आवश्यकताओं से डिलीवरी तक</h2>
        <p class="section-subtitle">
          स्पष्ट प्रक्रिया से परियोजना का दायरा, निर्णय और हैंडओवर पूरी अवधि में समझने योग्य रहते हैं।
        </p>
      </div>

      <div class="methodology-grid">
        <div class="methodology-step">
          <div class="methodology-step__num">01</div>
          <h3 class="methodology-step__title">समझें और परिभाषित करें</h3>
          <p class="methodology-step__text">
            समाधान प्रस्तावित करने से पहले हम उपयोगकर्ताओं, आवश्यकताओं, सामग्री, integrations और सीमाओं को स्पष्ट करते हैं।
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">02</div>
          <h3 class="methodology-step__title">योजना बनाएं और तैयार करें</h3>
          <p class="methodology-step__text">
            हम माइलस्टोन और डिलिवरेबल्स पर सहमति बनाते हैं, फिर लिखित दायरे के अनुसार काम बनाते और समीक्षा करते हैं।
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">03</div>
          <h3 class="methodology-step__title">समीक्षा और हैंडओवर</h3>
          <p class="methodology-step__text">
            सहमत डिलिवरेबल्स की समीक्षा के बाद हैंडओवर की जरूरतें पूरी की जाती हैं। किसी भी ongoing support को प्रस्ताव में दर्ज किया जाता है।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Digital Project Scope -->
  <section class="section" aria-labelledby="digital-pricing-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-pricing-title" class="section-title">परियोजना का दायरा और अनुमान</h2>
        <p class="section-subtitle">
          आवश्यकताएं, integrations और सामग्री लागत को प्रभावित करती हैं। लिखित प्रस्ताव सहमत काम, माइलस्टोन और व्यावसायिक शर्तें स्पष्ट करता है।
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 1 &bull; आवश्यकताएं</span>
          <h3 class="pillar-title">काम परिभाषित करें</h3>
          <p class="text-secondary text-sm">उपयोगकर्ता, workflows, सुविधाएं, सामग्री, integrations और सीमाएं स्पष्ट करें।</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 2 &bull; लिखित प्रस्ताव</span>
          <h3 class="pillar-title">लिखित परियोजना प्रस्ताव</h3>
          <p class="text-secondary text-sm">काम शुरू होने से पहले डिलिवरेबल्स, माइलस्टोन, समयसीमा और शर्तें देखें।</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">चरण 3 &bull; डिलीवरी</span>
          <h3 class="pillar-title">समीक्षा और हैंडओवर</h3>
          <p class="text-secondary text-sm">माइलस्टोन की समीक्षा करें और हैंडओवर तथा सहायता की व्यवस्था तय करें।</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">क्या आपके पास डिजिटल परियोजना का विचार है?</h2>
          <p class="cta-desc">
            बताएं कि आप क्या बनाना चाहते हैं। हम आवश्यकताओं, संभावित दायरे और व्यावहारिक अगले कदम पर चर्चा कर सकते हैं।
          </p>
          <div class="cta-buttons">
            <a href="/hi/contact/?service=digital" class="btn btn--primary btn--lg">
              परियोजना पर चर्चा करें
            </a>
            <a href="/hi/case-studies/" class="btn btn--outline btn--lg">
              Strova Technology देखें
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .capability-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .capability-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--accent-subtle);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .capability-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .capability-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .capability-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .capability-features strong {
    color: var(--text-primary);
  }

  /* Methodology */
  .methodology-section {
    background: var(--bg-surface);
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 52rem) {
    .methodology-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .methodology-step {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    position: relative;
  }

  .methodology-step__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--accent);
    margin-bottom: var(--space-4);
    opacity: 0.8;
  }

  .methodology-step__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .methodology-step__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cta-section {
    padding-bottom: var(--space-24);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    color: var(--color-snow);
  }

  .cta-content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
