---

/**
 * Hindi Home Page — Premium Editorial Redesign
 *
 * Composition:
 * 1. Cinematic Hero Stage: Framing editorial typography, 3D crystalline centerpiece, primary + secondary CTA
 * 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4)
 * 3. Credentials strip (verifiable registrations)
 * 4. Service areas: Custom Software, AI & Automation, Digital Growth
 * 5. Approach: Discover → Define → Build → Verify → Support
 * 6. How we work (quotes + agreement merged into editorial section)
 * 7. Founder accountability
 * 8. FAQ with JSON-LD
 * 9. Final CTA
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CredentialsStrip from '../../components/CredentialsStrip.astro';
import { showcaseConcepts } from '../../data/showcase';

const faqs = [
  {
    question: 'प्रोजेक्ट कोटेशन कैसे काम करता है?',
    answer:
      'आप हमारे कोट फॉर्म या ईमेल (info@strovagroups.in) के माध्यम से अपने प्रोजेक्ट का विवरण साझा करते हैं। 1 कार्यदिवस के भीतर हम आपकी तकनीकी आवश्यकताओं की समीक्षा करते हैं और डिलिवरेबल्स, माइलस्टोन और समयसीमा के साथ एक निश्चित मूल्य लिखित कोटेशन प्रदान करते हैं। कोई अप्रत्याशित शुल्क नहीं होता।',
  },
  {
    question: '50% अग्रिम भुगतान संरचना कैसे काम करती है?',
    answer:
      'प्रत्येक प्रोजेक्ट लिखित स्कोप पर दोनों पक्षों के हस्ताक्षर और 50% अग्रिम भुगतान के साथ शुरू होता है। शेष 50% राशि केवल स्टेजिंग डेमो और गुणवत्ता आश्वासन समीक्षा के बाद, प्रोडक्शन हैंडओवर से पहले इनवॉइस की जाती है।',
  },
  {
    question: 'क्या हमें सोर्स कोड और बौद्धिक संपदा का पूर्ण स्वामित्व मिलता है?',
    answer:
      'हां। अंतिम निपटान के बाद, सभी कस्टम कोड, रिपॉजिटरी और डिप्लॉयमेंट कॉन्फ़िगरेशन का 100% स्वामित्व आपके संगठन को हस्तांतरित कर दिया जाता है। कोई वेंडर लॉक-इन नहीं होता।',
  },
  {
    question: 'आप व्हाट्सएप ऑटोमेशन का निर्माण कैसे करते हैं?',
    answer:
      'हम आधिकारिक मेटा व्हाट्सएप क्लाउड एपीआई (Meta WhatsApp Cloud API) और सुरक्षित वेबहुक का उपयोग करते हैं, जो आपके सीआरएम, डेटाबेस या इन्वेंट्री सिस्टम से सीधे जुड़े होते हैं। यह बिना किसी अनधिकृत स्क्रैपर के सुरक्षित और विश्वसनीय संचालन सुनिश्चित करता है।',
  },
  {
    question: 'क्या आप भारत के बाहर अंतरराष्ट्रीय ग्राहकों के साथ काम करते हैं?',
    answer:
      'हां। हम घरेलू व्यवसायों के साथ-साथ उत्तरी अमेरिका, यूरोप और एशिया-प्रशांत के अंतरराष्ट्रीय उद्यमों को सेवाएं प्रदान करते हैं। भारतीय ग्राहकों के लिए INR में और अंतरराष्ट्रीय ग्राहकों के लिए USD में इनवॉइस जारी किए जाते हैं।',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="स्ट्रोवा ग्रुप — डिजिटल, ऑटोमेशन एवं सॉफ़्टवेयर उत्पाद"
  description="स्ट्रोवा टेक्नोलॉजी, स्ट्रोवा ग्रुप के अंतर्गत डिजिटल सेवाओं, व्यवसाय ऑटोमेशन और सॉफ़्टवेयर उत्पादों को एकीकृत करती है।"
  jsonLd={[faqJsonLd]}
  lang="hi"
>
  <!-- Cinematic Hero & Manifesto Stage Wrapper -->
  <div class="cinematic-wrapper" id="cinematic-wrapper">
    <!-- 1. Hero Viewport Stage -->
    <section class="hero" id="hero-stage" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <!-- Top Status Flank -->
        <div class="hero__top-flank">
          <span class="hero__eyebrow">
            <span class="eyebrow-dot"></span>
            स्ट्रोवा ग्रुप &bull; स्ट्रोवा टेक्नोलॉजी
          </span>
          <span class="hero__status-badge">
            डिजिटल / ऑटोमेशन / उत्पाद
          </span>
        </div>

        <!-- Dramatic Framing Headline with Official Brand Sheet Headline -->
        <div class="hero__centerpiece">
          <p class="hero__overline">स्ट्रोवा ग्रुप / स्ट्रोवा टेक्नोलॉजी</p>
          <h1 id="hero-title" class="hero__title">
            <span class="hero__title-split">उपयोगी तकनीक,</span>
            <span class="hero__title-split hero__title-accent">आपके व्यवसाय के लिए।</span>
          </h1>
          <p class="hero__intro">डिजिटल सेवाएं, व्यावहारिक ऑटोमेशन और सॉफ़्टवेयर उत्पाद—एक ही टेक्नोलॉजी व्यवसाय के अंतर्गत।</p>
        </div>
        <div class="hero__art" aria-hidden="true">
          <svg viewBox="0 0 520 520" role="presentation">
            <circle class="hero__orbit hero__orbit--outer" cx="260" cy="260" r="214" />
            <circle class="hero__orbit hero__orbit--middle" cx="260" cy="260" r="166" />
            <path class="hero__mark" d="M325 160c0-24-19-43-43-43h-67c-29 0-52 23-52 52s23 52 52 52h90c29 0 52 23 52 52s-23 52-52 52h-67c-24 0-43-19-43-43" />
            <circle class="hero__point" cx="356" cy="273" r="9" />
          </svg>
          <span>विचार / तकनीक / प्रगति</span>
        </div>

        <!-- Bottom Flanking Intelligence & Action Modules -->
        <div class="hero__bottom-flank">
          <div class="hero__flank-card hero__flank-card--right">
            <div class="hero__actions">
              <a href="/hi/contact/" class="btn btn--primary btn--lg" data-track="quote_click">
                प्रोजेक्ट पर चर्चा करें &rarr;
              </a>
              <a href="#showcase" class="btn btn--outline btn--lg">
                शोकेस देखें
              </a>
            </div>
            <p class="hero__note">
              बताएं कि आपके व्यवसाय को क्या बेहतर करना है।
            </p>
          </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="hero__scroll-wrap">
          <a href="#manifesto" class="hero__scroll-indicator" aria-label="आगे बढ़ें">
            <span class="scroll-indicator__track">
              <span class="scroll-indicator__dot"></span>
            </span>
            <span class="scroll-indicator__label">नीचे स्क्रॉल करें</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Cinematic Scroll Manifesto & Volumetric Nebula Bloom (Reference 1 Frame 4) -->
    <section class="section manifesto-section" id="manifesto" aria-label="हमारा उद्देश्य">
      <div class="container manifesto__inner reveal">
        <div class="manifesto__eyebrow">
          <span class="manifesto__spark">✦</span>
          <span>एक टेक्नोलॉजी व्यवसाय / तीन जुड़े हुए स्तंभ</span>
        </div>

        <p class="manifesto__statement">
          स्ट्रोवा ग्रुप मूल ब्रांड है। स्ट्रोवा टेक्नोलॉजी के अंतर्गत डिजिटल, ऑटोमेशन और उत्पाद तीन जुड़े हुए स्तंभ हैं—अलग-अलग कंपनियां नहीं।
        </p>

        <!-- Interactive Luxury Pill Badges -->
        <div class="manifesto__pills" role="list">
          <a href="/hi/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span>डिजिटल</span>
          </a>
          <a href="/hi/technologies/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>ऑटोमेशन</span>
          </a>
          <a href="/hi/digital/" class="manifesto__pill" role="listitem">
            <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>उत्पाद</span>
          </a>
        </div>

      </div>
    </section>
  </div>

  <!-- Verifiable Credentials -->
  <CredentialsStrip lang="hi" />

  <!-- Official Engineering & Experience Showcase -->
  <section class="section showcase-section" id="showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <div class="section-header showcase__header reveal">
        <div class="showcase__badge">
          <span class="badge-dot"></span>
          <span>स्ट्रोवा ग्रुप / स्ट्रोवा टेक्नोलॉजी</span>
        </div>
        <h2 id="showcase-heading" class="section-title">
          सोच-समझकर डिज़ाइन किए गए डिजिटल अनुभव और सिस्टम
        </h2>
        <p class="section-subtitle text-secondary">
          डिजिटल अनुभव, ऑटोमेशन और सॉफ़्टवेयर उत्पादों की कुछ उदाहरणात्मक अवधारणाएं। ये इंटरफ़ेस उदाहरण हैं, प्रकाशित ग्राहक केस स्टडी नहीं।
        </p>
      </div>

      <div class="showcase__grid reveal">
        {showcaseConcepts.map((concept) => (
          <article class="showcase-card">
            <div class="showcase-card__visual">
              <img
                class="showcase-card__img"
                src={concept.image}
                alt={concept.alt.hi}
                width="1200"
                height="760"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="showcase-card__content">
              <span class="showcase-card__tag">{concept.pillar.hi}</span>
              <h3 class="showcase-card__title">{concept.title.hi}</h3>
              <p class="showcase-card__desc text-secondary">{concept.description.hi}</p>
              <a href={`/hi${concept.href}`} class="showcase-card__link">{concept.link.hi} &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Service Areas -->
  <section class="section" id="capabilities" aria-labelledby="capabilities-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="capabilities-heading" class="section-title">हम क्या निर्माण करते हैं</h2>
        <p class="section-subtitle text-secondary">
          स्ट्रोवा ग्रुप मूल ब्रांड है। डिजिटल, ऑटोमेशन और उत्पाद स्ट्रोवा टेक्नोलॉजी के जुड़े हुए स्तंभ हैं।
        </p>
      </div>

      <div class="services reveal">
        <article class="service">
          <span class="service__number">01</span>
          <h3 class="service__title">डिजिटल</h3>
          <p class="service__desc text-secondary">
            व्यवसाय वेबसाइट, लैंडिंग पेज, वेब ऐप, ग्राहक पोर्टल, ई-कॉमर्स और कस्टम डिजिटल प्लेटफ़ॉर्म।
          </p>
          <a href="/hi/technologies/#pillar-digital" class="service__link">
          स्ट्रोवा टेक्नोलॉजी देखें &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">02</span>
          <h3 class="service__title">एआई एवं ऑटोमेशन</h3>
          <p class="service__desc text-secondary">
            व्यवसाय प्रक्रियाओं, CRM और संचालन के लिए ऑटोमेशन और ज़रूरत के अनुसार AI इंटीग्रेशन।
          </p>
          <a href="/hi/technologies/#pillar-automation" class="service__link">
            ऑटोमेशन सेवाएं देखें &rarr;
          </a>
        </article>

        <article class="service">
          <span class="service__number">03</span>
          <h3 class="service__title">उत्पाद</h3>
          <p class="service__desc text-secondary">
            SaaS ऐप्लिकेशन, पुन: उपयोग योग्य सॉफ़्टवेयर और सत्यापित ग्राहक ज़रूरतों पर आधारित डिजिटल टूल।
          </p>
          <a href="/hi/technologies/#pillar-products" class="service__link">
            स्ट्रोवा टेक्नोलॉजी देखें &rarr;
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Approach -->
  <section class="section approach" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="approach-heading" class="section-title">हमारी कार्यप्रणाली</h2>
        <p class="section-subtitle text-secondary">
          प्रत्येक जुड़ाव एक अनुशासित क्रम का पालन करता है। कोई शॉर्टकट नहीं, कोई अस्पष्टता नहीं।
        </p>
      </div>

      <ol class="steps reveal">
        <li class="step">
          <span class="step__number">01</span>
          <h3 class="step__title">खोज (Discover)</h3>
          <p class="step__desc text-secondary">
            आप अपने प्रोजेक्ट का विवरण साझा करते हैं। हम सुनते हैं, प्रश्न पूछते हैं और समाधान प्रस्तावित करने से पहले समस्या को समझते हैं।
          </p>
        </li>
        <li class="step">
          <span class="step__number">02</span>
          <h3 class="step__title">परिभाषित (Define)</h3>
          <p class="step__desc text-secondary">
            एक कार्यदिवस के भीतर हम डिलिवरेबल्स, माइलस्टोन और निश्चित मूल्य के साथ एक लिखित स्कोप प्रदान करते हैं।
          </p>
        </li>
        <li class="step">
          <span class="step__number">03</span>
          <h3 class="step__title">निर्माण (Build)</h3>
          <p class="step__desc text-secondary">
            अनुबंध हस्ताक्षर और 50% अग्रिम के बाद विकास शुरू होता है। आप प्रत्येक स्प्रिंट के बाद स्टेजिंग डेमो देखते हैं।
          </p>
        </li>
        <li class="step">
          <span class="step__number">04</span>
          <h3 class="step__title">सत्यापन (Verify)</h3>
          <p class="step__desc text-secondary">
            स्टेजिंग पर संयुक्त समीक्षा। अंतिम भुगतान से पहले आप हस्ताक्षरित विनिर्देशों के अनुसार प्रत्येक सुविधा का परीक्षण करते हैं।
          </p>
        </li>
        <li class="step">
          <span class="step__number">05</span>
          <h3 class="step__title">समर्थन (Support)</h3>
          <p class="step__desc text-secondary">
            सोर्स कोड, रिपॉजिटरी और तकनीकी प्रलेखन का पूर्ण हैंडओवर। 100% स्वामित्व आपके संगठन को हस्तांतरित होता है।
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 5. How We Work -->
  <section class="section" aria-labelledby="how-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="how-heading" class="section-title">हम कैसे काम करते हैं</h2>
        <p class="section-subtitle text-secondary">
          एक स्पष्ट अनुबंध, एक जिम्मेदार टीम, एक उच्च मानक। पारदर्शी वाणिज्यिक शर्तें जो आपके समय और बौद्धिक संपदा की रक्षा करती हैं।
        </p>
      </div>

      <div class="principles reveal">
        <div class="principle">
          <h3 class="principle__title">लिखित निश्चित स्कोप</h3>
          <p class="text-secondary text-sm">
            काम शुरू होने से पहले प्रत्येक डिलिवरेबल, एपीआई और स्क्रीन का दस्तावेज़ीकरण होता है। कोई अप्रत्याशित शुल्क नहीं।
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">50% अग्रिम संरचना</h3>
          <p class="text-secondary text-sm">
            अग्रिम जमा निर्धारित इंजीनियरिंग स्प्रिंट को सुरक्षित करता है। शेष राशि केवल स्टेजिंग स्वीकृति के बाद देय होती है।
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">संपूर्ण कोड स्वामित्व</h3>
          <p class="text-secondary text-sm">
            अंतिम निपटान पर आपको पूर्ण बौद्धिक संपदा और कोड रिपॉजिटरी अधिकार मिलते हैं। शून्य वेंडर लॉक-इन।
          </p>
        </div>
        <div class="principle">
          <h3 class="principle__title">वैश्विक रिमोट डिलीवरी</h3>
          <p class="text-secondary text-sm">
            भारतीय और अंतरराष्ट्रीय दोनों प्रकार के उद्यमों के लिए पारदर्शी डिलीवरी। क्लाइंट पोर्टल द्वारा दैनिक अपडेट।
          </p>
        </div>
      </div>

      <div class="principles__cta">
        <a href="/hi/contact/" class="btn btn--primary" data-track="quote_click">
          अपना प्रोजेक्ट कोटेशन प्राप्त करें &rarr;
        </a>
      </div>
    </div>
