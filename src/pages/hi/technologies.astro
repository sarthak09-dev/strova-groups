---
/**
 * स्ट्रोवा टेक्नोलॉजी का परिचय और इसके तीन जुड़े हुए सेवा स्तंभ।
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'स्ट्रोवा टेक्नोलॉजी — डिजिटल, ऑटोमेशन एवं सॉफ़्टवेयर उत्पाद',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'डिजिटल सेवाएं, व्यवसाय ऑटोमेशन और सॉफ़्टवेयर उत्पाद',
  description:
    'स्ट्रोवा ग्रुप के अंतर्गत डिजिटल सेवाएं, व्यवसाय ऑटोमेशन और सॉफ़्टवेयर उत्पाद।',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'प्रौद्योगिकियां',
      item: 'https://strovagroups.in/hi/technologies/',
    },
  ],
};
---

<BaseLayout
  title="स्ट्रोवा टेक्नोलॉजी | स्ट्रोवा ग्रुप"
  description="स्ट्रोवा टेक्नोलॉजी, स्ट्रोवा ग्रुप का एकीकृत टेक्नोलॉजी व्यवसाय है। इसके तीन जुड़े स्तंभ डिजिटल, ऑटोमेशन और उत्पाद हैं।"
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
  lang="hi"
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">स्ट्रोवा ग्रुप / स्ट्रोवा टेक्नोलॉजी</span>
        <h1 class="page-hero__title">
          डिजिटल समाधान, व्यावहारिक ऑटोमेशन और सॉफ़्टवेयर उत्पाद
        </h1>
        <p class="page-hero__lead">
          स्ट्रोवा ग्रुप के अंतर्गत स्ट्रोवा टेक्नोलॉजी डिजिटल सेवाओं, व्यवसाय प्रक्रियाओं के ऑटोमेशन और ग्राहक आवश्यकताओं पर आधारित सॉफ़्टवेयर उत्पादों को जोड़ती है।
        </p>
        <div class="page-hero__actions">
          <a href="/hi/contact/?service=technologies" class="btn btn--primary btn--lg">
            प्रोजेक्ट पर चर्चा करें
          </a>
          <a href="#offerings" class="btn btn--outline btn--lg">
            तीन स्तंभ देखें &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pillars" aria-labelledby="pillars-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="pillars-title" class="section-title">एक टेक्नोलॉजी व्यवसाय। तीन जुड़े हुए स्तंभ।</h2>
        <p class="section-subtitle">डिजिटल, ऑटोमेशन और उत्पाद—स्ट्रोवा ग्रुप के अंतर्गत स्ट्रोवा टेक्नोलॉजी के हिस्से हैं।</p>
      </div>
      <div class="grid grid--3">
        <article class="card capability-card" id="pillar-digital">
          <h3 class="capability-title">डिजिटल</h3>
          <p class="capability-text">व्यवसाय वेबसाइट और लैंडिंग पेज, वेब ऐप व ग्राहक पोर्टल, ई-कॉमर्स समाधान और कस्टम डिजिटल प्लेटफ़ॉर्म।</p>
          <a class="showcase-card__link" href="/hi/digital/">डिजिटल सेवाएं देखें &rarr;</a>
          <a class="showcase-card__link" href="/hi/commerce/">ई-कॉमर्स समाधान देखें &rarr;</a>
        </article>
        <article class="card capability-card" id="pillar-automation">
          <h3 class="capability-title">ऑटोमेशन</h3>
          <p class="capability-text">व्यवसाय प्रक्रियाएं, CRM और संचालन इंटीग्रेशन, उपयुक्त AI इंटीग्रेशन और दोहराए जाने वाले कार्यों का ऑटोमेशन।</p>
          <a class="showcase-card__link" href="#automation">ऑटोमेशन क्षमताएं देखें &rarr;</a>
        </article>
        <article class="card capability-card" id="pillar-products">
          <h3 class="capability-title">उत्पाद</h3>
          <p class="capability-text">SaaS ऐप्लिकेशन, पुन: उपयोग योग्य सॉफ़्टवेयर, डिजिटल टूल और ग्राहक आवश्यकताओं के आधार पर प्लेटफ़ॉर्म।</p>
          <p class="text-secondary text-sm">यह उत्पादों पर कार्य का परिचय है; किसी उत्पाद के लॉन्च की घोषणा नहीं।</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">सेवा का विवरण</span>
            <p class="overview-item__val">डिजिटल सेवाएं, व्यवसाय वर्कफ़्लो ऑटोमेशन और ग्राहक आवश्यकताओं के आधार पर सॉफ़्टवेयर उत्पाद।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">किसके लिए उपयुक्त</span>
            <p class="overview-item__val">वे व्यवसाय जिन्हें अपनी ऑनलाइन सेवाओं, आंतरिक प्रक्रियाओं या डिजिटल उत्पादों के लिए तकनीकी सहायता चाहिए।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">कोटेशन प्रक्रिया</span>
            <p class="overview-item__val">आवश्यकताओं और दायरे की समीक्षा के बाद लिखित प्रस्ताव दिया जाता है।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">अनुमानित समयसीमा</span>
            <p class="overview-item__val">प्रस्ताव में प्रोजेक्ट के दायरे और आवश्यकताओं के आधार पर अनुमानित समयसीमा दी जाती है।</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Engineering Capabilities -->
  <section class="section" id="offerings" aria-labelledby="offerings-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="offerings-title" class="section-title">हम क्या बनाते हैं और हमारी तकनीक</h2>
        <p class="section-subtitle">
          स्पष्ट आवश्यकताओं, अनुरक्षण योग्य डिलीवरी और लिखित हैंडओवर पर केंद्रित।
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Web Architecture -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3 class="capability-title">हाई-परफॉर्मेंस वेब प्लेटफ़ॉर्म</h3>
          <p class="capability-text">
            परियोजना की जरूरत के अनुसार हम उपयुक्त वेब आर्किटेक्चर और टूल चुनते हैं। प्राथमिकताएं उपयोगिता, अनुरक्षण और आवश्यक प्रदर्शन पर केंद्रित रहती हैं।
          </p>
          <ul class="capability-features">
            <li><strong>फ्रेमवर्क:</strong> Astro, Next.js, TypeScript, Tailwind CSS</li>
            <li><strong>परफॉर्मेंस:</strong> कोर वेब वाइटल्स और मोबाइल उपयोगिता पर ध्यान</li>
            <li><strong>अभिगम्यता:</strong> मानक सुलभता अभ्यासों पर आधारित markup</li>
            <li><strong>एज डिप्लॉयमेंट:</strong> Cloudflare Pages और Vercel कैशिंग</li>
          </ul>
        </article>

        <!-- 2. Android Apps -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3 class="capability-title">नेटिव एवं क्रॉस-प्लेटफ़ॉर्म एंड्रॉइड</h3>
          <p class="capability-text">
            कोटलिन और जेटपैक कंपोज़ के साथ निर्मित नेटिव एंड्रॉइड ऐप्स। ऑफलाइन डेटा निरंतरता, हार्डवेयर सेंसर समन्वय और सख्त मेमोरी दक्षता के साथ अनुकूलित।
          </p>
          <ul class="capability-features">
            <li><strong>कोर भाषा:</strong> Kotlin, Jetpack Compose, Coroutines, Flow</li>
            <li><strong>ऑफलाइन सिंक:</strong> स्वचालित कतार के साथ SQLite / Room डेटाबेस</li>
            <li><strong>अनुपालन:</strong> Google Play Store नीतियां एवं Android 14+ मानक</li>
            <li><strong>हार्डवेयर एपीआई:</strong> बायोमेट्रिक प्रमाणीकरण, ब्लूटूथ, कैमरा फीड</li>
          </ul>
        </article>

        <!-- 3. Custom SaaS & Dashboards -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3 class="capability-title">कस्टम सास एवं आंतरिक डैशबोर्ड</h3>
          <p class="capability-text">
            आपके विशिष्ट डेटा मॉडल के अनुसार डिज़ाइन किए गए ऑपरेशनल पोर्टल, रोल-आधारित क्लाइंट डैशबोर्ड और कस्टम व्यावसायिक प्रबंधन सॉफ़्टवेयर। कोई सामान्य टेम्पलेट नहीं जो आपके कार्यप्रवाह को बाधित करे।
          </p>
          <ul class="capability-features">
            <li><strong>स्टैक:</strong> Node.js, Python, PostgreSQL, Redis, Docker</li>
            <li><strong>सुरक्षा:</strong> भूमिका-आधारित पहुंच नियंत्रण (RBAC), JWT टोकन</li>
            <li><strong>रीयल-टाइम:</strong> WebSockets, सर्वर-सेंट इवेंट्स, लाइव केपीआई डैशबोर्ड</li>
            <li><strong>इंटीग्रेशन:</strong> Razorpay, Stripe, AWS S3, Cloudflare R2</li>
          </ul>
        </article>

        <!-- 4. WhatsApp & AI Automation -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </div>
          <h3 class="capability-title" id="automation">व्हाट्सएप बिजनेस एवं एआई ऑटोमेशन</h3>
          <p class="capability-text">
            ग्राहक वार्तालाप को स्वचालित व्यावसायिक कार्यों में बदलें। हम आधिकारिक मेटा क्लाउड एपीआई, वेबहुक और अनुकूलित एलएलएम को एकीकृत कर सहायता ट्राइएज, लीड योग्यता और सीआरएम सिंक प्रदान करते हैं।
          </p>
          <ul class="capability-features">
            <li><strong>मैसेजिंग integrations:</strong> account access और setup उपलब्ध होने पर WhatsApp Cloud API का दायरा तय किया जा सकता है</li>
            <li><strong>लीड कैप्चर:</strong> इंटरैक्टिव संदेश टेम्पलेट और त्वरित उत्तर</li>
            <li><strong>एलएलएम ट्राइएज:</strong> संदर्भ-आधारित सामान्य प्रश्नोत्तर और मानव एस्केलेशन</li>
            <li><strong>डेटा सिंक:</strong> ज़ोहो, हबस्पॉट, ईआरपी या स्प्रेडशीट के लिए सीधा वेबहुक</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Focused Industry Solutions -->
  <section class="section industry-solutions-section" aria-labelledby="industry-solutions-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="industry-solutions-title" class="section-title">विशिष्ट व्यावसायिक कार्यप्रवाहों के लिए समाधान</h2>
        <p class="section-subtitle">
          वास्तविक व्यावसायिक चुनौतियों और परिचालनात्मक आवश्यकताओं के लिए उद्देश्य-निर्मित सॉफ़्टवेयर वास्तुकला।
        </p>
      </div>

      <div class="grid grid--2">
        <article class="card solution-card">
          <div class="solution-card__badge">स्वास्थ्य सेवा एवं स्थानीय क्लीनिक</div>
          <h3 class="solution-card__title">भारत में क्लीनिकों के लिए वेबसाइट विकास</h3>
          <p class="solution-card__desc">
            जब मरीज किसी विशेषज्ञ या नैदानिक परीक्षण की तलाश करते हैं, तो गति अत्यंत महत्वपूर्ण होती है। हम भारत भर में दंत क्लीनिकों, डायग्नोस्टिक सेंटरों और अस्पतालों के लिए अल्ट्रा-फास्ट, मोबाइल-फर्स्ट प्लेटफॉर्म बनाते हैं।
          </p>
          <ul class="solution-card__list">
            <li><strong>त्वरित मोबाइल एक्सेस:</strong> मोबाइल 4G/5G नेटवर्क पर सब-सेकंड पेज लोड गति ताकि मरीज तुरंत डॉक्टर की उपलब्धता देख सकें।</li>
            <li><strong>सहज व्हाट्सएप अपॉइंटमेंट:</strong> प्री-फिल्ड विभाग पूछताछ के साथ क्लिक-टू-व्हाट्सएप रूटिंग जिसे स्टाफ तुरंत पुष्ट कर सकता है।</li>
            <li><strong>DPDP डेटा सुरक्षा:</strong> कोई असुरक्षित ट्रैकर या डेटा रिसाव नहीं; पूछताछ एन्क्रिप्ट होकर सीधे आपके सत्यापित इनबॉक्स या सीआरएम में जाती है।</li>
            <li><strong>स्थानीय एसईओ स्कीमा:</strong> स्थानीय मैप्स और उच्च-इरादा खोजों में शीर्ष स्थान के लिए MedicalClinic संरचित डेटा।</li>
          </ul>
        </article>

        <article class="card solution-card">
          <div class="solution-card__badge">संवादात्मक ऑटोमेशन</div>
          <h3 class="solution-card__title">व्यवसायों के लिए व्हाट्सएप ऑटोमेशन</h3>
          <p class="solution-card__desc">
            WhatsApp पूछताछ को सहमत व्यावसायिक workflow से जोड़ें ताकि दोहराए जाने वाले संदेश प्रबंधन को कम करने और अनुरोध सही अगले चरण तक पहुँचाने में मदद मिले।
          </p>
          <ul class="solution-card__list">
            <li><strong>जुड़े हुए workflow:</strong> आवश्यक access और setup उपलब्ध होने पर WhatsApp Cloud API integration का दायरा तय किया जा सकता है।</li>
            <li><strong>बुद्धिमान लीड योग्यता:</strong> इंटरैक्टिव बटन मेनू और संरचित प्रवाह के माध्यम से ग्राहक की आवश्यकता और बजट का स्वचालित संग्रह।</li>
            <li><strong>सहज सीआरएम एकीकरण:</strong> संपर्क विवरण और चैट सारांश रीयल-टाइम में Zoho CRM, PostgreSQL या Google Sheets में सुरक्षित रूप से दर्ज।</li>
            <li><strong>लाइव एजेंट एस्केलेशन:</strong> जब कोई ग्राहक लाइव परामर्श चाहता है, तो कार्यप्रवाह पूरी चैट संदर्भ के साथ तुरंत आपकी टीम को सतर्क करता है।</li>
          </ul>
        </article>
      </div>
