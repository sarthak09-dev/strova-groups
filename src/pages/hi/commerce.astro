---
/**
 * स्ट्रोवा टेक्नोलॉजी के डिजिटल स्तंभ के अंतर्गत ई-कॉमर्स समाधान।
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'स्ट्रोवा टेक्नोलॉजी के ई-कॉमर्स समाधान',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'ई-कॉमर्स वेबसाइट और इंटीग्रेशन',
  description:
    'व्यवसाय की कैटलॉग, चेकआउट और संचालन आवश्यकताओं के अनुसार ई-कॉमर्स वेबसाइट और इंटीग्रेशन।',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'मुख्य पृष्ठ',
      item: 'https://strovagroups.in/hi/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'ई-कॉमर्स समाधान',
      item: 'https://strovagroups.in/hi/commerce/',
    },
  ],
};
---

<BaseLayout
  title="ई-कॉमर्स समाधान — स्ट्रोवा टेक्नोलॉजी | स्ट्रोवा ग्रुप"
  description="स्ट्रोवा टेक्नोलॉजी के डिजिटल स्तंभ के अंतर्गत ई-कॉमर्स वेबसाइट और इंटीग्रेशन।"
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
  lang="hi"
>
  <section class="commerce-hero">
    <div class="container text-center">
      <div class="coming-soon-badge">
        <span class="badge-dot"></span>
        <span>स्ट्रोवा टेक्नोलॉजी &bull; डिजिटल</span>
      </div>
      <h1 class="commerce-title">
        आपके व्यवसाय के अनुसार ई-कॉमर्स
      </h1>
      <p class="commerce-lead">
        एक ई-कॉमर्स प्रोजेक्ट में स्टोरफ्रंट, चेकआउट, कैटलॉग और व्यवसाय की ज़रूरत के अनुसार इंटीग्रेशन शामिल हो सकते हैं।
      </p>

      <div class="commerce-actions">
        <a href="/hi/contact/?service=commerce" class="btn btn--primary btn--lg">
          ई-कॉमर्स प्रोजेक्ट पर चर्चा करें
        </a>
        <a href="/hi/technologies/" class="btn btn--outline btn--lg">
          स्ट्रोवा टेक्नोलॉजी देखें
        </a>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">सेवा का विवरण</span>
            <p class="overview-item__val">प्रोजेक्ट में स्टोरफ्रंट, चेकआउट, कैटलॉग वर्कफ़्लो और आवश्यकतानुसार चुने गए इंटीग्रेशन शामिल हो सकते हैं।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">किसके लिए उपयुक्त</span>
            <p class="overview-item__val">वे व्यवसाय जो उत्पाद ऑनलाइन बेचना चाहते हैं या अपने स्टोरफ्रंट को मौजूदा व्यावसायिक सिस्टम से जोड़ना चाहते हैं।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">वाणिज्यिक स्थिति</span>
            <p class="overview-item__val">आवश्यकताओं की समीक्षा के बाद सुविधाएं, इंटीग्रेशन और समयसीमा तय की जाती है।</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">अनुमानित समयसीमा</span>
            <p class="overview-item__val">लिखित प्रस्ताव में प्रोजेक्ट का दायरा, चरण और अनुमानित समयसीमा दी जाती है।</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural Pillars of Commerce -->
  <section class="section" aria-labelledby="roadmap-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="roadmap-title" class="section-title">डिजिटल स्तंभ के अंतर्गत विकल्प</h2>
        <p class="section-subtitle">
          उपयुक्त समाधान आपके कैटलॉग, ग्राहकों और मौजूदा सिस्टम पर निर्भर करता है।
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card pillar-card">
          <div class="pillar-number">01</div>
          <h3 class="pillar-title">हेडलेस एज स्टोरफ्रंट्स</h3>
          <p class="pillar-desc">
            उत्पादों, सामग्री और ग्राहक यात्रा के अनुसार तैयार किया गया उत्तरदायी स्टोरफ्रंट।
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">02</div>
          <h3 class="pillar-title">व्हाट्सएप कैटलॉग एवं चेकआउट</h3>
          <p class="pillar-desc">
            जहां उपयुक्त हो, उत्पाद खोज और ग्राहक पूछताछ को मैसेजिंग वर्कफ़्लो से जोड़ा जा सकता है।
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">03</div>
          <h3 class="pillar-title">बुद्धिमान सीओडी एवं आरटीओ सुरक्षा</h3>
          <p class="pillar-desc">
            चेकआउट और ऑर्डर वर्कफ़्लो आपके व्यवसाय द्वारा समर्थित भुगतान व डिलीवरी विकल्पों के अनुसार तैयार किए जा सकते हैं।
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">04</div>
          <h3 class="pillar-title">ओमनीचैनल रीयल-टाइम सिंक</h3>
          <p class="pillar-desc">
            उपलब्ध इंटीग्रेशन और तय दायरे के अनुसार कैटलॉग या ऑर्डर डेटा को अन्य व्यावसायिक सिस्टम से जोड़ा जा सकता है।
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">05</div>
          <h3 class="pillar-title">भारतीय भुगतान रूटिंग</h3>
          <p class="pillar-desc">
            भुगतान विकल्प लक्ष्य बाजार और प्रोजेक्ट आवश्यकताओं की समीक्षा के बाद चुने जाते हैं।
          </p>
        </div>

        <div class="card pillar-card">
          <div class="pillar-number">06</div>
          <h3 class="pillar-title">वैश्विक मुद्रा एवं कर अनुपालन</h3>
          <p class="pillar-desc">
            कर, मुद्रा और इनवॉइस की आवश्यकताओं की हर प्रोजेक्ट में समीक्षा की जाती है।
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Early Partner Callout -->
  <section class="section early-access-section">
    <div class="container">
      <div class="early-access-box">
        <div class="early-access-content">
          <h2 class="early-access-title">ई-कॉमर्स प्रोजेक्ट की योजना बना रहे हैं?</h2>
          <p class="early-access-desc">
            अपने उत्पादों, ग्राहक यात्रा और संचालन की ज़रूरतें साझा करें। हम उपयुक्त दायरे और लिखित प्रस्ताव पर चर्चा करेंगे।
          </p>
          <div class="early-access-perks">
            <div class="perk-item">
              <strong>प्रोजेक्ट का दायरा</strong> आपकी ज़रूरतों के आधार पर।
            </div>
            <div class="perk-item">
              <strong>उपयुक्त इंटीग्रेशन</strong> आवश्यकता समीक्षा के दौरान।
            </div>
            <div class="perk-item">
              <strong>स्पष्ट चरण</strong> लिखित प्रस्ताव में।
            </div>
          </div>
          <a href="/hi/contact/?service=commerce" class="btn btn--primary btn--lg">
            अपनी आवश्यकताओं पर चर्चा करें
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .commerce-hero {
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .commerce-hero .container {
    max-width: 52rem;
  }

  .coming-soon-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4);
    background: rgba(148, 163, 184, 0.15);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 9999px;
    margin-bottom: var(--space-6);
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 50%;
  }

  .commerce-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .commerce-lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .commerce-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .pillar-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .pillar-number {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  .pillar-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .early-access-section {
    padding-bottom: var(--space-24);
  }

  .early-access-box {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    color: var(--color-snow);
    text-align: center;
  }

  .early-access-content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .early-access-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
    margin-bottom: var(--space-4);
  }

  .early-access-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    margin-bottom: var(--space-8);
  }

  .early-access-perks {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    text-align: left;
    margin-bottom: var(--space-8);
  }

  @media (min-width: 48rem) {
    .early-access-perks {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .perk-item {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: #cbd5e1;
  }

  .perk-item strong {
    color: var(--color-snow);
    display: block;
    margin-bottom: var(--space-1);
  }

  .service-overview-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .service-overview-card {
    padding: var(--space-8);
    background: var(--bg-surface);
  }

  .service-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .service-overview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .service-overview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .overview-item__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .overview-item__val {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>

