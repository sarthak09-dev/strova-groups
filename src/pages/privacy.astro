---
/**
 * Privacy Policy Page (src/pages/privacy.astro)
 *
 * Privacy information for Strova Group website and portal visitors.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Privacy Policy',
      item: 'https://strovagroups.in/privacy/',
    },
  ],
};

const policyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy — Strova Group',
  description:
    "How Strova Group handles information submitted through its website, client portal, and project communications.",
  publisher: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
    email: 'info@strovagroups.in',
    telephone: '+919288077802',
  },
};
---

<BaseLayout
  title="Privacy Policy — Strova Group"
  description="How Strova Group handles information submitted through its website, client portal, and project communications."
  jsonLd={[policyJsonLd, breadcrumbJsonLd]}
>
  <section class="section">
    <div class="container prose">
      <span class="section-eyebrow">Privacy &amp; Data Governance</span>
      <h1>Privacy Policy &amp; Data Protection Statement</h1>
      <p class="text-sm text-muted">Effective Date: October 14, 2026 &bull; Version 2.0</p>

      <div class="card card--quiet" style="padding: var(--space-6); margin-block: var(--space-6); border-left: 3px solid var(--accent);">
        <p class="text-xs text-muted" style="margin: 0; line-height: 1.6;">
          <strong>Legal Identity &amp; Scope:</strong> <strong>Strova Group</strong> is an independent commercial micro-enterprise operating as a sole proprietorship of <strong>Babita Kumari</strong> (MSME Registration: UDYAM-JH-20-0147452). This Privacy Policy applies to personal data processed through our public marketing website (<a href="https://strovagroups.in">strovagroups.in</a>), our client portal (<a href="https://strovagroups.in/portal/">strovagroups.in/portal</a>), commercial communications, and client project fulfillment.
        </p>
      </div>

      <h2>1. Dual Operating Roles: Data Fiduciary &amp; Data Processor</h2>
      <p>
        Privacy obligations depend on the service, the data involved, and applicable law. For project work involving a client's end users, the parties' roles and responsibilities must be agreed in the applicable project documents.
      </p>
      <ul>
        <li>
          <strong>Data Fiduciary (Data Controller):</strong> When you browse our website, request a project quote, communicate with our team via email or WhatsApp, create or access an account on our Client Portal, or contract with us as a direct commercial client, Strova Group determines the purpose and means of processing your personal data.
        </li>
        <li>
          <strong>Project data:</strong> When a project processes personal data for a client, the agreed project scope and written terms should describe the parties' responsibilities and any required safeguards before that processing begins.
        </li>
      </ul>

      <h2>2. Personal Data Inventory</h2>
      <p>
        The information we receive depends on how you interact with us. We use it to respond to enquiries, provide contracted services, secure the portal, and handle payments or support. Please do not submit sensitive personal information unless it is necessary for the request.
      </p>

      <div class="table-responsive" style="overflow-x: auto; margin-block: var(--space-6);">
        <table class="data-table" style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-border); text-align: left;">
              <th style="padding: 0.75rem 0.5rem;">Data Category</th>
              <th style="padding: 0.75rem 0.5rem;">Data Elements</th>
              <th style="padding: 0.75rem 0.5rem;">Use</th>
              <th style="padding: 0.75rem 0.5rem;">Retention</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">Prospective Inquiries &amp; Quotes</td>
              <td style="padding: 0.75rem 0.5rem;">Full name, business email, company name, phone/WhatsApp, project description, timeline.</td>
              <td style="padding: 0.75rem 0.5rem;">Responding to your enquiry and preparing a proposal.</td>
              <td style="padding: 0.75rem 0.5rem;">As needed to handle the enquiry and related obligations.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">Client Portal Authentication</td>
              <td style="padding: 0.75rem 0.5rem;">Client email address, 6-digit cryptographic OTP, Supabase authentication tokens, session timestamps.</td>
              <td style="padding: 0.75rem 0.5rem;">Account access and portal security.</td>
              <td style="padding: 0.75rem 0.5rem;">While the account is active and as needed for security or legal obligations.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">Invoicing &amp; Commercial Records</td>
              <td style="padding: 0.75rem 0.5rem;">Client billing entity name, GSTIN, PAN, billing address, Razorpay order/payment IDs, bank transfer UTR numbers.</td>
              <td style="padding: 0.75rem 0.5rem;">Billing, payment reconciliation, and applicable record-keeping obligations.</td>
              <td style="padding: 0.75rem 0.5rem;">For the period required for the transaction and applicable legal obligations.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">In-App Messages &amp; Support</td>
              <td style="padding: 0.75rem 0.5rem;">Project exchange messages, ticket subjects, technical diagnostics, file attachments.</td>
              <td style="padding: 0.75rem 0.5rem;">Project delivery and support.</td>
              <td style="padding: 0.75rem 0.5rem;">As needed for delivery, support, and applicable obligations.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">Security &amp; Edge Telemetry</td>
              <td style="padding: 0.75rem 0.5rem;">IP address, Cloudflare Turnstile token, browser User-Agent, edge request timestamps.</td>
              <td style="padding: 0.75rem 0.5rem;">Abuse prevention and service security.</td>
              <td style="padding: 0.75rem 0.5rem;">Retention depends on the relevant service provider's configuration.</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 0.75rem 0.5rem; font-weight: 600;">Privacy Rights &amp; Grievances</td>
              <td style="padding: 0.75rem 0.5rem;">Requester name, email, request category, tracking reference (PR-YYYYMM-XXXX), resolution audit notes.</td>
              <td style="padding: 0.75rem 0.5rem;">Reviewing and responding to the request.</td>
              <td style="padding: 0.75rem 0.5rem;">As needed to respond and meet applicable obligations.</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>3. Website Storage &amp; Third-Party Services</h2>
      <p>
        Website and portal technologies may use browser storage or cookies to provide their features:
      </p>
      <ul>
        <li>
          <strong>Public Marketing Site (<a href="https://strovagroups.in">strovagroups.in</a>):</strong> Our current site code does not configure a third-party analytics provider. This may change if site services are updated.
        </li>
        <li>
          <strong>Client Portal (<a href="https://strovagroups.in/portal/">strovagroups.in/portal</a>):</strong> Supabase client authentication stores a session in browser storage. Keep your device secure and sign out when using a shared device.
        </li>
        <li>
          <strong>Payment Gateway Modal:</strong> When paying an invoice via Razorpay, transient session cookies are set inside the Razorpay secure checkout iframe strictly to process the transaction and prevent payment fraud.
        </li>
      </ul>
      <p>
        For full technical details, consult our standalone <a href="/cookies/">Cookie Policy</a>.
      </p>

      <h2>4. Authorized Subprocessors &amp; Cloud Infrastructure</h2>
      <p>
        Depending on the feature used, information may be processed by infrastructure and service providers configured for the website, portal, forms, or payments. Provider locations and retention settings depend on the deployed account configuration; contact us for service-specific information.
      </p>
      <ul>
        <li>Cloudflare is used for edge hosting and bot verification.</li>
        <li>Supabase is used for client portal authentication and database services.</li>
        <li>Razorpay is used when a client chooses the portal payment flow.</li>
        <li>A configured form provider may relay contact and privacy-request submissions.</li>
        <li>WhatsApp is available when a visitor chooses to contact us through that service.</li>
      </ul>

      <h2>5. AI Model Training &amp; Automated Processing Safeguards</h2>
      <p>
        AI and automated processing, if included in a project, should be described and governed by that project's scope and terms. We do not make a blanket claim about provider retention or model-training settings for every integration.
      </p>
      <ul>
      </ul>

      <h2>6. International Data Transfers</h2>
      <p>
        Service providers may process information in locations outside your country. Cross-border arrangements and applicable safeguards should be confirmed for the specific service and project; no universal transfer arrangement is promised by this notice.
      </p>

      <h2 id="privacy-choices">7. Privacy Requests</h2>
      <p>
        You may contact us to ask about personal information associated with you, request a correction or deletion, withdraw consent where applicable, or raise a concern. Applicable statutory rights and commencement dates depend on the law and its notified implementation schedule. The DPDP Act and Rules have phased commencement; this notice is not a legal compliance certification.
      </p>
      <ul>
        <li>Requests are reviewed in line with applicable law and the information available to us.</li>
        <li>We may need to verify identity before disclosing, correcting, or deleting information.</li>
        <li>Some records may need to be retained to meet applicable legal or contractual obligations.</li>
      </ul>

      <h2>8. How to Exercise Your Rights (Self-Service Web Desk)</h2>
      <p>
        To submit a formal request for access, correction, erasure, or grievance redressal, please use our dedicated web portal:
      </p>
      <div class="card card--quiet" style="padding: var(--space-6); margin-block: var(--space-4);">
        <h3 style="margin-top: 0; font-size: 1.125rem;">Dedicated Privacy Rights &amp; Grievance Desk</h3>
        <p class="text-sm text-secondary" style="margin-bottom: 1rem;">
          Your reference is issued when the configured delivery provider accepts the request. We aim to acknowledge within 48 hours and respond within 30 days; these are company service targets, not statutory deadlines.
        </p>
        <a href="/privacy/requests/" class="btn btn--primary">Open Privacy Rights Desk &rarr;</a>
      </div>

      <h2>9. Data Protection &amp; Grievance Redressal Desk</h2>
      <p>
        For privacy questions and grievances, contact us using the details below:
      </p>
      <div class="card card--quiet" style="padding: var(--space-6);">
        <p><strong>Privacy contact:</strong> Strova Group</p>
        <p><strong>Operating Entity:</strong> Strova Group (Proprietorship of Babita Kumari)</p>
        <p><strong>MSME Registration:</strong> UDYAM-JH-20-0147452</p>
        <p><strong>Grievance Email:</strong> <a href="mailto:info@strovagroups.in?subject=Privacy%20Grievance">info@strovagroups.in</a></p>
        <p><strong>Telephone &amp; WhatsApp:</strong> <a href="tel:+919288077802">+91 92880 77802</a></p>
        <p><strong>Operating Hours:</strong> Monday through Saturday, 10:00 AM – 7:00 PM IST (UTC+5:30)</p>
        <p><strong>Service targets:</strong> We aim to acknowledge within <strong>48 hours</strong> and respond within <strong>30 days</strong>.</p>
      </div>

      <h2>10. Applicable Law</h2>
      <p>India's Digital Personal Data Protection Act, 2023 and Digital Personal Data Protection Rules, 2025 have commencement dates set through official notifications. Please refer to the <a href="https://www.meity.gov.in/static/uploads/2025/11/c56ceae6c383460ca69577428d36828b.pdf" rel="noopener noreferrer">Act commencement notification</a> and <a href="https://www.meity.gov.in/static/uploads/2025/11/53450e6e5dc0bfa85ebd78686cadad39.pdf" rel="noopener noreferrer">DPDP Rules notification</a> for the official schedule. Consult qualified legal counsel for advice about your rights or our legal obligations.</p>

      <h2>11. Policy Amendments &amp; Notifications</h2>
      <p>
        We review and update this Privacy Policy periodically to reflect legal amendments, technological enhancements, and regulatory notifications under the DPDP Rules 2025. Material updates will be announced via a prominent notice on our website and client portal.
      </p>

      <p class="text-sm text-muted" style="margin-top: var(--space-8); border-top: 1px solid var(--color-border); padding-top: var(--space-4);">
        Strova Group is an independent micro-enterprise operating as a proprietorship of Babita Kumari. Registered MSME: UDYAM-JH-20-0147452. Governing law: Republic of India.
      </p>
    </div>
  </section>
</BaseLayout>
