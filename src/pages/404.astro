---
/**
 * 404 Error Page (src/pages/404.astro)
 *
 * Requirements:
 * - Branded, accessible, responsive error layout
 * - noindex meta tag
 * - Clear navigation back to primary pages
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) — Strova Group"
  description="The requested page could not be located on Strova Group. Explore our software engineering and growth services."
  noindex={true}
>
  <section class="error-section">
    <div class="container text-center">
      <div class="error-badge">Error 404</div>
      <h1 class="error-title">Page Not Located</h1>
      <p class="error-desc">
        The route you requested does not exist or has been relocated to another endpoint. Use the navigation links below to return to our primary services.
      </p>

      <div class="error-actions">
        <a href="/" class="btn btn--primary btn--lg">
          Return to Home
        </a>
        <a href="/technologies/" class="btn btn--outline btn--lg">
          Strova Technologies
        </a>
        <a href="/contact/" class="btn btn--outline btn--lg">
          Contact Support
        </a>
      </div>

      <div class="error-links">
        <span class="error-links__title">Popular Resources</span>
        <ul class="error-links__list">
          <li><a href="/digital/">Strova Digital Growth &amp; SEO</a></li>
          <li><a href="/commerce/">Strova Commerce (Coming Soon)</a></li>
          <li><a href="/case-studies/">Architectural Case Studies</a></li>
          <li><a href="/about/">About Strova Group</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    padding-top: var(--space-20);
    padding-bottom: var(--space-24);
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .error-section .container {
    max-width: 44rem;
  }

  .text-center {
    text-align: center;
  }

  .error-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-6);
  }

  .error-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .error-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .error-links {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-color);
  }

  .error-links__title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .error-links__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-8);
  }

  .error-links__list a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .error-links__list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
