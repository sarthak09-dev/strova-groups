---
/**
 * Case Studies Page (src/pages/case-studies.astro)
 *
 * Truthful, transparent documentation of engineering standards.
 * All fabricated numbers, synthetic outcomes, and unverified reviews have been removed.
 * Case studies are documented as real client milestones conclude with written consent.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Case Studies',
      item: 'https://strovagroups.in/case-studies/',
    },
  ],
};
---

<BaseLayout
  title="Case Studies & Engineering Process — Strova Group"
  description="Transparent overview of Strova Group's engineering process, milestone delivery standards, and verified client engagement models."
  jsonLd={[breadcrumbJsonLd]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="ambient-glow-indigo" style="top: -120px; right: 5%; opacity: 0.6;"></div>
    <div class="ambient-glow-cyan" style="bottom: 20px; left: -80px; opacity: 0.4;"></div>
    <div class="container">
      <div class="page-hero__content">
        <h1 class="page-hero__title">
          Case Studies &amp; <span class="gradient-text">Project Standards</span>
        </h1>
        <p class="page-hero__lead">
          We strictly refuse to publish invented case studies, synthetic statistics, or unverified reviews. Detailed architectural case studies will be published here as active client engagements complete and clients grant written permission.
        </p>
      </div>
    </div>
  </section>

  <!-- Standards & Delivery Framework -->
  <section class="section" aria-labelledby="standards-heading">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="standards-heading" class="section-title">What Clients Can Expect on Every Engagement</h2>
        <p class="section-subtitle">
          Our engineering studio operates on verifiable discipline, transparent milestones, and zero proprietary lock-in.
        </p>
      </div>

      <div class="grid grid--2">
        <div class="card expectation-card">
          <div class="expectation-num">01</div>
          <h3 class="expectation-title">Fixed Technical Blueprint</h3>
          <p class="expectation-text">
            Before code is written, you receive an architectural specification with database schema models, API contracts, milestone deliverables, and fixed sprint estimates. We eliminate ambiguous change-orders.
          </p>
        </div>

        <div class="card expectation-card">
          <div class="expectation-num">02</div>
          <h3 class="expectation-title">Private Staging &amp; Bi-Weekly Demos</h3>
          <p class="expectation-text">
            Every sprint deploys to a password-protected staging URL. You review working software after every agile sprint, ensuring implementation tracks your exact business requirements.
          </p>
        </div>

        <div class="card expectation-card">
          <div class="expectation-num">03</div>
          <h3 class="expectation-title">100% Repository &amp; IP Ownership</h3>
          <p class="expectation-text">
            Upon final milestone settlement, complete ownership of all custom codebase, repositories, documentation, and configuration scripts transfers entirely to your organization without platform licensing fees.
          </p>
        </div>

        <div class="card expectation-card">
          <div class="expectation-num">04</div>
          <h3 class="expectation-title">30-Day Post-Launch Bug Warranty</h3>
          <p class="expectation-text">
            We stand behind our code. Every custom web platform and SaaS application includes a complimentary 30-day post-launch warranty covering any functional regressions diverging from the agreed specification.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities in Action -->
  <section class="section capabilities-framework-section" aria-labelledby="framework-heading">
    <div class="container">
      <div class="framework-card">
        <h2 id="framework-heading" class="framework-title">Active Engineering Capabilities</h2>
        <p class="framework-desc">
          While public case studies are being prepared for release, explore our current engineering capabilities across divisions:
        </p>
        <div class="framework-grid">
          <div class="framework-col">
            <h3 class="framework-col__title">Strova Technologies</h3>
            <ul class="framework-list">
              <li>Sub-second static and hybrid web platforms (Astro, Next.js)</li>
              <li>Native Android applications with offline-first Room SQLite sync</li>
              <li>Official Meta WhatsApp Cloud API automation pipelines</li>
              <li>Multi-tenant custom SaaS portals and business management dashboards</li>
            </ul>
            <a href="/technologies/" class="btn btn--outline btn--sm">View Technologies</a>
          </div>
          <div class="framework-col">
            <h3 class="framework-col__title">Strova Digital</h3>
            <ul class="framework-list">
              <li>Technical SEO architecture &amp; Core Web Vitals remediation</li>
              <li>Server-side Conversion API (CAPI) attribution wiring</li>
              <li>High-intent paid search and performance ad campaigns</li>
              <li>Inbound conversion-rate optimization and funnel testing</li>
            </ul>
            <a href="/digital/" class="btn btn--outline btn--sm">View Digital</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">Discuss Your Technical Requirements</h2>
          <p class="cta-desc">
            Connect with Strova Group for an architectural assessment and transparent milestone proposal within 24 business hours.
          </p>
          <div class="cta-buttons">
            <a href="/contact/" class="btn btn--primary btn--lg">
              Submit a Project Brief
            </a>
            <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" class="btn btn--whatsapp btn--lg">
              WhatsApp (+91 92880 77802)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .text-center {
    text-align: center;
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    max-width: 42rem;
    margin-inline: auto;
  }

  .expectation-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .expectation-num {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--accent);
  }

  .expectation-title {
    font-size: var(--text-xl);
    margin: 0;
  }

  .expectation-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .capabilities-framework-section {
    padding-top: 0;
  }

  .framework-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  .framework-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .framework-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }

  .framework-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .framework-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .framework-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .framework-col__title {
    font-size: var(--text-lg);
    color: var(--accent);
    margin: 0;
  }

  .framework-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .framework-list li {
    position: relative;
    padding-left: var(--space-4);
  }

  .framework-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .btn--sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    align-self: flex-start;
  }

  /* CTA Section */
  .cta-section {
    padding-top: var(--space-10);
  }

  .cta-banner {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .cta-content {
    max-width: 42rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-inline: auto;
    margin-bottom: var(--space-8);
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
