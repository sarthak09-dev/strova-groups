---
/**
 * Digital Division Page (src/pages/digital.astro)
 *
 * Division: Strova Digital
 * Focus: SEO, Performance Ads, Lead Generation, Social Media Strategy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Strova Digital — Performance Marketing & SEO',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'Digital Marketing and Search Engine Optimization',
  areaServed: ['IN', 'US', 'GB', 'AE', 'EU'],
  description:
    'Technical SEO, high-intent Google and Meta performance advertising, server-side conversion tracking, and automated lead generation funnels.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Growth Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Technical & Programmatic SEO',
          description: 'Core Web Vitals remediation, schema markup architecture, and programmatic search rank optimization.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Paid Media & ROAS Optimization',
          description: 'Google Ads and Meta Ads management with server-side CAPI attribution.',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Inbound Lead Generation Funnels',
          description: 'High-converting landing pages wired to automated CRM qualification flows.',
        },
      },
    ],
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Digital',
      item: 'https://strovagroups.in/digital/',
    },
  ],
};
---

<BaseLayout
  title="Strova Digital — Performance SEO & Ads | Strova Group"
  description="Data-driven search engine optimization, Google and Meta performance marketing, and conversion funnels engineered for measurable business return."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="ambient-glow-indigo" style="top: -120px; right: 5%; opacity: 0.6;"></div>
    <div class="ambient-glow-cyan" style="bottom: 20px; left: -80px; opacity: 0.4;"></div>
    <div class="container">
      <div class="page-hero__content">
        <div class="division-pill division-pill--digital">DIV-02 // STROVA DIGITAL</div>
        <h1 class="page-hero__title">
          Data-Driven Growth, Technical SEO &amp; <span class="gradient-text">High-Intent Leads</span>
        </h1>
        <p class="page-hero__lead">
          We treat digital marketing as an engineering discipline. We build reliable customer acquisition pipelines powered by programmatic search optimization, server-side attribution, and performance advertising focused on bottom-line revenue.
        </p>
        <div class="page-hero__actions">
          <a href="/contact/?service=digital" class="btn btn--primary btn--lg">
            Request Growth Audit
          </a>
          <a href="#services" class="btn btn--outline btn--lg">
            Explore Capabilities
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview (What it is, Who it is for, Price & Timeline) -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">What It Is</span>
            <p class="overview-item__val">Technical SEO remediation, paid performance media (Google Ads &amp; Meta Ads), programmatic conversion landing pages, and automated lead capture funnels.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Who It Is For</span>
            <p class="overview-item__val">Commercial enterprises, professional clinics and practices in India, and international brands looking for predictable ROAS and verifiable customer acquisition.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Starting Price Range</span>
            <p class="overview-item__val">Starting at ₹35,000 for technical SEO sprints &bull; ₹40,000/month for performance ads management &bull; ₹75,000/month for complete growth engine (USD on request).</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Typical Timeline</span>
            <p class="overview-item__val">2 to 4 weeks for initial audit &amp; CAPI tracking setup &bull; 8 to 12 weeks for keyword ranking compounding &bull; continuous bi-weekly sprint iterations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section" id="services" aria-labelledby="digital-services-title">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-kicker">Performance Engines</span>
        <h2 id="digital-services-title" class="section-title">Measurable Growth Systems</h2>
        <p class="section-subtitle">
          No vanity metrics. No buying fake followers. Every campaign is wired to verifiable pipeline revenue.
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Technical & Programmatic SEO -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3 class="capability-title">Technical &amp; Programmatic SEO</h3>
          <p class="capability-text">
            Search engines reward speed and structure. We audit and rebuild indexation architecture, eliminate Core Web Vitals bottlenecks (INP, LCP, CLS), implement rich JSON-LD schemas, and construct programmatic keyword hierarchies that capture commercial search intent.
          </p>
          <ul class="capability-features">
            <li><strong>Core Web Vitals:</strong> Sub-2.5s LCP &amp; zero layout shift</li>
            <li><strong>Structured Data:</strong> Full Schema.org graph markup for rich snippets</li>
            <li><strong>Crawl Efficiency:</strong> XML sitemaps, canonical tags, and internal link trees</li>
            <li><strong>Content Architecture:</strong> Topical cluster maps &amp; commercial search intent</li>
          </ul>
        </article>

        <!-- 2. Performance Advertising -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="capability-title">Paid Media &amp; ROAS Optimization</h3>
          <p class="capability-text">
            High-intent Google Search campaigns and Meta (Instagram/Facebook) advertising built on rigorous creative testing and strict Return on Ad Spend (ROAS) targets. We implement server-side tracking (Meta Conversions API) to bypass browser ad-blocker loss.
          </p>
          <ul class="capability-features">
            <li><strong>Channels:</strong> Google Search, Performance Max, Meta Ads, LinkedIn</li>
            <li><strong>Tracking:</strong> Server-side Conversions API (CAPI) &amp; GA4 event routing</li>
            <li><strong>Attribution:</strong> First-party UTM parameters and CRM revenue reconciliation</li>
            <li><strong>Testing:</strong> Systematic headline, angle, and audience matrix splits</li>
          </ul>
        </article>

        <!-- 3. Lead Generation Funnels -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="capability-title">Inbound Lead Generation Funnels</h3>
          <p class="capability-text">
            Traffic without conversion is overhead. We design dedicated, frictionless landing pages and interactive quote tools engineered for rapid form completion, verified phone capture, and instant WhatsApp webhook notification to your sales reps.
          </p>
          <ul class="capability-features">
            <li><strong>Landing Pages:</strong> Sub-second load times with zero distracting navigation</li>
            <li><strong>Form Architecture:</strong> Multi-step progressive disclosure &amp; mobile validation</li>
            <li><strong>CRM Routing:</strong> Instant webhook sync to HubSpot, Zoho, or Google Sheets</li>
            <li><strong>Spam Filters:</strong> Honeypot fields &amp; algorithmic bot filtration</li>
          </ul>
        </article>

        <!-- 4. Conversion Rate Optimization (CRO) -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="capability-title">CRO &amp; Analytics Instrumentation</h3>
          <p class="capability-text">
            We turn click data into revenue improvements. Through user session auditing, form abandonment analysis, and clean A/B split tests, we incrementally increase conversion rates across your primary commercial paths.
          </p>
          <ul class="capability-features">
            <li><strong>Audits:</strong> Scroll maps, drop-off heatmaps, and funnel drop analysis</li>
            <li><strong>A/B Testing:</strong> Statistical hypothesis testing of copy and layout</li>
            <li><strong>Privacy-First:</strong> Cookieless analytics setup compliant with DPDP Act &amp; GDPR</li>
            <li><strong>Reporting:</strong> Executive bi-weekly dashboards focused on cost-per-lead</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Growth Methodology -->
  <section class="section methodology-section" aria-labelledby="methodology-title">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-kicker">Process</span>
        <h2 id="methodology-title" class="section-title">The Three-Phase Growth Framework</h2>
        <p class="section-subtitle">
          How we systematically test, validate, and scale commercial client acquisition.
        </p>
      </div>

      <div class="methodology-grid">
        <div class="methodology-step">
          <div class="methodology-step__num">01</div>
          <h3 class="methodology-step__title">Infrastructure &amp; Baseline Audit</h3>
          <p class="methodology-step__text">
            We inspect pixel health, verify server-side CAPI event delivery, audit historical search performance, and map target customer search queries with high purchase intent.
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">02</div>
          <h3 class="methodology-step__title">Rapid Angle &amp; Creative Validation</h3>
          <p class="methodology-step__text">
            We launch targeted paid media tests across micro-budgets and deploy foundational technical SEO fixes. We establish concrete Cost-per-Acquisition (CPA) benchmarks.
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">03</div>
          <h3 class="methodology-step__title">Channel Scaling &amp; Attribution</h3>
          <p class="methodology-step__text">
            We scale winning ad angles, build programmatic content landing pages, and optimize conversion pathways to compound monthly lead volume at stable acquisition costs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Overview for Digital -->
  <section class="section" aria-labelledby="digital-pricing-title">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-kicker">Retainer Models</span>
        <h2 id="digital-pricing-title" class="section-title">Transparent Growth Engagements</h2>
        <p class="section-subtitle">
          Month-to-month contracts with no lock-in. Transparent monthly reporting on verifiable KPIs.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card pricing-compact">
          <span class="pricing-compact__tag">One-Time Project</span>
          <h3 class="pricing-compact__name">Technical SEO Sprint</h3>
          <div class="pricing-compact__price">Starting at ₹35,000 / $500</div>
          <p class="pricing-compact__desc">Comprehensive Core Web Vitals remediation, Schema.org graph deployment, sitemap repair, and keyword cluster blueprint.</p>
          <a href="/contact/?service=digital" class="btn btn--outline w-full">Request SEO Sprint</a>
        </div>
        <div class="card pricing-compact pricing-compact--highlight">
          <span class="pricing-compact__tag">Monthly Retainer</span>
          <h3 class="pricing-compact__name">Performance Ads Management</h3>
          <div class="pricing-compact__price">₹40,000/mo / $600 USD</div>
          <p class="pricing-compact__desc">Management of Google Search and Meta Ads campaigns. Includes server-side CAPI tracking, creative testing, and weekly reporting.</p>
          <a href="/contact/?service=digital" class="btn btn--primary w-full">Request Ad Retainer</a>
        </div>
        <div class="card pricing-compact">
          <span class="pricing-compact__tag">Full Pipeline</span>
          <h3 class="pricing-compact__name">Growth &amp; SEO Engine</h3>
          <div class="pricing-compact__price">₹75,000/mo / $1,100 USD</div>
          <p class="pricing-compact__desc">Integrated SEO, ad campaign management, dedicated conversion landing pages, and automated WhatsApp lead notifications.</p>
          <a href="/contact/?service=digital" class="btn btn--outline w-full">Request Full Engine</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Stop Wasting Budget on Unqualified Clicks?</h2>
          <p class="cta-desc">
            Let us audit your current search rankings, ad accounts, and conversion funnel. We will show you exact drop-off points within 48 hours.
          </p>
          <div class="cta-buttons">
            <a href="/contact/?service=digital" class="btn btn--primary btn--lg">
              Book a Growth Audit
            </a>
            <a href="/case-studies/" class="btn btn--outline btn--lg">
              View Architectural Case Studies
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .division-pill--digital {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(34, 211, 238, 0.12);
    color: var(--accent-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Capabilities */
  .capability-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .capability-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: rgba(34, 211, 238, 0.12);
    color: var(--accent-2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .capability-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .capability-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .capability-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .capability-features strong {
    color: var(--text-primary);
  }

  /* Methodology */
  .methodology-section {
    background: var(--bg-surface);
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 52rem) {
    .methodology-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .methodology-step {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .methodology-step__num {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--accent-2);
    margin-bottom: var(--space-4);
  }

  .methodology-step__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .methodology-step__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Compact Pricing */
  .pricing-compact {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
  }

  .pricing-compact--highlight {
    border-color: var(--accent-2);
  }

  .pricing-compact__tag {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-2);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .pricing-compact__name {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .pricing-compact__price {
    font-size: var(--text-lg);
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-color);
  }

  .pricing-compact__desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }

  .cta-section {
    padding-bottom: var(--space-24);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    color: var(--color-snow);
  }

  .cta-content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Service Overview */
  .service-overview-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .service-overview-card {
    padding: var(--space-8);
    background: var(--bg-surface);
  }

  .service-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .service-overview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .service-overview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .overview-item__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .overview-item__val {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
