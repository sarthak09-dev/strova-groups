---
/**
 * Digital Division Page (src/pages/digital.astro)
 *
 * Business websites, applications, commerce, and platforms in the Digital pillar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Digital — Strova Technology',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'Business websites, web applications, e-commerce, and custom digital platforms',
  description:
    'Digital services within Strova Technology: business websites and landing pages, web applications and customer portals, e-commerce solutions, and custom digital platforms.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Digital',
      item: 'https://strovagroups.in/digital/',
    },
  ],
};
---

<BaseLayout
  title="Digital Solutions | Strova Technology"
  description="Business websites, landing pages, web applications, customer portals, e-commerce, and custom digital platforms from Strova Technology."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">Strova Group / Strova Technology / Digital</span>
        <h1 class="page-hero__title">
          Digital experiences built around your business
        </h1>
        <p class="page-hero__lead">
          Strova Technology brings websites, applications, e-commerce, and custom platforms together in its Digital pillar. We shape each solution around the people who will use it and the work it needs to support.
        </p>
        <div class="page-hero__actions">
          <a href="/contact/?service=digital" class="btn btn--primary btn--lg">
            Discuss a digital project
          </a>
          <a href="#services" class="btn btn--outline btn--lg">
            Explore Capabilities
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview (What it is, Who it is for, Quotes & Timeline) -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">What It Is</span>
            <p class="overview-item__val">Business websites and landing pages, web applications and customer portals, e-commerce solutions, and custom digital platforms.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Who It Is For</span>
            <p class="overview-item__val">Organizations that need a clear, useful digital experience or a platform shaped around a validated business need.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">How Quotes Work</span>
            <p class="overview-item__val">Itemized written proposal delivered within 1 business day. Work starts upon written scope sign-off and 50% advance.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Typical Timeline</span>
            <p class="overview-item__val">Timing depends on the agreed scope, integrations, content, and review process. Milestones are documented in the proposal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services -->
  <section class="section" id="services" aria-labelledby="digital-services-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-services-title" class="section-title">Digital services</h2>
        <p class="section-subtitle">
          From a focused landing page to a custom platform, the scope starts with what your business and customers need.
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Business websites and landing pages -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              <line x1="11" y1="8" x2="11" y2="14"/>
              <line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </div>
          <h3 class="capability-title">Business websites &amp; landing pages</h3>
          <p class="capability-text">
            Clear, responsive websites and focused landing pages that explain your offer, guide visitors, and make the next step easy to find.
          </p>
          <ul class="capability-features">
            <li><strong>Responsive layouts:</strong> Designed for desktop, tablet, and mobile</li>
            <li><strong>Useful content:</strong> Clear information architecture and calls to action</li>
            <li><strong>Search foundations:</strong> Descriptive metadata and crawlable page structure</li>
            <li><strong>Accessible patterns:</strong> Semantic markup and keyboard-friendly controls</li>
          </ul>
        </article>

        <!-- 2. Performance Advertising -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <h3 class="capability-title">Web applications &amp; customer portals</h3>
          <p class="capability-text">
            Web applications and customer portals can bring information, requests, and useful workflows into one clear interface, with access and integrations defined for each project.
          </p>
          <ul class="capability-features">
            <li><strong>Purpose-built flows:</strong> Forms, dashboards, and task-specific interfaces</li>
            <li><strong>Account areas:</strong> Customer access and role-aware views where required</li>
            <li><strong>Integrations:</strong> Connect agreed data sources and business tools</li>
            <li><strong>Delivery:</strong> Scope, access rules, and handover documented up front</li>
          </ul>
        </article>

        <!-- 3. Lead Generation Funnels -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h3 class="capability-title">E-commerce solutions</h3>
          <p class="capability-text">
            E-commerce experiences help customers discover products, understand options, and complete a purchase through a storefront and checkout suited to the business.
          </p>
          <ul class="capability-features">
            <li><strong>Storefronts:</strong> Product discovery and clear product information</li>
            <li><strong>Commerce flows:</strong> Cart, checkout, and order journeys scoped to need</li>
            <li><strong>Integrations:</strong> Agreed payment, inventory, and fulfilment services</li>
            <li><strong>Responsive design:</strong> A consistent experience across screen sizes</li>
          </ul>
        </article>

        <!-- 4. Conversion Rate Optimization (CRO) -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="capability-title">Custom digital platforms</h3>
          <p class="capability-text">
            When an off-the-shelf tool does not fit, a custom platform can bring specific data, processes, or services together. Product scope follows validated customer and business needs.
          </p>
          <ul class="capability-features">
            <li><strong>Business logic:</strong> Workflows and rules captured in a written scope</li>
            <li><strong>Data models:</strong> Information structures designed for the product</li>
            <li><strong>Connected services:</strong> Third-party integrations selected for the project</li>
            <li><strong>Future growth:</strong> A maintainable foundation for agreed next steps</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Digital Project Process -->
  <section class="section methodology-section" aria-labelledby="methodology-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="methodology-title" class="section-title">From requirements to delivery</h2>
        <p class="section-subtitle">
          A clear process keeps the scope, decisions, and handover visible throughout the project.
        </p>
      </div>

      <div class="methodology-grid">
        <div class="methodology-step">
          <div class="methodology-step__num">01</div>
          <h3 class="methodology-step__title">Understand &amp; define</h3>
          <p class="methodology-step__text">
            We clarify the users, requirements, content, integrations, and constraints before proposing a solution.
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">02</div>
          <h3 class="methodology-step__title">Plan &amp; build</h3>
          <p class="methodology-step__text">
            We agree milestones and deliverables, then build and review the work in line with the written scope.
          </p>
        </div>
        <div class="methodology-step">
          <div class="methodology-step__num">03</div>
          <h3 class="methodology-step__title">Review &amp; hand over</h3>
          <p class="methodology-step__text">
            We review the agreed deliverables, address handover requirements, and document any ongoing support in the proposal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Digital Project Scope -->
  <section class="section" aria-labelledby="digital-pricing-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="digital-pricing-title" class="section-title">Project scope &amp; estimates</h2>
        <p class="section-subtitle">
          Requirements, integrations, and content affect the estimate. Your written proposal sets out the agreed scope, milestones, and commercial terms.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <span class="section-eyebrow">Step 1 &bull; Requirements</span>
          <h3 class="pillar-title">Define the work</h3>
          <p class="text-secondary text-sm">Clarify users, workflows, features, content, integrations, and constraints.</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">Step 2 &bull; Written Proposal</span>
          <h3 class="pillar-title">Written project proposal</h3>
          <p class="text-secondary text-sm">Review deliverables, milestones, timeline, and commercial terms before work begins.</p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">Step 3 &bull; Delivery</span>
          <h3 class="pillar-title">Review &amp; handover</h3>
          <p class="text-secondary text-sm">Review project milestones and confirm handover and support arrangements.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">Have a digital project in mind?</h2>
          <p class="cta-desc">
            Tell us what you are trying to build. We can discuss the requirements, likely scope, and a practical next step.
          </p>
          <div class="cta-buttons">
            <a href="/contact/?service=digital" class="btn btn--primary btn--lg">
              Discuss your project
            </a>
            <a href="/case-studies/" class="btn btn--outline btn--lg">
              View project approach
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .division-pill--digital {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(34, 211, 238, 0.12);
    color: var(--accent-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Capabilities */
  .capability-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .capability-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: rgba(34, 211, 238, 0.12);
    color: var(--accent-2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .capability-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .capability-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .capability-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .capability-features strong {
    color: var(--text-primary);
  }

  /* Methodology */
  .methodology-section {
    background: var(--bg-surface);
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 52rem) {
    .methodology-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .methodology-step {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .methodology-step__num {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--accent-2);
    margin-bottom: var(--space-4);
  }

  .methodology-step__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .methodology-step__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Compact Pricing */


  .w-full {
    width: 100%;
    justify-content: center;
  }

  .cta-section {
    padding-bottom: var(--space-24);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    color: var(--color-snow);
  }

  .cta-content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Service Overview */
  .service-overview-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .service-overview-card {
    padding: var(--space-8);
    background: var(--bg-surface);
  }

  .service-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .service-overview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .service-overview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .overview-item__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .overview-item__val {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }
</style>
