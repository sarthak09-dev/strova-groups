---
/**
 * Request a Quote / Contact Page (src/pages/contact.astro)
 *
 * Requirements:
 * - 3 Required fields: Name, Email, What you need (Message)
 * - 3 Optional fields: Company, Phone, Rough timeline
 * - Completable in under 60 seconds on mobile devices
 * - Real fail-closed submission via /api/contact (HTTP 503 if unconfigured)
 * - Cloudflare Turnstile bot protection + invisible honeypot
 * - Confirmation redirect to /quote/confirmed/
 * - Cookieless analytics events: quote_form_started, quote_form_submitted
 * - Direct communication: info@strovagroups.in, +91 92880 77802 (Call & WhatsApp)
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Request a Quote — Strova Group',
  description:
    'Request a written fixed-scope quote from Strova Group. We review all specifications and reply within 1 business day.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
    email: 'info@strovagroups.in',
    telephone: '+919288077802',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'info@strovagroups.in',
      telephone: '+919288077802',
      availableLanguage: ['en', 'hi'],
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '10:00',
        closes: '19:00',
      },
    },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Request a Quote',
      item: 'https://strovagroups.in/contact/',
    },
  ],
};

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const isTurnstileConfigured = Boolean(turnstileSiteKey);
---

<BaseLayout
  title="Request a Quote — Strova Group"
  description="Request a written fixed-scope quote from Strova Group. Under 60 seconds mobile form, 1 business day reply, 0 hidden costs."
  jsonLd={[contactPageJsonLd, breadcrumbJsonLd]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">Project Inbound</span>
        <h1 class="page-hero__title">
          Request a Written Fixed Quote
        </h1>
        <p class="page-hero__lead">
          Tell us about your project goals. We review requirements with direct founder oversight and reply with an itemized, fixed quote within 1 business day.
        </p>
      </div>
    </div>
  </section>

  <!-- Quote Form & Direct Channels Grid -->
  <section class="section" aria-labelledby="contact-form-heading">
    <div class="container">
      <div class="contact-grid">
        <!-- Inbound Form Card -->
        <div class="contact-form-card card">
          <div class="form-header">
            <h2 id="contact-form-heading" class="form-title">Project Quote Form</h2>
            <p class="form-subtitle text-sm text-secondary">
              Three required fields. Takes under 60 seconds on mobile.
            </p>
          </div>

          <form id="contact-form" class="inbound-form" novalidate>
            <!-- Honeypot Field -->
            <div class="hp-field" aria-hidden="true">
              <label for="hp_company">Do not fill this field if you are human</label>
              <input type="text" id="hp_company" name="_hp_company" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Required 1: Full Name -->
            <div class="form-group">
              <label for="contact-name" class="form-label">
                Full Name <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                class="form-input"
                placeholder="Your name"
                aria-required="true"
              />
              <span class="form-error" id="name-error" role="alert"></span>
            </div>

            <!-- Required 2: Email -->
            <div class="form-group">
              <label for="contact-email" class="form-label">
                Email Address <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                class="form-input"
                placeholder="name@company.com"
                aria-required="true"
              />
              <span class="form-error" id="email-error" role="alert"></span>
            </div>

            <!-- Optional 1 & 2: Company & Phone -->
            <div class="form-row">
              <div class="form-group">
                <label for="contact-company" class="form-label">
                  Company / Organization <span class="optional">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="contact-company"
                  name="company"
                  class="form-input"
                  placeholder="e.g. Acme Health or D2C Brand"
                />
              </div>

              <div class="form-group">
                <label for="contact-phone" class="form-label">
                  Phone / WhatsApp <span class="optional">(Optional)</span>
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  class="form-input"
                  placeholder="+91 92880 77802"
                />
              </div>
            </div>

            <!-- Optional 3 & 4: Location/Timezone & Rough Timeline -->
            <div class="form-row">
              <div class="form-group">
                <label for="contact-timezone" class="form-label">
                  Country / Timezone <span class="optional">(Optional)</span>
                </label>
                <select id="contact-timezone" name="timezone" class="form-select">
                  <option value="" selected>Select your region / timezone...</option>
                  <option value="IN-IST">India (IST • UTC+5:30)</option>
                  <option value="US-EST">North America — Eastern (EST/EDT)</option>
                  <option value="US-CST">North America — Central (CST/CDT)</option>
                  <option value="US-PST">North America — Pacific (PST/PDT)</option>
                  <option value="UK-GMT">United Kingdom / Europe (GMT/BST/CET)</option>
                  <option value="UAE-GST">Middle East / Gulf (GST • UTC+4)</option>
                  <option value="SG-SGT">Singapore / Southeast Asia (SGT • UTC+8)</option>
                  <option value="AU-AEST">Australia / New Zealand (AEST/NZST)</option>
                  <option value="OTHER">Other international timezone</option>
                </select>
              </div>

              <div class="form-group">
                <label for="contact-timeline" class="form-label">
                  Rough Timeline <span class="optional">(Optional)</span>
                </label>
                <select id="contact-timeline" name="timeline" class="form-select">
                  <option value="" selected>Select a rough timeline...</option>
                  <option value="2-4-weeks">Within 2–4 weeks (High urgency)</option>
                  <option value="1-2-months">1–2 months (Standard sprint)</option>
                  <option value="3-plus-months">3+ months (Longer runway)</option>
                  <option value="flexible">Flexible / Exploring feasibility</option>
                </select>
              </div>
            </div>

            <!-- Required 3: What You Need (Message) -->
            <div class="form-group">
              <label for="contact-message" class="form-label">
                What You Need <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                class="form-textarea"
                placeholder="Tell us what you want to build, who it is for, or current operational bottlenecks..."
                aria-required="true"
              ></textarea>
              <span class="form-error" id="message-error" role="alert"></span>
            </div>

            <!-- Cloudflare Turnstile Bot Protection Widget -->
            <input type="hidden" name="lang" value="en" />
            <div class="form-group turnstile-container">
              {isTurnstileConfigured ? (
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-theme="light"
                  data-size="flexible"
                ></div>
              ) : (
                <p class="text-xs text-muted" style="margin: 0; line-height: 1.5;">
                  Verification active on submission. Prefer direct contact? Email <a href="mailto:info@strovagroups.in">info@strovagroups.in</a> or WhatsApp <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">+91 92880 77802</a>.
                </p>
              )}
              <span class="form-error" id="turnstile-error" role="alert"></span>
            </div>

            <!-- Submit Button -->
            <div class="form-actions">
              <button type="submit" id="submit-btn" class="btn btn--primary btn--lg w-full">
                <span>Request Your Quote &rarr;</span>
              </button>
            </div>

            <!-- Dynamic Form Status Box -->
            <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
          </form>
        </div>

        <!-- Direct Channels Sidebar -->
        <div class="contact-channels">
          <!-- 1-Day Response Guarantee -->
          <div class="channel-card card card--quiet">
            <span class="section-eyebrow">Our Commitment</span>
            <h3 class="channel-title">1 Business Day Response</h3>
            <p class="channel-desc text-secondary text-sm">
              We review every brief directly. You receive an itemized proposal with clear deliverables, milestones, and fixed pricing terms within 24 business hours.
            </p>
          </div>

          <!-- Direct WhatsApp -->
          <div class="channel-card card">
            <h3 class="channel-title">Chat on WhatsApp</h3>
            <p class="channel-desc text-secondary text-sm">
              Prefer immediate real-time chat? Reach our engineering team directly on WhatsApp.
            </p>
            <a
              href="https://wa.me/919288077802"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--whatsapp w-full"
              data-track="whatsapp_click"
            >
              Message +91 92880 77802 &rarr;
            </a>
          </div>

          <!-- Direct Email -->
          <div class="channel-card card">
            <h3 class="channel-title">Direct Email</h3>
            <p class="channel-desc text-secondary text-sm">
              Have existing architecture diagrams, RFPs, or product briefs? Send them to our central inbox.
            </p>
            <a
              href="mailto:info@strovagroups.in"
              class="btn btn--outline w-full"
              data-track="email_click"
            >
              info@strovagroups.in &rarr;
            </a>
          </div>

          <!-- Global & Remote Collaboration -->
          <div class="channel-card card card--quiet">
            <span class="section-eyebrow">International Clients</span>
            <h3 class="channel-title">Global Remote Delivery</h3>
            <p class="channel-desc text-secondary text-sm" style="line-height: 1.6;">
              We partner with businesses worldwide. Asynchronous daily updates via Client Hub and Slack, scheduled video reviews across EST, GMT, and GST timezones. Commercial invoicing in INR or USD on request.
            </p>
          </div>

          <!-- Corporate Details -->
          <div class="channel-card card card--quiet">
            <span class="section-eyebrow">Official Registry</span>
            <p class="text-xs text-muted" style="line-height: 1.6;">
              <strong>Strova Group</strong> is a proprietorship of Babita Kumari.<br/>
              MSME Registration: UDYAM-JH-20-0147452<br/>
              Hours: Mon–Sat, 10:00 AM – 7:00 PM IST
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    let hasStartedForm = false;

    // Track quote_form_started on first field focus
    const inputElements = form.querySelectorAll('input, textarea, select');
    inputElements.forEach((el) => {
      el.addEventListener('focus', () => {
        if (!hasStartedForm) {
          hasStartedForm = true;
          try {
            window.dispatchEvent(
              new CustomEvent('strova:analytics', {
                detail: { event: 'quote_form_started', timestamp: Date.now() },
              })
            );
          } catch {}
        }
      }, { once: true });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      let hasErrors = false;
      let firstInvalid: HTMLElement | null = null;

      // Clear previous error states
      form.querySelectorAll('.form-error').forEach((el) => {
        el.textContent = '';
        el.classList.remove('visible');
      });
      form.querySelectorAll('[aria-invalid="true"]').forEach((el) => {
        el.removeAttribute('aria-invalid');
      });

      const statusBox = document.getElementById('form-status') as HTMLElement;
      statusBox.className = 'form-status';
      statusBox.innerHTML = '';

      function markError(fieldId: string, errorId: string, message: string) {
        const field = document.getElementById(fieldId) as HTMLElement | null;
        const error = document.getElementById(errorId);
        if (field) {
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', errorId);
          if (!firstInvalid) firstInvalid = field;
        }
        if (error) {
          error.textContent = message;
          error.classList.add('visible');
        }
        hasErrors = true;
      }

      // 1. Honeypot check
      const hpField = document.getElementById('hp_company') as HTMLInputElement | null;
      if (hpField && hpField.value.trim() !== '') {
        statusBox.className = 'form-status error';
        statusBox.textContent = 'Submission rejected by anti-spam filter.';
        return;
      }

      // 2. Client-side field validations
      const nameField = document.getElementById('contact-name') as HTMLInputElement;
      if (!nameField.value.trim() || nameField.value.trim().length < 2) {
        markError('contact-name', 'name-error', 'Please enter your full name (at least 2 characters).');
      }

      const emailField = document.getElementById('contact-email') as HTMLInputElement;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailField.value.trim() || !emailRegex.test(emailField.value.trim())) {
        markError('contact-email', 'email-error', 'Please enter a valid business email address.');
      }

      const messageField = document.getElementById('contact-message') as HTMLTextAreaElement;
      if (!messageField.value.trim() || messageField.value.trim().length < 10) {
        markError('contact-message', 'message-error', 'Please describe your project requirements (at least 10 characters).');
      }

      if (hasErrors) {
        statusBox.className = 'form-status error';
        statusBox.textContent = 'Please fill out the highlighted fields above.';
        firstInvalid?.focus();
        return;
      }

      // Submit form payload to serverless endpoint
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Submitting request...</span>';

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = typeof value === 'string' ? value : value.name;
      });

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.success) {
          // Trigger analytics event
          try {
            window.dispatchEvent(
              new CustomEvent('strova:analytics', {
                detail: { event: 'quote_form_submitted', timestamp: Date.now() },
              })
            );
          } catch {}

          // Navigate to confirmation page
          window.location.href = result.redirectUrl || '/quote/confirmed/';
        } else {
          // Fail-closed error display (never fake success)
          const errDetail = result.error || 'Unable to submit your quote request at this time.';
          statusBox.className = 'form-status error';
          statusBox.innerHTML = `${errDetail}<br/>Please email us directly at <a href="mailto:info@strovagroups.in">info@strovagroups.in</a> or message us on WhatsApp at <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">+91 92880 77802</a>.`;
        }
      } catch (networkErr) {
        statusBox.className = 'form-status error';
        statusBox.innerHTML = `Network error. Please email your project requirements to <a href="mailto:info@strovagroups.in">info@strovagroups.in</a> or WhatsApp <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">+91 92880 77802</a>.`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>

<style>
  .page-hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-12);
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-hero__title {
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .page-hero__lead {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: 1.35fr 0.65fr;
      gap: var(--space-10);
    }
  }

  .contact-form-card {
    padding: var(--space-8);
  }

  .form-header {
    margin-bottom: var(--space-6);
  }

  .form-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .inbound-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 36rem) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #DC2626;
  }

  .optional {
    color: var(--text-muted);
    font-weight: normal;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font-size: var(--text-sm);
    font-family: var(--font-body);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .form-error {
    font-size: var(--text-xs);
    color: #DC2626;
    display: none;
    margin-top: 2px;
  }

  .form-error.visible {
    display: block;
  }

  .form-actions {
    margin-top: var(--space-2);
  }

  .form-status {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.5;
    display: none;
  }

  .form-status.error {
    display: block;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.3);
    color: #DC2626;
  }

  .form-status.success {
    display: block;
    background: rgba(22, 163, 74, 0.08);
    border: 1px solid rgba(22, 163, 74, 0.3);
    color: #16A34A;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .channel-card {
    padding: var(--space-6);
  }

  .channel-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }

  .channel-desc {
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }
</style>
