---
/**
 * Contact Page (src/pages/contact.astro)
 *
 * Requirements:
 * - Real form delivery via serverless endpoint (/api/contact)
 * - Cloudflare Turnstile bot verification + invisible honeypot
 * - Strict 2xx confirmation before showing success
 * - Actionable email & WhatsApp fallbacks on any submission error
 * - Direct contact info: email, WhatsApp link, telephone, IST business hours
 * - ContactPage & BreadcrumbList JSON-LD schemas without unsupplied placeholders
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const contactPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Strova Group',
  description:
    'Get in touch with Strova Group for software engineering, Android development, AI automation, and digital growth inquiries.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
    email: 'info@strovagroups.in',
    telephone: '+919288077802',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      email: 'info@strovagroups.in',
      telephone: '+919288077802',
      availableLanguage: ['en', 'hi'],
      hoursAvailable: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '10:00',
        closes: '19:00',
      },
    },
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact',
      item: 'https://strovagroups.in/contact/',
    },
  ],
};

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<BaseLayout
  title="Contact Strova Group — Start Your Project Inbound"
  description="Connect directly with Strova Group. Submit your project requirements or message on WhatsApp for a technical review within 24 business hours."
  jsonLd={[contactPageJsonLd, breadcrumbJsonLd]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="ambient-glow-indigo" style="top: -120px; right: 5%; opacity: 0.6;"></div>
    <div class="ambient-glow-cyan" style="bottom: 20px; left: -80px; opacity: 0.4;"></div>
    <div class="container">
      <div class="page-hero__content">
        <h1 class="page-hero__title">
          Discuss Your Project With <span class="gradient-text">Strova Group</span>
        </h1>
        <p class="page-hero__lead">
          We answer inquiries with technical clarity. You will receive an architectural review and transparent timeline estimate within 24 business hours.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form & Direct Channels Grid -->
  <section class="section" aria-labelledby="contact-form-heading">
    <div class="container">
      <div class="contact-grid">
        <!-- Inbound Form Card -->
        <div class="contact-form-card">
          <div class="form-header">
            <h2 id="contact-form-heading" class="form-title">Send a Project Brief</h2>
            <p class="form-subtitle">
              Fill out the details below. All project briefs are treated under strict mutual confidentiality.
            </p>
          </div>

          <form id="contact-form" class="inbound-form" novalidate>
            <!-- Honeypot Field (Hidden from human users, catches automated bots) -->
            <div class="hp-field" aria-hidden="true">
              <label for="hp_company">Do not fill this field if you are human</label>
              <input type="text" id="hp_company" name="_hp_company" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Name -->
            <div class="form-group">
              <label for="contact-name" class="form-label">
                Full Name <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                class="form-input"
                placeholder="e.g. Rahul Sharma or Jane Doe"
                aria-required="true"
              />
              <span class="form-error" id="name-error" role="alert"></span>
            </div>

            <!-- Email & Phone Grid -->
            <div class="form-row">
              <div class="form-group">
                <label for="contact-email" class="form-label">
                  Business Email <span class="required" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  class="form-input"
                  placeholder="name@company.com"
                  aria-required="true"
                />
                <span class="form-error" id="email-error" role="alert"></span>
              </div>

              <div class="form-group">
                <label for="contact-phone" class="form-label">
                  Phone / WhatsApp <span class="optional">(Optional)</span>
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  class="form-input"
                  placeholder="+91 92880 77802"
                />
                <span class="form-error" id="phone-error" role="alert"></span>
              </div>
            </div>

            <!-- Company & Primary Service Selection -->
            <div class="form-row">
              <div class="form-group">
                <label for="contact-company" class="form-label">
                  Company / Organization <span class="optional">(Optional)</span>
                </label>
                <input
                  type="text"
                  id="contact-company"
                  name="company"
                  class="form-input"
                  placeholder="e.g. Acme Health or D2C Brands"
                />
              </div>

              <div class="form-group">
                <label for="contact-service" class="form-label">
                  Primary Service Interest <span class="required" aria-hidden="true">*</span>
                </label>
                <select id="contact-service" name="service" required class="form-select" aria-required="true">
                  <option value="" disabled selected>Select a primary capability...</option>
                  <option value="technologies">Strova Technologies — Custom Web &amp; SaaS Platforms</option>
                  <option value="automation">Strova Technologies — WhatsApp Cloud API &amp; AI Automations</option>
                  <option value="mobile">Strova Technologies — Native Android Development</option>
                  <option value="digital">Strova Digital — Technical SEO &amp; Growth Ads</option>
                  <option value="commerce">Strova Commerce — Headless Retail (Coming Soon)</option>
                  <option value="other">General Engineering / Architectural Consultation</option>
                </select>
                <span class="form-error" id="service-error" role="alert"></span>
              </div>
            </div>

            <!-- Budget Range -->
            <div class="form-group">
              <label for="contact-budget" class="form-label">
                Estimated Project Scope / Budget <span class="optional">(Optional)</span>
              </label>
              <select id="contact-budget" name="budget" class="form-select">
                <option value="" selected>Select budget range...</option>
                <option value="inr_35k_75k">₹35,000 – ₹75,000 INR (Automation / Sprints)</option>
                <option value="inr_75k_150k">₹75,000 – ₹1,50,000 INR (Web Platform)</option>
                <option value="inr_150k_plus">₹1,50,000+ INR (Custom SaaS / Android App)</option>
                <option value="usd_intl">International Engagement (USD / EUR / GBP)</option>
                <option value="undecided">Flexible / Scope to be determined</option>
              </select>
            </div>

            <!-- Message / Requirements -->
            <div class="form-group">
              <label for="contact-message" class="form-label">
                Project Scope &amp; Functional Requirements <span class="required" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                class="form-textarea"
                placeholder="Describe your current bottleneck, target timeline, technical requirements, or key integration points..."
                aria-required="true"
              ></textarea>
              <span class="form-error" id="message-error" role="alert"></span>
            </div>

            <!-- Cloudflare Turnstile Bot Protection Widget -->
            <div class="form-group turnstile-container">
              <div
                class="cf-turnstile"
                data-sitekey={turnstileSiteKey}
                data-theme="auto"
                data-size="flexible"
              ></div>
              <span class="form-error" id="turnstile-error" role="alert"></span>
            </div>

            <!-- Submit Button -->
            <div class="form-actions">
              <button type="submit" id="submit-btn" class="btn btn--primary btn--lg w-full">
                <span>Submit Project Inquiry</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </div>

            <!-- Dynamic Form Status Box -->
            <div id="form-status" class="form-status" role="status" aria-live="polite"></div>
          </form>
        </div>

        <!-- Direct Communication Channels Sidebar -->
        <div class="contact-channels">
          <!-- 24-Hour Response Guarantee -->
          <div class="channel-card guarantee-card">
            <div class="guarantee-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <h3 class="guarantee-title">24 Business Hours Response SLA</h3>
              <p class="guarantee-desc">
                Every inbound inquiry receives a technical assessment directly from our engineering team. We do not use third-party sales qualification agents.
              </p>
            </div>
          </div>

          <!-- Direct Channels -->
          <div class="channel-card">
            <h3 class="channel-title">Direct Inquiries</h3>
            <div class="channel-list">
              <div class="channel-item">
                <div class="channel-item__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div>
                  <span class="channel-item__label">Official Email</span>
                  <a href="mailto:info@strovagroups.in" class="channel-item__link">info@strovagroups.in</a>
                </div>
              </div>

              <div class="channel-item">
                <div class="channel-item__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div>
                  <span class="channel-item__label">Direct Telephone (Click-to-Call)</span>
                  <a href="tel:+919288077802" class="channel-item__link">+91 92880 77802</a>
                </div>
              </div>

              <div class="channel-item">
                <div class="channel-item__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                  </svg>
                </div>
                <div>
                  <span class="channel-item__label">WhatsApp Business</span>
                  <a
                    href="https://wa.me/919288077802?text=Hi%20Strova%20Group%2C%20I%20would%20like%20to%20discuss%20a%20project"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="channel-item__link"
                  >
                    Chat on WhatsApp (+91 92880 77802)
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Business Operating Information -->
          <div class="channel-card">
            <h3 class="channel-title">Business Information</h3>
            <div class="corporate-details">
              <p>
                <strong>Strova Group</strong><br/>
                Technology and digital services firm operating from India.
              </p>
              <p class="text-sm text-secondary">
                <strong>Business Operating Hours:</strong><br/>
                Monday – Saturday: 10:00 AM – 7:00 PM IST (UTC+05:30)<br/>
                Sunday: Closed
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Cloudflare Turnstile script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Contact Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: flex-start;
  }

  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: var(--space-12);
    }
  }

  /* Form Card */
  .contact-form-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  @media (min-width: 40rem) {
    .contact-form-card {
      padding: var(--space-10);
    }
  }

  .form-header {
    margin-bottom: var(--space-8);
  }

  .form-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .form-subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .inbound-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .hp-field {
    display: none !important;
    position: absolute;
    left: -9999px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #dc2626;
  }

  .optional {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 400;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: var(--text-sm);
    transition: border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--accent);
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .form-error {
    font-size: var(--text-xs);
    color: #dc2626;
    min-height: 1rem;
    display: none;
  }

  .form-error.visible {
    display: block;
  }

  .turnstile-container {
    min-height: 65px;
  }

  .w-full {
    width: 100%;
    justify-content: center;
  }

  .form-status {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.6;
    display: none;
  }

  .form-status.success {
    display: block;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid #059669;
    color: #065f46;
  }

  :root[data-theme="dark"] .form-status.success,
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .form-status.success {
      background: rgba(16, 185, 129, 0.18);
      border-color: #10b981;
      color: #34d399;
    }
  }

  .form-status.error {
    display: block;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid #dc2626;
    color: #991b1b;
  }

  :root[data-theme="dark"] .form-status.error,
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .form-status.error {
      background: rgba(239, 68, 68, 0.2);
      border-color: #ef4444;
      color: #f87171;
    }
  }

  .form-status a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
  }

  /* Channels Sidebar */
  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .channel-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .guarantee-card {
    display: flex;
    gap: var(--space-4);
    background: var(--accent-subtle);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .guarantee-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .guarantee-title {
    font-size: var(--text-base);
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .guarantee-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .channel-title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-color);
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .channel-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .channel-item__icon {
    color: var(--accent);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .channel-item__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .channel-item__link {
    font-size: var(--text-sm);
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .channel-item__link:hover {
    text-decoration: underline;
  }

  .corporate-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .corporate-details p {
    margin: 0;
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    // Pre-populate service category if query param exists
    const urlParams = new URLSearchParams(window.location.search);
    const serviceParam = urlParams.get('service');
    if (serviceParam) {
      const serviceSelect = document.getElementById('contact-service') as HTMLSelectElement | null;
      if (serviceSelect) {
        if (['technologies', 'automation', 'mobile', 'digital', 'commerce', 'other'].includes(serviceParam)) {
          serviceSelect.value = serviceParam;
        }
      }
    }

    // Real-time error clearance on input
    const inputs = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') {
          input.removeAttribute('aria-invalid');
          const errorId = input.getAttribute('aria-describedby');
          if (errorId) {
            const errorEl = document.getElementById(errorId);
            if (errorEl) {
              errorEl.textContent = '';
              errorEl.classList.remove('visible');
            }
          }
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      let hasErrors = false;
      let firstInvalid: HTMLElement | null = null;

      // Clear existing errors
      document.querySelectorAll('.form-error').forEach((el) => {
        el.textContent = '';
        el.classList.remove('visible');
      });
      inputs.forEach((input) => input.removeAttribute('aria-invalid'));

      const statusBox = document.getElementById('form-status') as HTMLElement;
      statusBox.className = 'form-status';
      statusBox.innerHTML = '';

      function markError(fieldId: string, errorId: string, message: string) {
        const field = document.getElementById(fieldId) as HTMLElement | null;
        const error = document.getElementById(errorId);
        if (field) {
          field.setAttribute('aria-invalid', 'true');
          field.setAttribute('aria-describedby', errorId);
          if (!firstInvalid) firstInvalid = field;
        }
        if (error) {
          error.textContent = message;
          error.classList.add('visible');
        }
        hasErrors = true;
      }

      // 1. Honeypot check (reject bot submissions silently or with error)
      const hpField = document.getElementById('hp_company') as HTMLInputElement | null;
      if (hpField && hpField.value.trim() !== '') {
        statusBox.className = 'form-status error';
        statusBox.textContent = 'Submission rejected by anti-spam filter.';
        return;
      }

      // 2. Client-side field validations
      const nameField = document.getElementById('contact-name') as HTMLInputElement;
      if (!nameField.value.trim() || nameField.value.trim().length < 2) {
        markError('contact-name', 'name-error', 'Please enter your full name (at least 2 characters).');
      }

      const emailField = document.getElementById('contact-email') as HTMLInputElement;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailField.value.trim() || !emailRegex.test(emailField.value.trim())) {
        markError('contact-email', 'email-error', 'Please enter a valid business email address.');
      }

      const serviceField = document.getElementById('contact-service') as HTMLSelectElement;
      if (!serviceField.value) {
        markError('contact-service', 'service-error', 'Please select a primary service category.');
      }

      const messageField = document.getElementById('contact-message') as HTMLTextAreaElement;
      if (!messageField.value.trim() || messageField.value.trim().length < 10) {
        markError('contact-message', 'message-error', 'Please provide at least 10 characters describing your project requirements.');
      }

      if (hasErrors) {
        statusBox.className = 'form-status error';
        statusBox.textContent = 'Please correct the highlighted fields above before submitting.';
        firstInvalid?.focus();
        return;
      }

      // Submit form payload for real to server endpoint
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Sending inquiry...</span>';

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = typeof value === 'string' ? value : value.name;
      });

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && (result.success !== false)) {
          // Confirmed 2xx response
          statusBox.className = 'form-status success';
          statusBox.textContent = result.message || 'Thank you! Your project brief has been received. We review all inquiries within 24 business hours (Mon–Sat, 10:00 AM – 7:00 PM IST) and will email our technical assessment.';
          form.reset();
          // Reset Turnstile if available
          if ((window as any).turnstile) {
            (window as any).turnstile.reset();
          }
        } else {
          // Confirmed failure
          const errDetail = result.error || 'Unable to submit your message at this time.';
          statusBox.className = 'form-status error';
          statusBox.innerHTML = `${errDetail} Please email us directly at <a href="mailto:info@strovagroups.in">info@strovagroups.in</a> or message us on WhatsApp at <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">+91 92880 77802</a>.`;
        }
      } catch (networkErr) {
        // Network or fetch failure
        statusBox.className = 'form-status error';
        statusBox.innerHTML = `Network connection error. Please email us directly at <a href="mailto:info@strovagroups.in">info@strovagroups.in</a> or message us on WhatsApp at <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer">+91 92880 77802</a>.`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
</script>
