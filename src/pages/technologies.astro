---
/**
 * Technologies Division Page (src/pages/technologies.astro)
 *
 * Division: Strova Technologies
 * Focus: High-performance websites, Android apps, custom SaaS, AI & WhatsApp automation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Strova Technologies — Custom Software & AI Engineering',
  provider: {
    '@type': 'Organization',
    name: 'Strova Group',
    url: 'https://strovagroups.in',
  },
  serviceType: 'Software Development and AI Automation',
  areaServed: ['IN', 'US', 'GB', 'AE', 'EU'],
  description:
    'Engineering custom web platforms, native Android applications, multi-tenant SaaS dashboards, and production WhatsApp Cloud API automation workflows.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://strovagroups.in/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Technologies',
      item: 'https://strovagroups.in/technologies/',
    },
  ],
};
---

<BaseLayout
  title="Strova Technologies — Web, Apps & AI | Strova Group"
  description="High-performance websites, native Android applications, multi-tenant SaaS systems, and production WhatsApp AI workflows engineered by Strova Technologies."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <!-- Division Header -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content">
        <span class="section-eyebrow">Division 01 // Strova Technologies</span>
        <h1 class="page-hero__title">
          Custom Software, Modern Mobile &amp; Practical Automation
        </h1>
        <p class="page-hero__lead">
          We engineer robust digital infrastructure. From sub-second static web platforms to native Android applications and WhatsApp workflow automations that eliminate operational overhead.
        </p>
        <div class="page-hero__actions">
          <a href="/contact/?service=technologies" class="btn btn--primary btn--lg">
            Request an engineering quote
          </a>
          <a href="#offerings" class="btn btn--outline btn--lg">
            Review service architecture &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Specification Overview (What it is, Who it is for, Quotes & Timeline) -->
  <section class="section service-overview-section" aria-label="Division Overview">
    <div class="container">
      <div class="card service-overview-card">
        <div class="service-overview-grid">
          <div class="overview-item">
            <span class="overview-item__label">What It Is</span>
            <p class="overview-item__val">Production web platforms, native Android applications, multi-tenant SaaS systems, and official Meta WhatsApp Cloud API automation workflows.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Who It Is For</span>
            <p class="overview-item__val">Commercial businesses, healthcare clinics, fast-growing startups, and enterprises seeking robust digital infrastructure without proprietary platform lock-in.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">How Quotes Work</span>
            <p class="overview-item__val">Itemized fixed-scope written quote delivered within 1 business day. Work starts upon written scope sign-off and 50% advance.</p>
          </div>
          <div class="overview-item">
            <span class="overview-item__label">Typical Timeline</span>
            <p class="overview-item__val">2 to 4 weeks for WhatsApp automations &bull; 4 to 6 weeks for custom web applications &bull; 8 to 12 weeks for production SaaS portals &amp; Android MVPs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Engineering Capabilities -->
  <section class="section" id="offerings" aria-labelledby="offerings-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="offerings-title" class="section-title">What We Build &amp; How We Build It</h2>
        <p class="section-subtitle">
          Engineered for fault tolerance, strict security, and clean developer handover.
        </p>
      </div>

      <div class="grid grid--2 capability-grid">
        <!-- 1. Web Architecture -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h3 class="capability-title">High-Performance Web Platforms</h3>
          <p class="capability-text">
            We abandon heavy monolithic CMS architectures in favor of static-first generation (Astro) and hybrid edge-rendered solutions. This yields sub-second Time-to-First-Byte, near-perfect Core Web Vitals, and near-zero server maintenance costs.
          </p>
          <ul class="capability-features">
            <li><strong>Frameworks:</strong> Astro, Next.js, TypeScript, Tailwind CSS</li>
            <li><strong>Performance:</strong> 95+ Mobile Lighthouse target scores</li>
            <li><strong>Accessibility:</strong> WCAG 2.2 AA compliant markup</li>
            <li><strong>Edge Deployment:</strong> Cloudflare Pages &amp; Vercel caching</li>
          </ul>
        </article>

        <!-- 2. Android Apps -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
              <line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3 class="capability-title">Native &amp; Cross-Platform Android</h3>
          <p class="capability-text">
            Native Android applications built with Kotlin and Jetpack Compose. Tailored for consumer ease and field operations requiring offline data persistence, hardware sensor interaction, and strict memory efficiency.
          </p>
          <ul class="capability-features">
            <li><strong>Core:</strong> Kotlin, Jetpack Compose, Coroutines, Flow</li>
            <li><strong>Offline Sync:</strong> SQLite / Room database with automatic queueing</li>
            <li><strong>Compliance:</strong> Google Play Store policies &amp; Android 14+ standards</li>
            <li><strong>APIs:</strong> Biometric authentication, Bluetooth, and camera feeds</li>
          </ul>
        </article>

        <!-- 3. Custom SaaS & Dashboards -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <h3 class="capability-title">Custom SaaS &amp; Internal Dashboards</h3>
          <p class="capability-text">
            Operational portals, role-based client dashboards, and custom business management software designed around your specific relational data models. No generic templates that force you to adapt your workflow.
          </p>
          <ul class="capability-features">
            <li><strong>Stack:</strong> Node.js, Python, PostgreSQL, Redis, Docker</li>
            <li><strong>Auth &amp; Security:</strong> Role-Based Access Control (RBAC), JWT / session tokens</li>
            <li><strong>Real-Time:</strong> WebSockets, server-sent events, real-time KPI dashboards</li>
            <li><strong>Integrations:</strong> Razorpay, Stripe, AWS S3, Cloudflare R2</li>
          </ul>
        </article>

        <!-- 4. WhatsApp & AI Automation -->
        <article class="card capability-card">
          <div class="capability-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </div>
          <h3 class="capability-title">WhatsApp Business &amp; AI Agents</h3>
          <p class="capability-text">
            Transform customer conversations into automated business actions. We integrate the official Meta Cloud API with enterprise webhooks and tailored LLMs to triage support, qualify leads, and push data directly into your CRM.
          </p>
          <ul class="capability-features">
            <li><strong>Official API:</strong> Verified Meta Business Manager &amp; WhatsApp Cloud API</li>
            <li><strong>Lead Capture:</strong> Dynamic interactive message templates &amp; quick replies</li>
            <li><strong>LLM Triage:</strong> Context-grounded FAQ answering &amp; human escalation</li>
            <li><strong>Sync:</strong> Direct webhook connections to Zoho, HubSpot, ERP, or Sheets</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Focused Industry Solutions -->
  <section class="section industry-solutions-section" aria-labelledby="industry-solutions-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="industry-solutions-title" class="section-title">Engineered for Specific Commercial Workflows</h2>
        <p class="section-subtitle">
          Direct answers and purpose-built software architectures for real business searches and operational pain points.
        </p>
      </div>

      <div class="grid grid--2">
        <article class="card solution-card">
          <div class="solution-card__badge">HEALTHCARE &amp; LOCAL SERVICES</div>
          <h3 class="solution-card__title">Website Development for Clinics in India</h3>
          <p class="solution-card__desc">
            When patients search for specialists or diagnostic tests, every millisecond counts. We engineer ultra-fast, mobile-first web platforms for dental clinics, diagnostic centers, and multi-speciality medical practices across India.
          </p>
          <ul class="solution-card__list">
            <li><strong>Instant Mobile Access:</strong> Sub-second page load speeds on mobile networks so prospective patients can find doctor schedules immediately.</li>
            <li><strong>Frictionless WhatsApp Booking:</strong> Click-to-WhatsApp appointment routing with pre-filled department inquiries that staff can confirm in seconds.</li>
            <li><strong>DPDP &amp; DISHA Data Hygiene:</strong> Zero intrusive third-party trackers or data leakages; patient inquiry forms are encrypted and sent directly to your verified practice email or CRM.</li>
            <li><strong>Local SEO Schema:</strong> MedicalClinic and Physician structured data configured to win local map packs and high-intent searches.</li>
          </ul>
        </article>

        <article class="card solution-card">
          <div class="solution-card__badge">CONVERSATIONAL AUTOMATION</div>
          <h3 class="solution-card__title">WhatsApp Automation for Businesses</h3>
          <p class="solution-card__desc">
            Stop losing leads to delayed replies and manual message reading. We deploy official Meta WhatsApp Cloud API webhooks that triage inquiries, qualify buyers, and sync data 24/7.
          </p>
          <ul class="solution-card__list">
            <li><strong>Official Verified API:</strong> Built on Meta Cloud API webhooks with zero reliance on fragile browser scrapers or unverified third-party numbers.</li>
            <li><strong>Intelligent Lead Qualification:</strong> Dynamic interactive button menus and structured automation flows capture inbound buyer goals, timeline, and functional requirements automatically.</li>
            <li><strong>Seamless CRM Synchronization:</strong> Inbound contact details and chat summaries push straight into Zoho CRM, HubSpot, PostgreSQL, or Google Sheets in real-time.</li>
            <li><strong>Live Agent Escalation:</strong> When a high-value customer requests a live call or bespoke quotation, the workflow instantly alerts your team with full conversation context.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Technical Stack Grid -->
  <section class="section tech-stack-section" aria-labelledby="stack-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="stack-title" class="section-title">Tested, Stable &amp; Maintainable Tools</h2>
        <p class="section-subtitle">
          We select proven technologies that offer maximum longevity, security, and developer maintainability.
        </p>
      </div>

      <div class="stack-grid">
        <div class="stack-category">
          <h3 class="stack-category__title">Frontend &amp; UI</h3>
          <ul class="stack-category__tags">
            <li>Astro</li>
            <li>TypeScript</li>
            <li>Next.js</li>
            <li>Modern CSS / Tailwind</li>
            <li>Three.js / GSAP</li>
          </ul>
        </div>
        <div class="stack-category">
          <h3 class="stack-category__title">Mobile Platforms</h3>
          <ul class="stack-category__tags">
            <li>Kotlin Native</li>
            <li>Jetpack Compose</li>
            <li>Room / SQLite</li>
            <li>Flutter (Hybrid)</li>
            <li>Android WorkManager</li>
          </ul>
        </div>
        <div class="stack-category">
          <h3 class="stack-category__title">Backend &amp; Databases</h3>
          <ul class="stack-category__tags">
            <li>Node.js / Express</li>
            <li>Python / FastAPI</li>
            <li>PostgreSQL</li>
            <li>Redis</li>
            <li>Prisma / Drizzle ORM</li>
          </ul>
        </div>
        <div class="stack-category">
          <h3 class="stack-category__title">Cloud &amp; Automation</h3>
          <ul class="stack-category__tags">
            <li>Meta WhatsApp Cloud API</li>
            <li>Cloudflare Workers &amp; Pages</li>
            <li>Docker Containers</li>
            <li>OpenAI / Anthropic APIs</li>
            <li>GitHub Actions CI/CD</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Engineering Standards & Quality Commitments -->
  <section class="section standards-section" aria-labelledby="standards-title">
    <div class="container">
      <div class="standards-box">
        <div class="standards-content">
          <h2 id="standards-title" class="standards-title">Our Non-Negotiable Engineering Standards</h2>
          <div class="standards-list">
            <div class="standard-item">
              <h3 class="standard-item__title">Zero Vendor Lock-In</h3>
              <p class="standard-item__text">
                All source code is stored in private git repositories transferred to your ownership upon final settlement. You have full access to deploy, host, or modify without licensing fees.
              </p>
            </div>
            <div class="standard-item">
              <h3 class="standard-item__title">Strict Security &amp; Data Hygiene</h3>
              <p class="standard-item__text">
                Input sanitization, encrypted environment variable vaults, parameterized database queries, and modern Content Security Policies (CSP) configured on every build.
              </p>
            </div>
            <div class="standard-item">
              <h3 class="standard-item__title">Milestone Testing &amp; Warranty</h3>
              <p class="standard-item__text">
                Every release undergoes cross-browser testing and device validation. We provide a complimentary 30-day bug warranty on all delivered scope to resolve unexpected regressions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Overview for Tech -->
  <section class="section" aria-labelledby="tech-pricing-title">
    <div class="container">
      <div class="section-header text-center">
        <h2 id="tech-pricing-title" class="section-title">Transparent Project Starting Baselines</h2>
        <p class="section-subtitle">
          Projects are estimated on defined scope specifications with 50% upfront deposit terms.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card card--quiet">
          <span class="section-eyebrow">Phase 01 &bull; Scope</span>
          <h3 class="pillar-title">Technical Specification</h3>
          <p class="text-secondary text-sm">
            We map all user flows, database schemas, and integration webhooks into a clear written specification document.
          </p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">Phase 02 &bull; Quote</span>
          <h3 class="pillar-title">Written Fixed Proposal</h3>
          <p class="text-secondary text-sm">
            You receive an itemized, fixed quote within 1 business day detailing sprints, deliverables, and zero hidden costs.
          </p>
        </div>
        <div class="card card--quiet">
          <span class="section-eyebrow">Phase 03 &bull; Handover</span>
          <h3 class="pillar-title">100% Code Ownership</h3>
          <p class="text-secondary text-sm">
            50% deposit to begin sprints, 50% upon staging approval. Complete source code repository and IP transferred to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2 class="cta-title">Have a Technical Architecture in Mind?</h2>
          <p class="cta-desc">
            Send us your functional requirements or brief. We will review feasibility, draft an architectural approach, and provide a fixed milestone breakdown.
          </p>
          <div class="cta-buttons">
            <a href="/contact/?service=technologies" class="btn btn--primary btn--lg">
              Start Technical Discussion
            </a>
            <a href="/case-studies/" class="btn btn--outline btn--lg">
              View Architectural Case Studies
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-page) 100%);
    border-bottom: 1px solid var(--border-color);
  }

  .page-hero__content {
    max-width: 48rem;
  }

  .division-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    background: rgba(99, 102, 241, 0.12);
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .page-hero__title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    margin-bottom: var(--space-6);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  /* Capabilities */
  .capability-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .capability-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--accent-subtle);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-6);
  }

  .capability-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .capability-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .capability-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .capability-features strong {
    color: var(--text-primary);
  }

  /* Stack Grid */
  .tech-stack-section {
    background: var(--bg-surface);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .stack-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .stack-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stack-category {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .stack-category__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--accent);
    font-weight: 700;
  }

  .stack-category__tags {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .stack-category__tags li {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid color-mix(in srgb, var(--border-color) 60%, transparent);
  }

  .stack-category__tags li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Standards */
  .standards-box {
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
  }

  .standards-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-8);
  }

  .standards-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 52rem) {
    .standards-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .standard-item__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .standard-item__text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }



  .w-full {
    width: 100%;
    justify-content: center;
  }

  .cta-section {
    padding-bottom: var(--space-24);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-slate) 0%, var(--color-void) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-8);
    text-align: center;
    color: var(--color-snow);
  }

  .cta-content {
    max-width: 44rem;
    margin-inline: auto;
  }

  .cta-title {
    font-size: var(--text-3xl);
    color: var(--color-snow);
    margin-bottom: var(--space-4);
  }

  .cta-desc {
    font-size: var(--text-base);
    color: #94a3b8;
    margin-bottom: var(--space-8);
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  /* Service Overview & Solution Cards */
  .service-overview-section {
    padding-top: 0;
    padding-bottom: var(--space-8);
  }

  .service-overview-card {
    padding: var(--space-8);
    background: var(--bg-surface);
  }

  .service-overview-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 48rem) {
    .service-overview-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 64rem) {
    .service-overview-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .overview-item__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .overview-item__val {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .solution-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
  }

  .solution-card__badge {
    font-size: var(--text-xs);
    font-weight: 700;
