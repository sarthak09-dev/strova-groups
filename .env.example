# Strova Group — Environment Configuration Template
# Copy this file to .env or configure in your deployment dashboard (Cloudflare Pages / Supabase).
# NEVER commit production secrets or API keys to version control.

# ==============================================================================
# Supabase Configuration (Authentication, Database, Private Deliverables Storage)
# ==============================================================================
# Project URL from Supabase Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (Safe for client-side browser usage, enforces Row Level Security)
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (STRICTLY PRIVATE - Server & Edge Functions ONLY, never in browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Storage bucket name for client deliverables
SUPABASE_DELIVERABLES_BUCKET=deliverables

# ==============================================================================
# Cloudflare Turnstile (Bot Protection for Auth & Contact Forms)
# ==============================================================================
# Public site key for client-side widget rendering (e.g. from Cloudflare Dashboard)
# (For local testing only, Cloudflare provides dummy test key: 1x00000000000000000000AA)
PUBLIC_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

# Private secret key for server-side verification in Edge Functions
# (For local testing only, Cloudflare provides dummy secret: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

# ==============================================================================
# Razorpay Payment Gateway (Indian Rupee INR Commercial Invoices)
# ==============================================================================
# Razorpay Key ID (Client-side checkout modal)
# In test mode: test key ID | In live mode: live key ID
PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Razorpay Key Secret (Server-side order creation and signature verification)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Webhooks for event verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==============================================================================
# Ephemeral Download Token Secret (Private Storage Security)
# ==============================================================================
# Cryptographic secret used to generate and verify 60-second HMAC signed download links
PORTAL_SIGNING_SECRET=generate-a-secure-random-32-byte-hex-string-for-hmac

# ==============================================================================
# Inbound Form Relay (Quote Request Notifications)
# ==============================================================================
# Access key from Web3Forms or Formspree for serverless delivery
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
# Optional alternative: FORMSPREE_KEY=your_formspree_form_id

# Deployment Environment ('production', 'staging', or 'test')
ENVIRONMENT=production

# ==============================================================================
# Site Origins & Canonical Hostnames
# ==============================================================================
PUBLIC_SITE_URL=https://strovagroups.in
PUBLIC_PORTAL_URL=https://strovagroups.in/portal
ALLOWED_ORIGINS=https://strovagroups.in

