---
interface Props {
  title: string;
  userEmail?: string;
  userRole?: 'client' | 'admin';
}

const { title, userEmail, userRole } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Strova Group Client Portal</title>
    <!-- Strictly no indexation or archiving for private client portal -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        --color-bg: #F4F5F7;
        --color-surface: #FFFFFF;
        --color-border: #E2E8F0;
        --color-border-subtle: #F1F5F9;
        --color-text-main: #0F172A;
        --color-text-muted: #475569;
        --color-text-dim: #64748B;
        --color-primary: #1D4ED8;
        --color-primary-hover: #1E40AF;
        --color-success: #059669;
        --color-warning: #D97706;
        --font-serif: 'Newsreader Variable', Georgia, Cambria, serif;
        --font-sans: 'Plus Jakarta Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      a:hover {
        color: var(--color-primary-hover);
      }

      .portal-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 1.5rem;
        width: 100%;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 150ms ease, border-color 150ms ease;
      }

      .btn-primary {
        background-color: var(--color-primary);
        color: #ffffff !important;
        border: 1px solid var(--color-primary);
      }

      .btn-primary:hover {
        background-color: var(--color-primary-hover);
        border-color: var(--color-primary-hover);
      }

      .btn-secondary {
        background-color: var(--color-surface);
        color: var(--color-text-main) !important;
        border: 1px solid var(--color-border);
      }

      .btn-secondary:hover {
        background-color: #F8FAFC;
        border-color: #CBD5E1;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 3px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .badge-progress {
        background-color: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
      }

      .badge-review {
        background-color: #FEF3C7;
        color: #92400E;
        border: 1px solid #FDE68A;
      }

      .badge-success {
        background-color: #ECFDF5;
        color: #065F46;
        border: 1px solid #A7F3D0;
      }

      .badge-pending {
        background-color: #FFFBEB;
        color: #B45309;
        border: 1px solid #FDE68A;
      }
    </style>
  </head>
  <body>
    <!-- Header -->
    <header style="background: var(--color-surface); border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
      <div class="portal-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 1.25rem;">
          <a href="/portal" style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; color: var(--color-text-main); text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
            <span>Strova Group</span>
            <span style="font-family: var(--font-sans); font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; background: #F1F5F9; color: #475569; padding: 0.15rem 0.45rem; border-radius: 3px;">Client Portal</span>
          </a>
          <span style="display: inline-block; width: 1px; height: 16px; background: var(--color-border);"></span>
          <a href="https://strovagroups.in" target="_blank" rel="noopener noreferrer" style="font-size: 0.8125rem; color: var(--color-text-dim); text-decoration: none;">Public site ↗</a>
        </div>

        <div style="display: flex; align-items: center; gap: 1rem;">
          {userEmail && (
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="font-size: 0.8125rem; color: var(--color-text-muted);">{userEmail}</span>
              {userRole === 'admin' ? (
                <span class="badge" style="background: #FEE2E2; color: #991B1B; border: 1px solid #FECACA;">Admin</span>
              ) : (
                <span class="badge" style="background: #E2E8F0; color: #334155; border: 1px solid #CBD5E1;">Client</span>
              )}
            </div>
          )}
          {userEmail ? (
            <a href="/portal/logout" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">Sign out</a>
          ) : (
            <a href="/portal/login" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">Client login</a>
          )}
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main style="flex: 1; padding: 2.5rem 0;">
      <div class="portal-container">
        <slot />
      </div>
    </main>

    <!-- Footer -->
    <footer style="background: var(--color-surface); border-top: 1px solid var(--color-border); padding: 2rem 0; margin-top: auto;">
      <div class="portal-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; font-size: 0.8125rem; color: var(--color-text-dim);">
        <div>
          <p style="font-weight: 500; color: var(--color-text-main); margin-bottom: 0.25rem;">Strova Group is a proprietorship of Babita Kumari.</p>
          <p>Udyam Registration: UDYAM-JH-20-0147452 • Private Client Portal</p>
        </div>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <a href="mailto:info@strovagroups.in?subject=DPDP%20Data%20Access%20or%20Erasure%20Request" style="color: var(--color-text-muted);">Request personal data export/deletion (DPDP Act 2023)</a>
          <a href="/.well-known/security.txt" style="color: var(--color-text-muted);">Security policy</a>
          <a href="mailto:info@strovagroups.in" style="color: var(--color-text-muted);">Support: info@strovagroups.in</a>
        </div>
      </div>
    </footer>
  </body>
</html>
