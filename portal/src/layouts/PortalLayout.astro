---
interface Props {
  title: string;
  currentNav?: 'overview' | 'orders' | 'invoices' | 'files' | 'messages' | 'support' | 'admin' | 'login';
}

const { title, currentNav = 'overview' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Strova Group Client Hub</title>
    <!-- Strictly no indexation or archiving for private client portal -->
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        color-scheme: light;
        --color-bg: #F8FAFC;
        --color-surface: #FFFFFF;
        --color-sidebar: #FFFFFF;
        --color-border: #E2E8F0;
        --color-border-subtle: #F1F5F9;
        --color-text-main: #0F172A;
        --color-text-muted: #475569;
        --color-text-dim: #64748B;
        --color-primary: #1D4ED8;
        --color-primary-hover: #1E40AF;
        --color-primary-tint: rgba(29, 78, 216, 0.08);
        --color-success: #059669;
        --color-success-bg: #ECFDF5;
        --color-warning: #D97706;
        --color-warning-bg: #FFFBEB;
        --color-danger: #DC2626;
        --color-danger-bg: #FEF2F2;
        --font-serif: 'Newsreader Variable', Georgia, Cambria, serif;
        --font-sans: 'Plus Jakarta Sans Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--color-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      a:hover {
        color: var(--color-primary-hover);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        font-size: 0.8125rem;
        font-weight: 600;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
        transition: all 150ms ease;
        border: 1px solid transparent;
      }

      .btn-primary {
        background-color: var(--color-primary);
        color: #ffffff !important;
        border-color: var(--color-primary);
      }

      .btn-primary:hover {
        background-color: var(--color-primary-hover);
        border-color: var(--color-primary-hover);
      }

      .btn-secondary {
        background-color: var(--color-surface);
        color: var(--color-text-main) !important;
        border-color: var(--color-border);
      }

      .btn-secondary:hover {
        background-color: #F8FAFC;
        border-color: #CBD5E1;
      }

      .btn-outline {
        background: transparent;
        border-color: var(--color-border);
        color: var(--color-text-main) !important;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 3px;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }

      .badge-progress {
        background-color: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
      }

      .badge-review {
        background-color: #FEF3C7;
        color: #92400E;
        border: 1px solid #FDE68A;
      }

      .badge-success {
        background-color: #ECFDF5;
        color: #065F46;
        border: 1px solid #A7F3D0;
      }

      .badge-pending {
        background-color: #FFFBEB;
        color: #B45309;
        border: 1px solid #FDE68A;
      }

      .badge-danger {
        background-color: #FEF2F2;
        color: #991B1B;
        border: 1px solid #FECACA;
      }

      /* Layout shell */
      .app-layout {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar */
      .app-sidebar {
        width: 250px;
        background: var(--color-surface);
        color: var(--color-text-main);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        border-right: 1px solid var(--color-border);
      }

      .sidebar-brand {
        padding: 1.5rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
      }

      .brand-icon {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        background: #1D4ED8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-serif);
        font-weight: 700;
        color: #FFFFFF;
        font-size: 1rem;
      }

      .brand-title {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-text-main);
      }

      .brand-tag {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: #EFF6FF;
        border: 1px solid #BFDBFE;
        padding: 0.1rem 0.35rem;
        border-radius: 2px;
        color: #1D4ED8;
        margin-left: 0.25rem;
      }

      .sidebar-nav {
        flex: 1;
        padding: 1.25rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        transition: all 150ms ease;
      }

      .nav-item:hover {
        background: var(--color-bg);
        color: var(--color-text-main);
      }

      .nav-item.active {
        background: #EFF6FF;
        color: #1D4ED8;
        font-weight: 600;
      }

      .nav-item svg {
        flex-shrink: 0;
      }

      .sidebar-footer {
        padding: 1.25rem;
        border-top: 1px solid var(--color-border);
      }

      .user-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
      }

      .user-info {
        overflow: hidden;
      }

      .user-name {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--color-text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .user-email {
        font-size: 0.7rem;
        color: var(--color-text-dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Main content wrapper */
      .app-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .top-navbar {
        height: 60px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
      }

      .top-navbar-title {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-weight: 600;
      }

      .top-navbar-actions {
        display: flex;
        align-items: center;
        gap: 1rem;
        position: relative;
      }

      /* Notification Bell & Dropdown */
      .notification-container {
        position: relative;
      }

      .notification-bell-btn {
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: 0.4rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        position: relative;
        transition: all 150ms ease;
      }

      .notification-bell-btn:hover {
        background: var(--color-surface);
        color: var(--color-text-main);
        border-color: var(--color-primary);
      }

      .notification-badge {
        position: absolute;
        top: -4px;
        right: -4px;
        background: var(--color-danger);
        color: #ffffff;
        font-size: 0.625rem;
        font-weight: 700;
        min-width: 16px;
        height: 16px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 3px;
        border: 1.5px solid var(--color-surface);
      }

      .notification-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 340px;
        max-width: 90vw;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        z-index: 1000;
        overflow: hidden;
      }

      .notification-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-border-subtle);
        background: var(--color-bg);
      }

      .notification-title {
        font-size: 0.8125rem;
        font-weight: 700;
        color: var(--color-text-main);
      }

      .notification-mark-all {
        background: none;
        border: none;
        color: var(--color-primary);
        font-size: 0.6875rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
      }

      .notification-mark-all:hover {
        text-decoration: underline;
      }

      .notification-list {
        max-height: 320px;
        overflow-y: auto;
      }

      .notification-item {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--color-border-subtle);
        transition: background 150ms ease;
        display: block;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
      }

      .notification-item:hover {
        background: var(--color-bg);
      }

      .notification-item.unread {
        background: var(--color-primary-tint);
        border-left: 3px solid var(--color-primary);
      }

      .notification-item-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-text-main);
        margin-bottom: 0.2rem;
      }

      .notification-item-body {
        font-size: 0.6875rem;
        color: var(--color-text-muted);
        line-height: 1.4;
      }

      .notification-item-time {
        font-size: 0.625rem;
        color: var(--color-text-dim);
        margin-top: 0.25rem;
      }

      .notification-empty {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--color-text-dim);
        font-size: 0.75rem;
      }

      .content-body {
        flex: 1;
        padding: 2rem;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
      }

      .app-footer {
        background: var(--color-surface);
        border-top: 1px solid var(--color-border);
        padding: 1.25rem 2rem;
        font-size: 0.75rem;
        color: var(--color-text-dim);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
      }

      /* Mobile Drawer / Responsive */
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        color: var(--color-text-main);
        cursor: pointer;
        padding: 0.25rem;
      }

      @media (max-width: 860px) {
        .app-sidebar {
          display: none;
        }

        .mobile-menu-btn {
          display: block;
        }

        .content-body {
          padding: 1.25rem 1rem;
        }

        .top-navbar {
          padding: 0 1rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <!-- Desktop Sidebar -->
      {currentNav !== 'login' && (
        <aside class="app-sidebar" id="app-sidebar">
          <a href="/portal/" class="sidebar-brand">
            <svg width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <rect width="36" height="36" rx="8" fill="#1D4ED8"/>
              <path d="M23 12C23 10.3431 21.6569 9 20 9H14C11.7909 9 10 10.7909 10 13C10 15.2091 11.7909 17 14 17H22C24.2091 17 26 18.7909 26 21C26 23.2091 24.2091 25 22 25H16C14.3431 25 13 23.6569 13 22" stroke="#FFFFFF" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="21" cy="21" r="1.75" fill="#93C5FD"/>
            </svg>
            <div>
              <span class="brand-title">Strova Group</span>
              <span class="brand-tag">Hub</span>
            </div>
          </a>

          <nav class="sidebar-nav">
            <a href="/portal/" class={`nav-item ${currentNav === 'overview' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/>
                <rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/>
                <rect x="3" y="14" width="7" height="7"/>
              </svg>
              <span>Overview</span>
            </a>

            <a href="/portal/orders/" class={`nav-item ${currentNav === 'orders' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                <polyline points="2 17 12 22 22 17"/>
                <polyline points="2 12 12 17 22 12"/>
              </svg>
              <span>Projects & Orders</span>
            </a>

            <a href="/portal/invoices/" class={`nav-item ${currentNav === 'invoices' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <line x1="2" y1="10" x2="22" y2="10"/>
              </svg>
              <span>Invoices & Payments</span>
            </a>

            <a href="/portal/files/" class={`nav-item ${currentNav === 'files' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                <polyline points="13 2 13 9 20 9"/>
              </svg>
              <span>Files & Deliverables</span>
            </a>

            <a href="/portal/messages/" class={`nav-item ${currentNav === 'messages' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              <span>Messages</span>
            </a>

            <a href="/portal/support/" class={`nav-item ${currentNav === 'support' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              <span>Support Requests</span>
            </a>

            <!-- Admin nav item shown if role is admin -->
            <a href="/portal/admin/" id="sidebar-admin-link" class={`nav-item ${currentNav === 'admin' ? 'active' : ''}`} style="display: none; border-top: 1px solid #E2E8F0; margin-top: 0.5rem; padding-top: 0.75rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span>Admin Console</span>
            </a>
          </nav>

          <div class="sidebar-footer">
            <div class="user-pill">
              <div class="user-info">
                <p class="user-name" id="sidebar-user-name">Loading...</p>
                <p class="user-email" id="sidebar-user-email">...</p>
              </div>
              <a href="/portal/logout/" title="Sign out" style="color: #64748B; text-decoration: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                  <polyline points="16 17 21 12 16 7"/>
                  <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
              </a>
            </div>
          </div>
        </aside>
      )}

      <!-- Main Column -->
      <div class="app-main">
        {currentNav !== 'login' && (
          <header class="top-navbar">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <button class="mobile-menu-btn" id="mobile-menu-toggle" aria-label="Toggle Navigation">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="3" y1="12" x2="21" y2="12"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
              </button>
              <h1 class="top-navbar-title">{title}</h1>
            </div>

            <div class="top-navbar-actions">
              <!-- In-App Notification Bell & Live Updates -->
              <div class="notification-container" id="notification-container">
                <button class="notification-bell-btn" id="notification-bell-btn" aria-label="Notifications" aria-expanded="false" title="Notifications">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                  </svg>
                  <span class="notification-badge" id="notification-badge" style="display: none;">0</span>
                </button>

                <div class="notification-dropdown" id="notification-dropdown" style="display: none;">
                  <div class="notification-header">
                    <span class="notification-title">Notifications</span>
                    <button class="notification-mark-all" id="notification-mark-all-btn">Mark all as read</button>
                  </div>
                  <div class="notification-list" id="notification-list">
                    <div class="notification-empty">Loading notifications...</div>
                  </div>
                </div>
              </div>

              <a href="/" class="btn btn-outline" style="font-size: 0.75rem;">
                Marketing site ↗
              </a>
              <a href="/portal/logout/" class="btn btn-secondary" style="font-size: 0.75rem;">
                Sign out
              </a>
            </div>
          </header>
        )}

        <main class="content-body">
          <slot />
        </main>

        <footer class="app-footer">
          <div>
            <p><strong>Strova Group</strong> is a proprietorship of Babita Kumari. Registered MSME Enterprise (UDYAM-JH-20-0147452).</p>
          </div>
          <div style="display: flex; gap: 1.25rem; flex-wrap: wrap;">
            <a href="https://strovagroups.in/terms/" target="_blank" rel="noopener noreferrer" style="color: inherit;">Terms of Service</a>
            <a href="https://strovagroups.in/privacy/" target="_blank" rel="noopener noreferrer" style="color: inherit;">Privacy Policy</a>
            <a href="https://strovagroups.in/cookies/" target="_blank" rel="noopener noreferrer" style="color: inherit;">Cookie Policy</a>
            <a href="https://strovagroups.in/privacy/requests/" target="_blank" rel="noopener noreferrer" style="color: inherit;">Privacy Rights Desk</a>
            <a href="mailto:info@strovagroups.in" style="color: inherit;">info@strovagroups.in</a>
            <a href="https://wa.me/919288077802" target="_blank" rel="noopener noreferrer" style="color: inherit;">WhatsApp: +91 92880 77802</a>
          </div>
        </footer>
      </div>
    </div>

    <script>
      import { 
        getSession, 
        getUserProfile, 
        fetchNotifications, 
        fetchUnreadNotificationCount,
        markNotificationRead, 
        markAllNotificationsRead 
      } from '../lib/supabaseClient';
      import { subscribeToNotifications } from '../lib/realtime';
      import { escapeHtml } from '../lib/sanitize';

      let currentUserId = '';
      let notifications: any[] = [];

      function updateBadge(count: number) {
        const badge = document.getElementById('notification-badge');
        if (!badge) return;
        if (count > 0) {
          badge.textContent = count > 9 ? '9+' : String(count);
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
        }
      }

      function renderNotifications(items: any[]) {
        const listEl = document.getElementById('notification-list');
        if (!listEl) return;

        if (!items || items.length === 0) {
          listEl.innerHTML = '<div class="notification-empty">No notifications yet</div>';
          return;
        }

        listEl.innerHTML = items.map((item) => {
          const dateStr = item.created_at ? new Date(item.created_at).toLocaleDateString(undefined, {
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          }) : '';

          return `
            <div class="notification-item ${item.is_read ? '' : 'unread'}" data-id="${escapeHtml(item.id)}" data-link="${escapeHtml(item.link || '')}">
              <div class="notification-item-title">${escapeHtml(item.title)}</div>
              ${item.body ? `<div class="notification-item-body">${escapeHtml(item.body)}</div>` : ''}
              <div class="notification-item-time">${escapeHtml(dateStr)}</div>
            </div>
          `;
        }).join('');

        // Attach click listeners to notification items
        listEl.querySelectorAll('.notification-item').forEach((el) => {
          el.addEventListener('click', async () => {
            const id = el.getAttribute('data-id');
            const link = el.getAttribute('data-link');
            if (id) {
              await markNotificationRead(id).catch(() => null);
              el.classList.remove('unread');
              const unreadLeft = listEl.querySelectorAll('.notification-item.unread').length;
              updateBadge(unreadLeft);
            }
            if (link && link.startsWith('/')) {
              window.location.href = link.endsWith('/') ? link : `${link}/`;
            }
          });
        });
      }

      async function loadNotifications() {
        try {
          const [items, unreadCount] = await Promise.all([
            fetchNotifications(15),
            fetchUnreadNotificationCount(),
          ]);
          notifications = items;
          updateBadge(unreadCount);
          renderNotifications(items);
        } catch (e) {
          console.warn('Failed to load notifications:', e);
        }
      }

      async function setupNotifications(userId: string) {
        currentUserId = userId;
        await loadNotifications();

        // Subscribe to real-time notifications
        subscribeToNotifications(userId, (newNotif) => {
          notifications.unshift(newNotif);
          renderNotifications(notifications.slice(0, 15));
          const currentBadge = document.getElementById('notification-badge');
          const currentCount = parseInt(currentBadge?.textContent || '0', 10) || 0;
          updateBadge(currentCount + 1);
        });

        // Toggle dropdown
        const bellBtn = document.getElementById('notification-bell-btn');
        const dropdown = document.getElementById('notification-dropdown');
        const markAllBtn = document.getElementById('notification-mark-all-btn');

        if (bellBtn && dropdown) {
          bellBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = dropdown.style.display !== 'none';
            dropdown.style.display = isOpen ? 'none' : 'block';
            bellBtn.setAttribute('aria-expanded', String(!isOpen));
          });

          document.addEventListener('click', (e) => {
            if (!dropdown.contains(e.target as Node) && !bellBtn.contains(e.target as Node)) {
              dropdown.style.display = 'none';
              bellBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        if (markAllBtn) {
          markAllBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            await markAllNotificationsRead().catch(() => null);
            notifications.forEach((n) => { n.is_read = true; });
            renderNotifications(notifications);
            updateBadge(0);
          });
        }
      }

      async function populateUserInfo() {
        try {
          const session = await getSession();
          if (session) {
            const emailEl = document.getElementById('sidebar-user-email');
            const nameEl = document.getElementById('sidebar-user-name');
            const adminLink = document.getElementById('sidebar-admin-link');

            if (emailEl) emailEl.textContent = session.user.email || '';
            const profile = await getUserProfile(session.user.id);
            if (nameEl) nameEl.textContent = profile?.full_name || session.user.email?.split('@')[0] || 'Client';
            if (adminLink && profile?.role === 'admin') {
              adminLink.style.display = 'flex';
            }

            setupNotifications(session.user.id);
          }
        } catch (e) {}
      }

      populateUserInfo();
    </script>
  </body>
</html>
