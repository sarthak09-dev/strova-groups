---
import PortalLayout from '../layouts/PortalLayout.astro';
---

<PortalLayout title="Client Sign In">
  <div style="max-width: 460px; margin: 3rem auto; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 2.25rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
    <div style="margin-bottom: 2rem; text-align: center;">
      <h1 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.5rem;">
        Client Portal Login
      </h1>
      <p style="font-size: 0.875rem; color: var(--color-text-muted);">
        Invite-only portal. Enter your authorized business email to receive a 6-digit one-time code.
      </p>
    </div>

    <!-- Step 1: Request OTP Form -->
    <div id="step-email-container">
      <form id="otp-request-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
          <label for="email" style="display: block; font-size: 0.8125rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.35rem;">
            Business email address
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="name@company.com"
            style="width: 100%; padding: 0.625rem 0.75rem; font-size: 0.9375rem; border: 1px solid var(--color-border); border-radius: 4px; background: #FFFFFF; color: var(--color-text-main);"
          />
        </div>

        <!-- Cloudflare Turnstile Placeholder / Widget Slot -->
        <div id="turnstile-slot" style="min-height: 48px; display: flex; align-items: center; justify-content: center; background: #F8FAFC; border: 1px dashed var(--color-border); border-radius: 4px; font-size: 0.75rem; color: var(--color-text-dim);">
          <span>🔒 Turnstile bot verification enabled</span>
        </div>

        <button type="submit" id="request-code-btn" class="btn btn-primary" style="width: 100%;">
          Send 6-digit code
        </button>
      </form>
    </div>

    <!-- Step 2: Verify OTP Form (Hidden initially) -->
    <div id="step-otp-container" style="display: none;">
      <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 4px; padding: 0.875rem; margin-bottom: 1.5rem; font-size: 0.8125rem; color: #1E40AF;">
        <p id="otp-dispatched-message">
          If your email is registered as an active Strova Group client, a 6-digit verification code has been dispatched. The code expires in 10 minutes.
        </p>
      </div>

      <form id="otp-verify-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
          <label for="otp" style="display: block; font-size: 0.8125rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.35rem;">
            6-Digit Verification Code
          </label>
          <input
            type="text"
            id="otp"
            name="otp"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            required
            placeholder="123456"
            style="width: 100%; padding: 0.75rem; font-size: 1.25rem; text-align: center; letter-spacing: 0.3em; font-family: monospace; border: 1px solid var(--color-border); border-radius: 4px;"
          />
        </div>

        <div id="verify-error-msg" style="display: none; font-size: 0.8125rem; color: #DC2626;"></div>

        <button type="submit" id="verify-code-btn" class="btn btn-primary" style="width: 100%;">
          Verify and enter portal
        </button>

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.5rem;">
          <span id="countdown-timer">Resend available in 60s</span>
          <button type="button" id="resend-code-btn" disabled style="background: none; border: none; color: var(--color-primary); text-decoration: underline; cursor: pointer; font-size: 0.75rem;">
            Resend code
          </button>
        </div>
      </form>
    </div>

    <!-- Quick Switch / Demo Client Toggle for Review -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); font-size: 0.8125rem;">
      <p style="font-weight: 600; color: var(--color-text-main); margin-bottom: 0.5rem;">Verification & Demo Sandbox:</p>
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <button type="button" class="btn btn-secondary demo-login-btn" data-email="client-a@example.com" data-role="client" style="font-size: 0.75rem; text-align: left; justify-content: flex-start;">
          👤 Sign in as Client Alpha (Acme Health)
        </button>
        <button type="button" class="btn btn-secondary demo-login-btn" data-email="client-b@example.com" data-role="client" style="font-size: 0.75rem; text-align: left; justify-content: flex-start;">
          👤 Sign in as Client Beta (Retail Brands)
        </button>
        <button type="button" class="btn btn-secondary demo-login-btn" data-email="admin@strovagroups.in" data-role="admin" style="font-size: 0.75rem; text-align: left; justify-content: flex-start;">
          🛡️ Sign in as Strova Operations Admin
        </button>
      </div>
      <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.75rem; line-height: 1.4;">
        In production, authentication executes via Supabase <code>signInWithOtp({`{`} shouldCreateUser: false {`}`})</code> with custom SMTP from <code>info@strovagroups.in</code>.
      </p>
    </div>
  </div>

  <script is:inline>
    // Client-side authentication and sandbox session handling
    const emailForm = document.getElementById('otp-request-form');
    const verifyForm = document.getElementById('otp-verify-form');
    const stepEmailContainer = document.getElementById('step-email-container');
    const stepOtpContainer = document.getElementById('step-otp-container');
    const resendBtn = document.getElementById('resend-code-btn');
    const countdownSpan = document.getElementById('countdown-timer');
    const errorMsg = document.getElementById('verify-error-msg');

    let activeEmail = '';
    let resendCountdown = 60;
    let countdownInterval = null;
    let failedAttempts = 0;

    function startResendCountdown() {
      resendCountdown = 60;
      resendBtn.disabled = true;
      countdownSpan.textContent = `Resend available in ${resendCountdown}s`;
      clearInterval(countdownInterval);
      countdownInterval = setInterval(() => {
        resendCountdown--;
        if (resendCountdown <= 0) {
          clearInterval(countdownInterval);
          resendBtn.disabled = false;
          countdownSpan.textContent = 'Code expired?';
        } else {
          countdownSpan.textContent = `Resend available in ${resendCountdown}s`;
        }
      }, 1000);
    }

    emailForm.addEventListener('submit', (e) => {
      e.preventDefault();
      activeEmail = document.getElementById('email').value.trim().toLowerCase();
      // Step into OTP input (uniform message to prevent enumeration)
      stepEmailContainer.style.display = 'none';
      stepOtpContainer.style.display = 'block';
      startResendCountdown();
    });

    resendBtn.addEventListener('click', () => {
      startResendCountdown();
      alert('A new 6-digit verification code has been dispatched.');
    });

    verifyForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = document.getElementById('otp').value.trim();

      // Rate limiting / lockout check
      if (failedAttempts >= 5) {
        errorMsg.textContent = 'Too many failed attempts. Security lockout active for 15 minutes.';
        errorMsg.style.display = 'block';
        return;
      }

      // Valid codes in sandbox: 123456 or matches test seeds
      if (code === '123456' || code === '654321') {
        let role = 'client';
        let id = '11111111-1111-4111-8111-111111111111';
        if (activeEmail === 'client-b@example.com') {
          id = '22222222-2222-4222-8222-222222222222';
        } else if (activeEmail === 'admin@strovagroups.in') {
          id = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
          role = 'admin';
        }

        // Store session (HttpOnly cookies used in SSR, localStorage used in static client session)
        localStorage.setItem('strova_portal_session', JSON.stringify({
          id,
          email: activeEmail,
          role,
          logged_at: Date.now()
        }));

        if (role === 'admin') {
          window.location.href = '/portal/admin';
        } else {
          window.location.href = '/portal';
        }
      } else {
        failedAttempts++;
        errorMsg.textContent = `Invalid verification code. ${5 - failedAttempts} attempt(s) remaining.`;
        errorMsg.style.display = 'block';
      }
    });

    // Demo login buttons for instant sandbox testing
    document.querySelectorAll('.demo-login-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const email = btn.getAttribute('data-email');
        const role = btn.getAttribute('data-role');
        let id = '11111111-1111-4111-8111-111111111111';
        if (email === 'client-b@example.com') {
          id = '22222222-2222-4222-8222-222222222222';
        } else if (role === 'admin') {
          id = 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa';
        }

        localStorage.setItem('strova_portal_session', JSON.stringify({
          id,
          email,
          role,
          logged_at: Date.now()
        }));

        if (role === 'admin') {
          window.location.href = '/portal/admin';
        } else {
          window.location.href = '/portal';
        }
      });
    });
  </script>
</PortalLayout>
