---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { SEED_ORDERS } from '../../lib/supabase';

export function getStaticPaths() {
  return SEED_ORDERS.map((order) => ({
    params: { id: order.id },
    props: { order },
  }));
}

const { id } = Astro.params;
---

<PortalLayout title="Project Workspace" currentNav="orders">
  <div style="margin-bottom: 1.5rem;">
    <a href="/portal/orders" style="font-size: 0.8125rem; color: var(--color-text-dim); text-decoration: none;">
      ← Back to all projects
    </a>
  </div>

  <!-- Loading State -->
  <div id="order-loading" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 2rem; text-align: center; color: var(--color-text-dim);">
    Loading workspace details...
  </div>

  <!-- Access Denied (Cross-Tenant RLS Violation) State -->
  <div id="order-forbidden" style="display: none; background: #FEF2F2; border: 1px solid #FECACA; border-radius: 6px; padding: 2.5rem; text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🛡️</div>
    <h2 style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: #991B1B; margin-bottom: 0.5rem;">
      403 Forbidden — Access Denied
    </h2>
    <p style="font-size: 0.875rem; color: #7F1D1D; max-width: 520px; margin: 0 auto 1.5rem; line-height: 1.5;">
      You do not have authorization to view this project. Strova Group enforces strict tenant isolation using Row Level Security (RLS). Cross-client data access attempts are denied and logged.
    </p>
    <a href="/portal/orders" class="btn btn-secondary" style="border-color: #FECACA; color: #991B1B !important;">
      Return to your authorized projects
    </a>
  </div>

  <!-- Order Content (Rendered only if authorized) -->
  <div id="order-content" style="display: none;">
    <!-- Order Header -->
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 2rem; margin-bottom: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.75rem;">
        <div>
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
            <span id="order-division-badge" style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary);"></span>
            <span style="color: var(--color-border);">•</span>
            <span id="order-ref" style="font-size: 0.75rem; font-family: monospace; color: var(--color-text-dim);"></span>
          </div>
          <h1 id="order-title" style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 600; color: var(--color-text-main); margin-top: 0.25rem;"></h1>
        </div>
        <span id="order-current-stage-badge" class="badge"></span>
      </div>

      <div style="display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--color-border-subtle); font-size: 0.8125rem;">
        <div>
          <span style="color: var(--color-text-dim);">Agreed Scope:</span>
          <strong id="order-scope-ref" style="display: block; color: var(--color-text-main);"></strong>
        </div>
        <div>
          <span style="color: var(--color-text-dim);">Target Date:</span>
          <strong id="order-target-date" style="display: block; color: var(--color-text-main);"></strong>
        </div>
        <div>
          <span style="color: var(--color-text-dim);">Total Budget:</span>
          <strong id="order-total-amount" style="display: block; color: var(--color-text-main);"></strong>
        </div>
        <div>
          <span style="color: var(--color-text-dim);">Outstanding:</span>
          <strong id="order-balance-amount" style="display: block; color: var(--color-text-main);"></strong>
        </div>
      </div>
    </div>

    <!-- 2-Column Grid: Timeline on left, Files & Invoices & Messages on right -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
      <!-- Column 1: Progress Timeline -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h2 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600;">
            Milestone Timeline
          </h2>
          <span id="timeline-progress-pill" class="badge badge-progress"></span>
        </div>

        <div id="timeline-container" style="display: flex; flex-direction: column; gap: 1.5rem; position: relative;">
          <!-- Injected timeline nodes -->
        </div>
      </div>

      <!-- Column 2: Deliverables, Invoices, and Messaging -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        <!-- Deliverables Panel -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem;">
          <h2 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">
            Private Deliverables
          </h2>
          <p style="font-size: 0.8125rem; color: var(--color-text-dim); margin-bottom: 1.25rem;">
            Cryptographically signed download links with 60-second expiration.
          </p>
          <div id="files-list-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <!-- Injected files -->
          </div>
        </div>

        <!-- Invoices Panel (Zero public price lists) -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem;">
          <h2 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">
            Invoices & Settlement
          </h2>
          <p style="font-size: 0.8125rem; color: var(--color-text-dim); margin-bottom: 1.25rem;">
            Online milestone payment via Razorpay. Zero hidden fees.
          </p>
          <div id="invoices-list-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <!-- Injected invoices -->
          </div>
        </div>

        <!-- Message Box per Order -->
        <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem;">
          <h2 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">
            Project Message Channel
          </h2>
          <p style="font-size: 0.8125rem; color: var(--color-text-dim); margin-bottom: 1.25rem;">
            Direct thread for this engagement. Notes are emailed to info@strovagroups.in.
          </p>

          <div id="messages-list-container" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; max-height: 280px; overflow-y: auto; padding-right: 0.5rem;">
            <!-- Injected message bubbles -->
          </div>

          <form id="new-message-form" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <textarea
              id="message-input"
              rows="3"
              required
              placeholder="Leave a project note, requirement update, or feedback..."
              style="width: 100%; padding: 0.625rem; font-size: 0.875rem; font-family: inherit; border: 1px solid var(--color-border); border-radius: 4px; resize: vertical;"
            ></textarea>
            <div style="display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary" style="font-size: 0.8125rem;">
                Send message
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ targetOrderId: id }}>
    const orderId = targetOrderId;
    const sessionRaw = localStorage.getItem('strova_portal_session');
    if (!sessionRaw) {
      window.location.href = '/portal/login';
    } else {
      const session = JSON.parse(sessionRaw);

      const DB = {
        orders: [
          {
            id: '00000000-0000-0000-0000-000000000001',
            order_ref: 'ORD-2026-001',
            client_id: '11111111-1111-4111-8111-111111111111',
            title: 'Patient Scheduling Platform & WhatsApp Cloud API',
            division: 'Strova Technologies',
            current_stage: 'In progress',
            badge_class: 'badge-progress',
            scope_reference: 'SOW-TECH-2026-01',
            target_completion_date: 'Nov 15, 2026',
            total_amount_paise: 25000000,
            balance_amount_paise: 12500000,
            progress_percent: 50
          },
          {
            id: '00000000-0000-0000-0000-000000000002',
            order_ref: 'ORD-2026-002',
            client_id: '22222222-2222-4222-8222-222222222222',
            title: 'Technical SEO Architecture & Google Ads CAPI Wiring',
            division: 'Strova Digital',
            current_stage: 'Review',
            badge_class: 'badge-review',
            scope_reference: 'SOW-DIG-2026-04',
            target_completion_date: 'Oct 25, 2026',
            total_amount_paise: 12000000,
            balance_amount_paise: 6000000,
            progress_percent: 75
          }
        ],
        stages: [
          'Brief received',
          'Scope agreed',
          'Advance pending',
          'In progress',
          'Review',
          'Revisions',
          'Final payment pending',
          'Delivered',
          'Support'
        ],
        events: {
          '00000000-0000-0000-0000-000000000001': [
            { stage: 'Brief received', note: 'Initial clinic scheduling brief submitted via quote request form.', date: 'Oct 02, 2026' },
            { stage: 'Scope agreed', note: 'Technical specification blueprint and sprint milestone schedule approved.', date: 'Oct 03, 2026' },
            { stage: 'Advance pending', note: 'Invoice INV-2026-001 issued for 50% project advance.', date: 'Oct 03, 2026' },
            { stage: 'In progress', note: 'Advance settled (Receipt RCP-INV-2026-001-0421). Sprint 2 in progress: Meta WhatsApp Cloud API webhooks wired to booking queue.', date: 'Oct 10, 2026' }
          ],
          '00000000-0000-0000-0000-000000000002': [
            { stage: 'Brief received', note: 'Inbound SEO audit inquiry received.', date: 'Oct 06, 2026' },
            { stage: 'Scope agreed', note: 'Remediation agreement and Conversion API scope signed.', date: 'Oct 07, 2026' },
            { stage: 'In progress', note: 'Core Web Vitals remediation completed on staging.', date: 'Oct 08, 2026' },
            { stage: 'Review', note: 'Staging deployment ready for client review and verification.', date: 'Oct 11, 2026' }
          ]
        },
        files: {
          '00000000-0000-0000-0000-000000000001': [
            { id: 'f1', name: 'technical-architecture-blueprint-v1.pdf', size: '1.2 MB', date: 'Oct 03, 2026' }
          ],
          '00000000-0000-0000-0000-000000000002': [
            { id: 'f2', name: 'seo-audit-remediation-report.pdf', size: '2.1 MB', date: 'Oct 11, 2026' }
          ]
        },
        invoices: {
          '00000000-0000-0000-0000-000000000001': [
            { id: 'inv-1', number: 'INV-2026-001', amount_paise: 12500000, status: 'Paid', badge: 'badge-success', date: 'Oct 03, 2026', receipt: 'RCP-INV-2026-001-0421' }
          ],
          '00000000-0000-0000-0000-000000000002': [
            { id: 'inv-2', number: 'INV-2026-002', amount_paise: 6000000, status: 'Pending', badge: 'badge-pending', date: 'Oct 08, 2026', receipt: null }
          ]
        },
        messages: {
          '00000000-0000-0000-0000-000000000001': [
            { sender: 'Client Alpha', role: 'client', text: 'Uploaded the WhatsApp Cloud API webhook credentials in the secure vault.', date: 'Oct 05, 09:15' },
            { sender: 'Strova Operations', role: 'admin', text: 'Credentials verified and staging webhooks are now actively listening.', date: 'Oct 05, 11:40' }
          ],
          '00000000-0000-0000-0000-000000000002': [
            { sender: 'Client Beta', role: 'client', text: 'Reviewed the Core Web Vitals remediation plan. Approved to deploy to staging.', date: 'Oct 09, 14:10' }
          ]
        }
      };

      const order = DB.orders.find(o => o.id === orderId);
      document.getElementById('order-loading').style.display = 'none';

      // RLS Isolation Check
      const isAuthorized = order && (session.role === 'admin' || order.client_id === session.id);

      if (!order || !isAuthorized) {
        document.getElementById('order-forbidden').style.display = 'block';
      } else {
        document.getElementById('order-content').style.display = 'block';

        document.getElementById('order-title').textContent = order.title;
        document.getElementById('order-division-badge').textContent = order.division;
        document.getElementById('order-ref').textContent = order.order_ref;
        document.getElementById('order-scope-ref').textContent = order.scope_reference;
        document.getElementById('order-target-date').textContent = order.target_completion_date;
        document.getElementById('order-total-amount').textContent = `₹${(order.total_amount_paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
        document.getElementById('order-balance-amount').textContent = `₹${(order.balance_amount_paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;

        const stageBadge = document.getElementById('order-current-stage-badge');
        stageBadge.textContent = order.current_stage;
        stageBadge.className = `badge ${order.badge_class}`;

        document.getElementById('timeline-progress-pill').textContent = `${order.progress_percent}% Complete`;

        const completedEvents = DB.events[order.id] || [];
        const currentStageIndex = DB.stages.indexOf(order.current_stage);

        const timelineContainer = document.getElementById('timeline-container');
        timelineContainer.innerHTML = DB.stages.map((stageName, idx) => {
          const isDone = idx < currentStageIndex;
          const isCurrent = idx === currentStageIndex;
          const matchingEvent = completedEvents.find(e => e.stage === stageName);

          let circleBg = '#E2E8F0';
          let circleColor = '#64748B';
          let circleBorder = '#CBD5E1';
          if (isDone) {
            circleBg = '#ECFDF5';
            circleColor = '#059669';
            circleBorder = '#10B981';
          } else if (isCurrent) {
            circleBg = '#EFF6FF';
            circleColor = '#1D4ED8';
            circleBorder = '#3B82F6';
          }

          return `
            <div style="display: flex; gap: 1rem; align-items: flex-start; position: relative;">
              <div style="width: 28px; height: 28px; border-radius: 50%; background: ${circleBg}; color: ${circleColor}; border: 2px solid ${circleBorder}; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; z-index: 1;">
                ${isDone ? '✓' : (idx + 1)}
              </div>
              <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.5rem;">
                  <h3 style="font-size: 0.9375rem; font-weight: ${isCurrent ? '700' : '600'}; color: ${isCurrent ? 'var(--color-primary)' : 'var(--color-text-main)'};">
                    ${stageName}
                  </h3>
                  ${matchingEvent ? `<span style="font-size: 0.75rem; color: var(--color-text-dim);">${matchingEvent.date}</span>` : ''}
                </div>
                ${matchingEvent ? `
                  <p style="font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 0.25rem; line-height: 1.4;">
                    ${matchingEvent.note}
                  </p>
                ` : isCurrent ? `
                  <p style="font-size: 0.8125rem; color: var(--color-primary); margin-top: 0.25rem;">
                    Active milestone stage in progress.
                  </p>
                ` : `
                  <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.25rem;">
                    Pending prior milestone completion.
                  </p>
                `}
              </div>
            </div>
          `;
        }).join('');

        // Deliverables with 60s Ephemeral Link
        const filesContainer = document.getElementById('files-list-container');
        const files = DB.files[order.id] || [];
        if (files.length === 0) {
          filesContainer.innerHTML = `<p style="font-size: 0.8125rem; color: var(--color-text-dim);">No deliverable files uploaded yet for this stage.</p>`;
        } else {
          filesContainer.innerHTML = files.map(f => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 4px; background: #FAFAFA;">
              <div>
                <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-main);">${f.name}</p>
                <p style="font-size: 0.75rem; color: var(--color-text-dim);">${f.size} • Uploaded ${f.date}</p>
              </div>
              <button class="btn btn-secondary download-file-btn" data-filename="${f.name}" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
                Download (60s link)
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.download-file-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const fileName = btn.getAttribute('data-filename');
              alert(`Verified tenant permission for ${session.email}. Ephemeral 60s signed link generated for ${fileName}.`);
            });
          });
        }

        // Invoices & Pay Now
        const invoicesContainer = document.getElementById('invoices-list-container');
        const invoices = DB.invoices[order.id] || [];
        if (invoices.length === 0) {
          invoicesContainer.innerHTML = `<p style="font-size: 0.8125rem; color: var(--color-text-dim);">No invoices generated for this order.</p>`;
        } else {
          invoicesContainer.innerHTML = invoices.map(inv => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 4px; background: #FAFAFA; flex-wrap: wrap; gap: 0.5rem;">
              <div>
                <p style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-main); font-family: monospace;">${inv.number}</p>
                <p style="font-size: 0.75rem; color: var(--color-text-dim);">₹${(inv.amount_paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 })} • Issued: ${inv.date}</p>
                ${inv.receipt ? `<p style="font-size: 0.7rem; color: var(--color-success);">Receipt: ${inv.receipt}</p>` : ''}
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <span class="badge ${inv.badge}">${inv.status}</span>
                ${inv.status === 'Pending' ? `
                  <a href="/portal/invoices" class="btn btn-primary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
                    Pay Now
                  </a>
                ` : `
                  <button class="btn btn-secondary download-invoice-btn" data-inv="${inv.number}" style="font-size: 0.75rem; padding: 0.35rem 0.65rem;">
                    PDF
                  </button>
                `}
              </div>
            </div>
          `).join('');

          document.querySelectorAll('.download-invoice-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const invNo = btn.getAttribute('data-inv');
              alert(`Downloading tax invoice ${invNo} PDF for ${session.email}.`);
            });
          });
        }

        // Messages
        const messagesContainer = document.getElementById('messages-list-container');
        const messageList = DB.messages[order.id] || [];

        function renderMessages() {
          messagesContainer.innerHTML = messageList.map(msg => {
            const isMe = (session.role === 'admin' && msg.role === 'admin') || (session.role === 'client' && msg.role === 'client');
            return `
              <div style="align-self: ${isMe ? 'flex-end' : 'flex-start'}; max-width: 85%; background: ${isMe ? '#EFF6FF' : '#F1F5F9'}; border: 1px solid ${isMe ? '#BFDBFE' : '#E2E8F0'}; border-radius: 6px; padding: 0.75rem 1rem;">
                <div style="display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.25rem; font-size: 0.75rem;">
                  <strong style="color: ${isMe ? '#1D4ED8' : 'var(--color-text-main)'};">${msg.sender}</strong>
                  <span style="color: var(--color-text-dim);">${msg.date}</span>
                </div>
                <p style="font-size: 0.8125rem; color: var(--color-text-main); line-height: 1.4;">${msg.text}</p>
              </div>
            `;
          }).join('');
        }
        renderMessages();

        document.getElementById('new-message-form').addEventListener('submit', (e) => {
          e.preventDefault();
          const input = document.getElementById('message-input');
          const text = input.value.trim();
          if (!text) return;

          messageList.push({
            sender: session.role === 'admin' ? 'Strova Operations' : (session.email.split('@')[0]),
            role: session.role,
            text,
            date: 'Just now'
          });
          input.value = '';
          renderMessages();
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });
      }
    }
  </script>
</PortalLayout>
