---
import PortalLayout from '../layouts/PortalLayout.astro';
---

<PortalLayout title="Files & Deliverables" currentNav="files">
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h2 style="font-family: var(--font-serif); font-size: 1.85rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.25rem;">
        Files & Deliverables
      </h2>
      <p style="font-size: 0.875rem; color: var(--color-text-muted);">
        Secure repository for architecture specifications, reports, source code bundles, and staging assets.
      </p>
    </div>

    <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 4px; padding: 0.5rem 1rem; font-size: 0.75rem; color: #1E40AF;">
      🔒 60-Second Ephemeral Cryptographic Signed URLs
    </div>
  </div>

  <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
      <h3 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600;">Authorized Project Files</h3>
      <input
        type="search"
        id="file-search"
        placeholder="Filter filenames..."
        style="padding: 0.45rem 0.75rem; font-size: 0.8125rem; border: 1px solid var(--color-border); border-radius: 4px;"
      />
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; text-align: left;">
        <thead>
          <tr style="border-bottom: 1px solid var(--color-border); color: var(--color-text-dim); font-size: 0.75rem; text-transform: uppercase;">
            <th style="padding: 0.75rem;">File Name</th>
            <th style="padding: 0.75rem;">Associated Project</th>
            <th style="padding: 0.75rem;">File Size</th>
            <th style="padding: 0.75rem;">Upload Date</th>
            <th style="padding: 0.75rem; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody id="files-table-body">
          <!-- Injected via client session query -->
        </tbody>
      </table>
    </div>

    <div id="files-empty" style="display: none; padding: 3rem 1rem; text-align: center; color: var(--color-text-dim);">
      No deliverables uploaded yet for your organization.
    </div>
  </div>

  <script is:inline>
    const sessionRaw = localStorage.getItem('strova_portal_session');
    if (!sessionRaw) {
      window.location.href = '/portal/login';
    } else {
      const session = JSON.parse(sessionRaw);

      const DB_FILES = [
        {
          id: 'f1',
          client_id: '11111111-1111-4111-8111-111111111111',
          project: 'Patient Scheduling Platform & WhatsApp Cloud API',
          name: 'technical-architecture-blueprint-v1.pdf',
          size: '1.2 MB',
          date: 'Oct 03, 2026'
        },
        {
          id: 'f2',
          client_id: '22222222-2222-4222-8222-222222222222',
          project: 'Technical SEO Architecture & Google Ads CAPI Wiring',
          name: 'seo-audit-remediation-report.pdf',
          size: '2.1 MB',
          date: 'Oct 11, 2026'
        }
      ];

      const myFiles = DB_FILES.filter(f => session.role === 'admin' || f.client_id === session.id);
      const tableBody = document.getElementById('files-table-body');
      const emptyDiv = document.getElementById('files-empty');

      function render(filter = '') {
        const filtered = myFiles.filter(f => !filter || f.name.toLowerCase().includes(filter));
        if (filtered.length === 0) {
          emptyDiv.style.display = 'block';
          tableBody.innerHTML = '';
        } else {
          emptyDiv.style.display = 'none';
          tableBody.innerHTML = filtered.map(f => `
            <tr style="border-bottom: 1px solid var(--color-border-subtle);">
              <td style="padding: 0.85rem 0.75rem; font-weight: 600;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span>📄</span>
                  <span>${f.name}</span>
                </div>
              </td>
              <td style="padding: 0.85rem 0.75rem; color: var(--color-text-muted);">${f.project}</td>
              <td style="padding: 0.85rem 0.75rem; color: var(--color-text-dim);">${f.size}</td>
              <td style="padding: 0.85rem 0.75rem; color: var(--color-text-dim);">${f.date}</td>
              <td style="padding: 0.85rem 0.75rem; text-align: right;">
                <button type="button" class="btn btn-secondary download-btn" data-name="${f.name}" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">
                  Generate Signed Link (60s)
                </button>
              </td>
            </tr>
          `).join('');

          document.querySelectorAll('.download-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const fileName = btn.getAttribute('data-name');
              alert(`Verified tenant permission for ${session.email}. Generated ephemeral 60-second signed download URL for ${fileName}. Link expires in 60s.`);
            });
          });
        }
      }

      render();

      document.getElementById('file-search').addEventListener('input', (e) => {
        render(e.target.value.toLowerCase().trim());
      });
    }
  </script>
</PortalLayout>

