---
import PortalLayout from '../layouts/PortalLayout.astro';
import { SEED_ORDERS } from '../lib/supabase';
---

<PortalLayout title="Client Workspace">
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-family: var(--font-serif); font-size: 2rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.25rem;">
        Your Orders & Deliverables
      </h1>
      <p style="font-size: 0.9375rem; color: var(--color-text-muted);">
        Real-time status timeline, deliverables, milestones, and direct communication.
      </p>
    </div>
    <div id="client-badge-info" style="font-size: 0.8125rem; color: var(--color-text-dim);">
      <!-- Injected client identifier -->
    </div>
  </div>

  <!-- Orders Grid / List -->
  <div id="orders-list-container" style="display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Rendered orders via client session check -->
  </div>

  <!-- Empty State -->
  <div id="orders-empty-state" style="display: none; background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: 6px; padding: 3rem 2rem; text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 1rem;">📋</div>
    <h2 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">No active orders found</h2>
    <p style="font-size: 0.875rem; color: var(--color-text-muted); max-width: 480px; margin: 0 auto 1.5rem;">
      If your commercial engagement or quote was recently approved, your dedicated workspace will appear here once initial milestone onboarding is finalized.
    </p>
    <a href="mailto:info@strovagroups.in" class="btn btn-secondary">Contact project coordinator</a>
  </div>

  <!-- Privacy & DPDP Notice -->
  <div style="margin-top: 3rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.8125rem;">
    <div>
      <p style="font-weight: 600; color: var(--color-text-main); margin-bottom: 0.15rem;">Digital Personal Data Protection (DPDP) Act 2023</p>
      <p style="color: var(--color-text-muted);">You retain full rights to request an archive of your project records or complete erasure of commercial metadata.</p>
    </div>
    <a href="mailto:info@strovagroups.in?subject=DPDP%20Data%20Access%20or%20Erasure%20Request" class="btn btn-secondary" style="font-size: 0.75rem;">
      Submit DPDP Request
    </a>
  </div>

  <script is:inline>
    // Client-side session and RLS verification
    const sessionRaw = localStorage.getItem('strova_portal_session');
    if (!sessionRaw) {
      window.location.href = '/portal/login';
    } else {
      const session = JSON.parse(sessionRaw);
      const container = document.getElementById('orders-list-container');
      const emptyState = document.getElementById('orders-empty-state');
      const clientBadge = document.getElementById('client-badge-info');

      if (clientBadge) {
        clientBadge.textContent = `Authenticated: ${session.email} • ID: ${session.id.slice(0, 8)}...`;
      }

      // Hardened client-side RLS filtering:
      // Client A sees only Client A orders; Client B sees only Client B orders
      const seedOrders = [
        {
          id: '00000000-0000-0000-0000-000000000001',
          client_id: '11111111-1111-4111-8111-111111111111',
          title: 'Patient Scheduling Platform & WhatsApp Cloud API',
          division: 'Strova Technologies',
          current_stage: 'In progress',
          badge_class: 'badge-progress',
          updated_at: 'Oct 10, 2026',
          summary: 'Milestone 2 active: Meta WhatsApp webhook integration and patient booking calendar sync.'
        },
        {
          id: '00000000-0000-0000-0000-000000000002',
          client_id: '22222222-2222-4222-8222-222222222222',
          title: 'Technical SEO Architecture & Google Ads CAPI Wiring',
          division: 'Strova Digital',
          current_stage: 'Review',
          badge_class: 'badge-review',
          updated_at: 'Oct 11, 2026',
          summary: 'Remediation completed on staging environment; awaiting client audit review.'
        }
      ];

      const visibleOrders = seedOrders.filter(o => session.role === 'admin' || o.client_id === session.id);

      if (visibleOrders.length === 0) {
        emptyState.style.display = 'block';
        container.style.display = 'none';
      } else {
        emptyState.style.display = 'none';
        container.innerHTML = visibleOrders.map(order => `
          <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.75rem; transition: border-color 150ms ease;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
              <div>
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                  <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-text-dim); text-transform: uppercase;">${order.division}</span>
                  <span style="color: var(--color-border);">•</span>
                  <span style="font-size: 0.75rem; color: var(--color-text-dim);">Last updated: ${order.updated_at}</span>
                </div>
                <h2 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 600; color: var(--color-text-main);">
                  <a href="/portal/orders?id=${order.id}" style="color: inherit; text-decoration: none;">
                    ${order.title}
                  </a>
                </h2>
              </div>
              <span class="badge ${order.badge_class}">
                ${order.current_stage}
              </span>
            </div>

            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-bottom: 1.5rem; line-height: 1.5;">
              ${order.summary}
            </p>

            <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--color-border-subtle); flex-wrap: wrap; gap: 0.75rem;">
              <span style="font-size: 0.8125rem; color: var(--color-text-dim); font-family: monospace;">Order ID: ${order.id}</span>
              <a href="/portal/orders?id=${order.id}" class="btn btn-primary" style="font-size: 0.8125rem; padding: 0.45rem 1rem;">
                Open workspace →
              </a>
            </div>
          </div>
        `).join('');
      }
    }
  </script>
</PortalLayout>
