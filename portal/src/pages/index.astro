---
import PortalLayout from '../layouts/PortalLayout.astro';
---

<PortalLayout title="Workspace Overview" currentNav="overview">
  <!-- Client Welcome Header -->
  <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <span class="badge badge-progress" style="margin-bottom: 0.5rem;" id="client-role-badge">Client Workspace</span>
      <h2 style="font-family: var(--font-serif); font-size: 1.85rem; font-weight: 600; color: var(--color-text-main); margin-bottom: 0.25rem;" id="welcome-client-name">
        Welcome to your Client Hub
      </h2>
      <p style="font-size: 0.875rem; color: var(--color-text-muted);">
        Real-time visibility into project delivery sprints, milestone sign-offs, deliverables, and billing.
      </p>
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <a href="/orders/" class="btn btn-secondary">View all projects</a>
      <a href="/support/" class="btn btn-primary">Create support request</a>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.25rem;">
      <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-dim); margin-bottom: 0.35rem;">Active Projects</p>
      <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-main);" id="metric-active-projects">0</h3>
      <p style="font-size: 0.75rem; color: var(--color-success); margin-top: 0.25rem;">In progress sprints</p>
    </div>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.25rem;">
      <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-dim); margin-bottom: 0.35rem;">Awaiting Client Action</p>
      <h3 style="font-size: 1.75rem; font-weight: 700; color: #D97706;" id="metric-action-required">0</h3>
      <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.25rem;">Staging reviews or approvals</p>
    </div>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.25rem;">
      <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-dim); margin-bottom: 0.35rem;">Outstanding Balance</p>
      <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text-main);" id="metric-outstanding-balance">₹0.00</h3>
      <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.25rem;">Settled upon final handover</p>
    </div>

    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.25rem;">
      <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--color-text-dim); margin-bottom: 0.35rem;">Support Tickets</p>
      <h3 style="font-size: 1.75rem; font-weight: 700; color: var(--color-primary);" id="metric-support-tickets">0</h3>
      <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-top: 0.25rem;">Open direct inquiries</p>
    </div>
  </div>

  <!-- Main 2-Column Split: Active Engagements on left, Activity & Quick Links on right -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2rem;">
    <!-- Column 1: Active Engagements -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600;">Active Projects</h3>
        <a href="/orders/" style="font-size: 0.8125rem;">View all →</a>
      </div>

      <div id="overview-orders-container" style="display: flex; flex-direction: column; gap: 1rem;">
        <!-- Injected via client session query -->
      </div>
    </div>

    <!-- Column 2: Recent Activity & Outstanding Invoices -->
    <div style="display: flex; flex-direction: column; gap: 1.75rem;">
      <!-- Outstanding Invoices -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h4 style="font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600;">Billing & Settlement</h4>
          <a href="/invoices/" style="font-size: 0.75rem;">Invoices →</a>
        </div>
        <div id="overview-invoices-container" style="display: flex; flex-direction: column; gap: 0.75rem;">
          <!-- Injected invoices -->
        </div>
      </div>

      <!-- Latest Milestone Updates -->
      <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.5rem;">
        <h4 style="font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem;">Recent Updates from Strova Team</h4>
        <div id="overview-events-container" style="display: flex; flex-direction: column; gap: 1rem;">
          <!-- Injected timeline events -->
        </div>
      </div>
    </div>
  </div>

  <script>
    import {
      getSession,
      getUserProfile,
      fetchMyOrders,
      fetchMyInvoices,
      fetchSupportTickets,
      fetchOrderEvents,
      type ClientOrder,
      type ClientInvoice,
    } from '../lib/supabaseClient';
    import { getStageProgressPercent } from '../lib/supabase';
    import { escapeHtml } from '../lib/sanitize';

    async function initOverview() {
      const session = await getSession();
      if (!session) {
        window.location.href = '/login/';
        return;
      }

      const profile = await getUserProfile();
      const welcomeEl = document.getElementById('welcome-client-name');
      const roleBadge = document.getElementById('client-role-badge');

      if (welcomeEl) {
        welcomeEl.textContent = `Welcome, ${profile?.full_name || session.user.email?.split('@')[0] || 'Client'}`;
      }

      if (profile?.role === 'admin' && roleBadge) {
        roleBadge.textContent = 'Administrator Console';
        roleBadge.className = 'badge badge-danger';
      }

      // Query real database records (constrained by Row Level Security)
      const orders = await fetchMyOrders();
      const invoices = await fetchMyInvoices();
      const supportTickets = await fetchSupportTickets();

      // Populate Metric Cards
      const metricOrders = document.getElementById('metric-active-projects');
      if (metricOrders) metricOrders.textContent = String(orders.length);

      const actionCount = orders.filter((o) => Boolean(o.action_required_note)).length;
      const metricActions = document.getElementById('metric-action-required');
      if (metricActions) metricActions.textContent = String(actionCount);

      const pendingInvoices = invoices.filter((i) => i.status === 'Pending');
      const totalBalancePaise = pendingInvoices.reduce((acc, i) => acc + (i.amount_paise || 0), 0);
      const metricBalance = document.getElementById('metric-outstanding-balance');
      if (metricBalance) {
        metricBalance.textContent = `₹${(totalBalancePaise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
      }

      const openTicketsCount = supportTickets.filter((t) => t.status === 'open' || t.status === 'in_progress').length;
      const metricTickets = document.getElementById('metric-support-tickets');
      if (metricTickets) metricTickets.textContent = String(openTicketsCount);

      // Render Active Orders
      const ordersContainer = document.getElementById('overview-orders-container');
      if (ordersContainer) {
        if (orders.length === 0) {
          ordersContainer.innerHTML = `
            <div style="background: var(--color-surface); border: 1px dashed var(--color-border); border-radius: 6px; padding: 2.5rem 1.5rem; text-align: center; color: var(--color-text-dim);">
              <p style="font-weight: 600; margin-bottom: 0.25rem;">No active projects</p>
              <p style="font-size: 0.8125rem;">When an engagement scope is finalized, your project tracking timeline appears here automatically.</p>
            </div>
          `;
        } else {
          ordersContainer.innerHTML = orders.map((o) => {
            const progress = getStageProgressPercent(o.current_stage as any);
            const isReview = o.current_stage === 'Review' || o.current_stage === 'Revisions';
            const updatedDate = o.updated_at ? new Date(o.updated_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recently';

            return `
              <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 6px; padding: 1.5rem; transition: border-color 150ms ease;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.5rem;">
                  <div>
                    <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--color-primary);">${escapeHtml(o.division)} • ${escapeHtml(o.order_ref)}</span>
                    <h4 style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 600; margin-top: 2px;">
                      <a href="/orders/?id=${escapeHtml(o.id)}" style="color: inherit; text-decoration: none;">${escapeHtml(o.title)}</a>
                    </h4>
                  </div>
                  <span class="badge ${isReview ? 'badge-review' : 'badge-progress'}">${escapeHtml(o.current_stage)}</span>
                </div>

                <div style="margin: 1rem 0;">
                  <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--color-text-dim); margin-bottom: 0.25rem;">
                    <span>Delivery Progress</span>
                    <span style="font-weight: 600;">${progress}%</span>
                  </div>
                  <div style="width: 100%; height: 6px; background: #F1F5F9; border-radius: 9999px; overflow: hidden;">
                    <div style="width: ${progress}%; height: 100%; background: var(--color-primary); border-radius: 9999px;"></div>
                  </div>
                </div>

                ${o.action_required_note ? `
                  <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 4px; padding: 0.65rem 0.85rem; font-size: 0.8125rem; color: #92400E; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    <span>⚠️</span>
                    <span><strong>Action needed:</strong> ${escapeHtml(o.action_required_note)}</span>
                  </div>
                ` : ''}

                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border-subtle); padding-top: 0.75rem; font-size: 0.75rem; color: var(--color-text-dim);">
                  <span>Updated: ${escapeHtml(updatedDate)}</span>
                  <a href="/orders/?id=${escapeHtml(o.id)}" class="btn btn-secondary" style="font-size: 0.75rem; padding: 0.35rem 0.75rem;">Open workspace →</a>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      // Render Invoices
      const invoicesContainer = document.getElementById('overview-invoices-container');
      if (invoicesContainer) {
        if (invoices.length === 0) {
          invoicesContainer.innerHTML = `<p style="font-size: 0.8125rem; color: var(--color-text-dim);">No invoices generated yet.</p>`;
        } else {
          invoicesContainer.innerHTML = invoices.slice(0, 5).map((inv) => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 4px; background: #FAFAFA;">
              <div>
                <p style="font-size: 0.875rem; font-weight: 600; font-family: monospace;">${escapeHtml(inv.invoice_number)}</p>
                <p style="font-size: 0.75rem; color: var(--color-text-dim);">Due: ${escapeHtml(inv.due_date || 'On delivery')}</p>
              </div>
              <div style="text-align: right; display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-size: 0.875rem; font-weight: 600;">₹${(inv.amount_paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2 })}</span>
                <span class="badge ${inv.status === 'Paid' ? 'badge-success' : 'badge-pending'}">${escapeHtml(inv.status)}</span>
              </div>
            </div>
          `).join('');
        }
      }

      // Render Recent Events across orders
      const eventsContainer = document.getElementById('overview-events-container');
      if (eventsContainer) {
        if (orders.length === 0) {
          eventsContainer.innerHTML = `<p style="font-size: 0.8125rem; color: var(--color-text-dim);">No recent activity recorded.</p>`;
        } else {
          // Fetch events for first 2 orders
          const eventsList: any[] = [];
          for (const order of orders.slice(0, 3)) {
            const evs = await fetchOrderEvents(order.id);
            eventsList.push(...evs);
          }
          eventsList.sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());

          if (eventsList.length === 0) {
            eventsContainer.innerHTML = `<p style="font-size: 0.8125rem; color: var(--color-text-dim);">No milestone updates posted yet.</p>`;
          } else {
            eventsContainer.innerHTML = eventsList.slice(0, 4).map((ev) => {
              const d = new Date(ev.created_at).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' });
              return `
                <div style="border-left: 2px solid var(--color-primary); padding-left: 0.75rem;">
                  <p style="font-size: 0.75rem; color: var(--color-text-dim); margin-bottom: 2px;">${escapeHtml(d)} • <strong style="color: var(--color-primary);">${escapeHtml(ev.stage)}</strong></p>
                  <p style="font-size: 0.8125rem; color: var(--color-text-main); line-height: 1.4;">${escapeHtml(ev.note)}</p>
                </div>
              `;
            }).join('');
          }
        }
      }
    }

    initOverview();
  </script>

</PortalLayout>
